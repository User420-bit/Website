---
/**
 * Das Kapitel Kontakt als dunkle Fläche auf dem Foto des Rosenheimer Landes
 * (vom Breitenstein). Das Foto liegt stark abgedunkelt und entsättigt hinter
 * dem ganzen Kapitel, als Grund, nicht als Bild: oben fast schwarz, wo die
 * Überschrift steht, unten lässt es das Land durchscheinen.
 *
 * In der Fläche gelten die Tokens des Dunkelmodus, in beiden Modi, damit
 * Adresse, Knopf, Meta-Liste und Ablauf unverändert funktionieren. Links der
 * Kopf und die Handlung (Slot `default`), rechts der Ablauf (Slot `ablauf`),
 * dieselben Spalten wie bisher (3fr | 2fr, 3rem).
 *
 * Beim Scrollen gleitet das Foto langsamer als die Seite; die Schrift bewegt
 * sich nie.
 */
import { Image } from 'astro:assets'
import rosenheimerLand from '@/assets/kontakt/rosenheimer-land.jpg'

interface Props {
  index: string
  title: string
  intro?: string
}

const { index, title, intro } = Astro.props
---

<div class="horizont">
  <div class="horizont-foto" aria-hidden="true">
    <Image
      class="horizont-bild"
      src={rosenheimerLand}
      alt=""
      widths={[640, 960, 1280, 1920, 2576]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="horizont-schleier"></div>
  </div>

  <div
    class="horizont-inhalt relative mx-auto grid max-w-5xl grid-cols-1 gap-12 px-4 pt-20 pb-10 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] sm:pt-28 sm:pb-12"
  >
    <div>
      <p class="m-0 flex items-center gap-3 text-sm text-fg-muted tabular-nums">
        <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span aria-hidden="true">{index}</span>
        <span aria-hidden="true">–</span>
        <span>Kontakt</span>
      </p>
      <h2
        class="display mt-5 mb-0 max-w-[16ch] text-[clamp(2.25rem,1.4rem+3.4vw,3.75rem)] font-semibold text-balance"
      >
        {title}
      </h2>
      {intro && <p class="prose-flow mt-6 mb-0 max-w-[48ch] text-lg text-fg-muted">{intro}</p>}
      <div class="mt-12">
        <slot />
      </div>
    </div>

    <div class="sm:pt-11">
      <slot name="ablauf" />
    </div>

    <p class="m-0 text-xs text-fg-muted sm:col-span-2">
      Im Hintergrund: das Rosenheimer Land, vom Breitenstein aus gesehen. Eigenes Foto.
    </p>
  </div>
</div>

<style>
  /*
   * Volle Fensterbreite aus der Spalte heraus wie die Bühne (ProjectScene);
   * den Überstand um die Scrollleiste schneidet `overflow-x: clip` auf <body>.
   * `clip` statt `hidden`, sonst wäre die Fläche ein Scroll-Container und die
   * Zeitleiste liefe ins Leere.
   */
  .horizont {
    position: relative;
    margin-inline: calc(50% - 50vw);
    overflow: clip;
    view-timeline: --horizont;
    background-color: oklch(0.14 0.004 80);

    /* Tokens des Dunkelmodus, in beiden Modi: Die Fläche ist immer dunkel. */
    --color-bg: oklch(0.17 0.004 80);
    --color-bg-elevated: oklch(0.22 0.005 80);
    --color-fg: oklch(0.96 0.003 80);
    --color-fg-muted: oklch(0.8 0.008 80);
    --color-accent: oklch(0.78 0.15 60);
    --color-accent-fg: oklch(0.17 0.02 60);
    --color-border: oklch(0.96 0.003 80 / 0.18);
    color: var(--color-fg);
  }

  .horizont-foto {
    position: absolute;
    inset: 0;
  }

  /* 12 % höher als die Fläche und unten bündig; beim Scrollen bleibt es zurück, bis es oben bündig steht. */
  .horizont-bild {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    height: 112%;
    max-width: none;
    object-fit: cover;
    object-position: 60% 75%;
    filter: saturate(0.55) brightness(0.85);
  }

  /*
   * Oben fast deckend, wo Überschrift und Adresse stehen; nach unten lässt
   * der Schleier das Land durchscheinen. Gemessen hält jede Schrift in der
   * Fläche mindestens 4,5 : 1 (DESIGN.md, Horizont).
   */
  .horizont-schleier {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      oklch(0.14 0.004 80 / 0.9),
      oklch(0.14 0.004 80 / 0.78) 55%,
      oklch(0.14 0.004 80 / 0.55) 100%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .horizont-bild {
        /* Langschreibweise, sonst zieht der Minifier `animation-timeline` in die Kurzform. */
        animation-name: horizont-gleiten;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --horizont;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes horizont-gleiten {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(10.714%);
    }
  }
</style>
