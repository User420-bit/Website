---
/**
 * Hero der Startseite: das Unternehmen, nicht die Person. So hoch wie sein
 * Inhalt. „Für wen“ steht direkt unter dem Claim, damit die H1 das Erste
 * bleibt, was man liest.
 *
 * Bewegung, Teil 1 (docs/HERO_KLARTEXT_PLAN.md): Beim ersten Öffnen in einer
 * Sitzung liegt über dem Hero ein Brocken Kundengerede. Die vier Wörter des
 * Claims werden darin markiert, lösen sich und werden zur H1; der Rest
 * verschwindet. Das ist die eine bewusste Ausnahme von „Die H1 steht vom
 * ersten Bild an“: Sie steht nach spätestens 1,5 s. Ohne Skript, mit
 * reduzierter Bewegung und ab dem zweiten Aufruf der Sitzung gibt es kein
 * Gerede, und die H1 steht sofort.
 *
 * Bewegung, Teil 2 (docs/BEWEGUNG_PLAN.md, B): Unter der H1 ziehen „Für wen“,
 * Intro, Knöpfe und Adresszeile nacheinander 8 px ein, dazu genau eine
 * Signatur: der Strich unter der Adresse. Die Begründung steht im Skript.
 */
import { getEntry } from 'astro:content'
import Button from '@/components/Button.astro'
import { href, mailto } from '@/lib/site'

const company = (await getEntry('company', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const anfrage = mailto(company.email, contact.subject)

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

/*
 * Claim in Wörter und Zeichen zerlegen. Jedes Wort bekommt eine Span mit
 * Nummer (Ziel des Flugs), jedes Satzzeichen eine Span ohne Nummer (blendet
 * am Ende ein). Als HTML-String, damit kein Zeilenumbruch aus dem Template
 * in die H1 gerät: `verify-build` vergleicht den Text der H1 wortgenau.
 */
const tokens = [...company.claim.matchAll(/(\p{L}+)|(\s+)|([^\p{L}\s]+)/gu)]
const woerter = tokens.filter((t) => t[1]).map((t) => t[1]!)
let wortIndex = 0
const claimHtml = tokens
  .map(([text, wort, leer]) =>
    wort
      ? `<span data-hero-wort="${wortIndex++}">${escape(text)}</span>`
      : leer
        ? ' '
        : `<span data-hero-zeichen>${escape(text)}</span>`,
  )
  .join('')

/*
 * Im Gerede jedes Claim-Wort in Lesereihenfolge finden und markieren. Fehlt
 * eines, bricht der Build: Dann passt `heroGerede` nicht mehr zum Claim.
 */
let rest = company.heroGerede
let geredeHtml = ''
woerter.forEach((wort, i) => {
  const treffer = new RegExp(`(?<!\\p{L})${wort}(?!\\p{L})`, 'u').exec(rest)
  if (!treffer) {
    throw new Error(`heroGerede enthält „${wort}“ nicht (nach „${rest.slice(0, 30)}…“)`)
  }
  geredeHtml +=
    escape(rest.slice(0, treffer.index)) +
    `<mark data-hero-quelle="${i}"><span data-hero-marker aria-hidden="true"></span>${escape(wort)}</mark>`
  rest = rest.slice(treffer.index + wort.length)
})
geredeHtml += escape(rest)
---

<section class="relative pt-16 pb-16 sm:pt-24 sm:pb-24">
  {
    /*
     * Entscheidet vor dem ersten Bild, ob das Gerede gespielt wird: nur mit
     * erlaubter Bewegung (`MotionReady` hat `data-bewegung` gesetzt) und nur
     * beim ersten Aufruf der Sitzung. Inline und parser-blockierend, damit
     * nichts aufblitzt. `sessionStorage` kann in strengen Browsern werfen.
     */
  }
  <script is:inline>
    try {
      if (
        document.documentElement.dataset.bewegung !== undefined &&
        !sessionStorage.getItem('klartext-hero')
      ) {
        document.documentElement.dataset.hero = 'gerede'
      }
    } catch {}
  </script>

  <h1
    data-bewegt
    data-hero-h1
    class="display m-0 max-w-[20ch] text-[clamp(2.5rem,1.6rem+4.5vw,4.5rem)] font-semibold text-balance"
    set:html={claimHtml}
  />
  <p
    data-bewegt
    data-hero-einzug
    class="mt-5 mb-0 max-w-[60ch] text-xl leading-snug font-medium tracking-tight text-balance text-fg-muted sm:text-2xl"
  >
    {company.audience}
  </p>
  <p
    data-bewegt
    data-hero-einzug
    class="prose-flow mt-6 max-w-[60ch] text-lg leading-relaxed text-fg-muted"
  >
    {company.intro}
  </p>

  <div data-bewegt data-hero-einzug class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
    <Button href={anfrage}>E-Mail schreiben</Button>
    <Button href={href('/#arbeiten')} variant="text">Arbeiten ansehen</Button>
  </div>

  {/* Sichtbare Adresse: Ausweg, wenn der Klick kein Mailprogramm öffnet (Webmail). */}
  <p
    data-bewegt
    data-hero-einzug
    class="mt-10 mb-0 flex flex-wrap gap-x-2 gap-y-1 text-sm text-fg-muted"
  >
    <span>{company.location}</span>
    <span aria-hidden="true">·</span>
    <span class="relative font-medium wrap-anywhere text-fg select-all"
      >{company.email}<span
        aria-hidden="true"
        data-bewegt
        data-hero-strich
        class="pointer-events-none absolute inset-x-0 -bottom-0.5 h-px origin-left bg-border"
      ></span></span
    >
  </p>

  {
    /*
     * Das Gerede liegt als Schicht über dem Hero, oben ausgerichtet an der H1,
     * und ist auf jeder Breite kürzer als der Hero: Die Höhe der Sektion
     * kommt vom Inhalt, nicht vom Gerede. Für Screenreader gibt es nur die H1.
     */
  }
  <p
    aria-hidden="true"
    data-hero-gerede
    class="pointer-events-none absolute inset-x-0 top-16 m-0 max-w-[60ch] text-sm leading-relaxed text-fg-muted sm:top-24 sm:text-base"
    set:html={geredeHtml}
  />
  <div aria-hidden="true" data-hero-flug class="pointer-events-none absolute inset-0"></div>
</section>

<style is:global>
  /*
   * Anfangszustand nur mit Skript und erlaubter Bewegung (`MotionReady`);
   * ohne das Attribut steht alles sofort, der Strich eingeschlossen. Nur
   * transform und opacity, der Strich liegt absolut: Die Höhe des Hero ist
   * vom ersten Bild an dieselbe. `is:global`, weil ein gekapselter Stil jedem
   * Element des Hero ein `data-astro-cid-…` anhängte. Die Datenattribute
   * grenzen die Regeln auf den Hero ein.
   */
  html[data-bewegung] [data-hero-einzug] {
    opacity: 0;
    transform: translateY(8px);
  }
  html[data-bewegung] [data-hero-strich] {
    transform: scaleX(0);
  }

  /*
   * Gerede: nur sichtbar, wenn das Inline-Skript oben `data-hero="gerede"`
   * vergeben hat. Dann ist die H1 unsichtbar (nicht `visibility`: Ihre
   * Wörter werden gemessen). Sicherheitsnetz wie in global.css: Läuft das
   * Modul nach 2 s nicht, verschwindet das Gerede, und `[data-bewegt]` auf
   * der H1 holt sie zurück.
   */
  [data-hero-gerede],
  [data-hero-flug] {
    display: none;
  }
  html[data-hero='gerede'] [data-hero-gerede],
  html[data-hero='gerede'] [data-hero-flug] {
    display: block;
  }
  html[data-hero='gerede'] [data-hero-h1] {
    opacity: 0;
  }
  html[data-bewegung=''][data-hero='gerede'] [data-hero-gerede] {
    animation: hero-gerede-weg 0s 2s both;
  }
  @keyframes hero-gerede-weg {
    to {
      visibility: hidden;
    }
  }

  /* Die vier Wörter im Gerede: fett von Anfang an, damit die Kopie beim Herauslösen denselben Umriss hat. */
  [data-hero-quelle] {
    position: relative;
    display: inline-block;
    color: inherit;
    background: none;
    font-weight: 600;
    isolation: isolate;
  }
  [data-hero-marker] {
    position: absolute;
    inset: -0.05em -0.15em;
    z-index: -1;
    border-radius: 2px;
    background: var(--color-accent-soft);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* Die fliegende Kopie: Display-Schrift wie die H1, Bezugspunkt oben links. */
  [data-hero-kopie] {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
    transform-origin: top left;
    will-change: transform;
  }
  [data-hero-kopie] [data-hero-marker] {
    inset: 0.04em -0.06em;
    transform: none;
  }
</style>

<script>
  import { DAUER, KURVE, STAFFEL, WEG_TEXT, alle, animate, stagger, wennBewegt } from '@/lib/motion'

  const html = document.documentElement

  /*
   * Teil 1: Aus Gerede wird Klartext. Nur, wenn das Inline-Skript oben
   * entschieden hat, dass gespielt wird. Zeiten siehe HERO_KLARTEXT_PLAN.md:
   * 250 ms markieren, 700 ms herauslösen, 1 200 ms ankommen, 1 400 ms
   * umschalten, dann Teil 2. Positionen werden gemessen, nicht geraten:
   * Jede Kopie steht am Ziel (ihrem Wort in der H1) und startet per
   * transform an der Quelle; Schriftgröße über `scale`, nie `font-size`.
   */
  async function gerede(): Promise<void> {
    const h1 = document.querySelector<HTMLElement>('[data-hero-h1]')
    const text = document.querySelector<HTMLElement>('[data-hero-gerede]')
    const flug = document.querySelector<HTMLElement>('[data-hero-flug]')
    const quellen = alle('[data-hero-quelle]')
    const ziele = alle('[data-hero-wort]', h1 ?? undefined)
    const zeichen = alle('[data-hero-zeichen]', h1 ?? undefined)
    if (!h1 || !text || !flug || quellen.length !== ziele.length) return fertig()

    try {
      sessionStorage.setItem('klartext-hero', '1')
    } catch {
      /* ohne Speicher spielt es eben jedes Mal */
    }

    // Erst messen, wenn die Schrift steht, sonst stimmen die Breiten nicht.
    await document.fonts.ready

    // Markieren: Fläche von links, Schrift wird Tinte.
    const marker = quellen.map((q) => q.querySelector<HTMLElement>('[data-hero-marker]')!)
    animate(
      marker,
      { scaleX: [0, 1] },
      { duration: DAUER.basis, ease: KURVE, delay: stagger(0.09, { startDelay: 0.25 }) },
    )
    animate(
      quellen,
      { color: 'var(--color-fg)' },
      { duration: DAUER.basis, ease: KURVE, delay: stagger(0.09, { startDelay: 0.25 }) },
    )
    // Herauslösen frühestens bei 700 ms, und nie, bevor der letzte Marker steht.
    const nachMarkieren = 0.25 + 0.09 * (quellen.length - 1) + DAUER.basis
    await new Promise((r) => setTimeout(r, Math.max(0.7, nachMarkieren) * 1000))

    // Herauslösen: Kopien am Ziel bauen, an die Quelle setzen, fliegen lassen.
    const textKasten = (el: HTMLElement) => {
      const range = document.createRange()
      range.selectNodeContents(el.lastChild!)
      return range.getBoundingClientRect()
    }
    const kopien = ziele.map((ziel, i) => {
      const kopie = document.createElement('span')
      kopie.dataset.heroKopie = ''
      kopie.className = h1.className.replace(/\b(m-0|max-w-\[[^\]]+\]|text-balance)\b/g, '')
      kopie.innerHTML = `<span data-hero-marker></span>${ziel.textContent}`
      Object.assign(kopie.style, { position: 'absolute', isolation: 'isolate' })
      flug.append(kopie)
      // Am Ziel ausrichten: Glyphenkasten der Kopie auf den der H1-Span. Die
      // Kopie selbst ist ein Block (Zeilenkasten), gemessen wird ihr Text.
      const z = ziel.getBoundingClientRect()
      const k = textKasten(kopie)
      kopie.style.left = `${z.left - k.left}px`
      kopie.style.top = `${z.top - k.top}px`
      const q = quellen[i]!.getBoundingClientRect()
      const s = q.height / z.height
      return { kopie, dx: q.left - z.left, dy: q.top - z.top, s }
    })

    // Marker der Kopie: anfangs gefüllt, sichtbar wie an der Quelle.
    animate(
      kopien.map((k) => k.kopie),
      { opacity: [0, 1] },
      { duration: 0.001 },
    )
    const fluege = kopien.map(({ kopie, dx, dy, s }, i) =>
      animate(
        kopie,
        { transform: [`translate(${dx}px, ${dy}px) scale(${s})`, 'translate(0px, 0px) scale(1)'] },
        { duration: DAUER.szene, ease: KURVE, delay: i * STAFFEL },
      ),
    )
    animate(text, { opacity: [1, 0], y: [0, -WEG_TEXT] }, { duration: DAUER.langsam, ease: KURVE })
    await Promise.all(fluege)

    // Ankommen: Marker läuft nach rechts aus, Satzzeichen blenden ein.
    for (const z of zeichen) z.style.opacity = '0'
    h1.style.opacity = '1'
    for (const k of kopien)
      k.kopie.querySelector<HTMLElement>('[data-hero-marker]')!.style.transformOrigin = 'right'
    await Promise.all([
      animate(
        kopien.map((k) => k.kopie.querySelector<HTMLElement>('[data-hero-marker]')!),
        { scaleX: [1, 0] },
        { duration: DAUER.basis, ease: KURVE },
      ),
      animate(zeichen, { opacity: [0, 1] }, { duration: DAUER.basis, ease: KURVE }),
    ])

    // Umschalten: Die echte H1 steht, nichts bleibt zurück.
    for (const k of kopien) k.kopie.remove()
    fertig()
  }

  /* Endzustand von Teil 1, unabhängig davon, ob gespielt wurde. */
  function fertig(): void {
    delete html.dataset.hero
    const h1 = document.querySelector<HTMLElement>('[data-hero-h1]')
    if (h1) h1.style.opacity = ''
    for (const z of alle('[data-hero-zeichen]')) z.style.opacity = ''
  }

  /*
   * Teil 2: Einzug der Zeilen unter der H1, kein `inView`: Der Hero steht
   * immer im ersten Fenster. Signatur, genau eine: der Strich unter der
   * Adresse. Eine Tintenlinie unter der ganzen Adresszeile stünde knapp über
   * der Kapitel-Linie von 01 und doppelte sie; die Tinte bleibt den Kapiteln.
   * Der Strich zeigt auf das, was man aus dem Hero mitnehmen soll, und reimt
   * sich auf den Kontakt (05). Er startet erst, wenn die Adresszeile
   * angekommen ist: erst Text, dann Linie. Das Zurücktreten beim Scrollen
   * bleibt bewusst weg: eine zweite Bewegung neben dem Strich wäre keine
   * Signatur mehr.
   */
  function einzug(): void {
    const zeilen = alle('[data-hero-einzug]')
    const strich = document.querySelector<HTMLElement>('[data-hero-strich]')
    if (zeilen.length === 0) return

    animate(
      zeilen,
      { opacity: [0, 1], y: [WEG_TEXT, 0] },
      { duration: DAUER.langsam, ease: KURVE, delay: stagger(STAFFEL) },
    ).then(() => {
      for (const zeile of zeilen) zeile.style.transform = 'none'
    })

    if (strich) {
      const ankunft = (zeilen.length - 1) * STAFFEL + DAUER.langsam
      animate(
        strich,
        { scaleX: [0, 1] },
        { duration: DAUER.szene, ease: KURVE, delay: ankunft },
      ).then(() => {
        strich.style.transform = 'none'
      })
    }
  }

  wennBewegt(async () => {
    if (html.dataset.hero === 'gerede') await gerede()
    einzug()
  }, fertig)
</script>
