---
/**
 * 02 Leistungen: die drei Arten Software, und in jeder Spalte ein Aufklapper
 * „Im Einzelnen“ mit den belegten Punkten dieser Art. Eine Gliederung, nicht
 * zwei (entschieden am 2026-10-07, vorher vier eigene Gruppen unter den
 * Spalten). Die Gruppen in leistungen.json heißen wie die Spalten in
 * company.json; darüber werden sie zugeordnet. Jeder Einzelpunkt nennt das
 * Projekt, das ihn belegt: ohne Beleg kein Eintrag, sonst wäre es eine
 * Wunschliste. Unter jeder Beschreibung steht die Belegzeile der Spalte, alle
 * Projekte aus ihren Einzelpunkten; unveröffentlichte ohne Link.
 *
 * Die Wahlhilfe (docs/RUHE_PLAN.md, seit 2026-10-14): Über den Spalten fragt
 * die Seite „Was davon kennen Sie?“ und bietet drei Sätze aus dem Gerede des
 * Heros an, wörtlich (`heroEchos`, geprüft in `lib/echo.ts`). Wer einen
 * wählt, sieht die Spalte, die ihn beantwortet: Die anderen treten zurück,
 * die antwortende Stelle bekommt den Marker, und „Im Einzelnen“ öffnet sich
 * mit den Belegen. Noch einmal tippen hebt die Wahl auf. Die Wahlhilfe gibt
 * es nur mit Skript; ohne steht der Abschnitt wie immer. Text zieht hier
 * nicht mehr ein: Bewegung gibt es nur als Antwort auf die Wahl.
 */
import { getCollection, getEntry } from 'astro:content'
import Disclosure from '@/components/Disclosure.astro'
import Section from '@/components/Section.astro'
import { echo } from '@/lib/echo'
import { href } from '@/lib/site'

const company = (await getEntry('company', 'main'))!.data
const projekte = await getCollection('projekte')
const projektTitel = new Map(projekte.map((p) => [p.id, p.data.title]))
/** Unveröffentlichte Projekte haben keine Seite; ein Beleg nennt sie ohne Link. */
const ohneSeite = new Set(projekte.filter((p) => !p.data.published).map((p) => p.id))
const leistungen = await getCollection('leistungen')
/** Die Einzelpunkte einer Spalte, über den gleichen Titel gefunden. */
const punkteZu = (titel: string) =>
  leistungen.find((group) => group.data.title === titel)?.data.items ?? []
/** Alle Projekte, die eine Spalte belegen, in der Reihenfolge ihres ersten Auftretens. */
const belegeZu = (titel: string) => [...new Set(punkteZu(titel).flatMap((item) => item.evidence))]
const punkte = (n: number) => (n === 1 ? '1 Punkt' : `${n} Punkte`)

/** Je Spalte: Einzelpunkte, Belege und, falls vorhanden, der Satz aus dem Gerede samt Antwort. */
const spalten = company.services.map((service) => ({
  service,
  items: punkteZu(service.title),
  belege: belegeZu(service.title),
  wahl: echo(company.heroEchos, company.heroGerede, service.title, service.description),
}))
---

<Section
  id="leistungen"
  index="02"
  title="Hinter jeder Leistung steht ein echtes Projekt"
  intro="Ob Programm, Website oder Web-App: klein genug, um verstanden zu werden, und solide genug, um zu bleiben."
>
  {
    spalten.some((s) => s.wahl) && (
      <div class="mb-10 sm:mb-12" data-wahl hidden>
        <p class="m-0 text-sm font-medium text-fg" id="wahl-frage">
          Was davon kennen Sie?
        </p>
        <div
          class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3 sm:gap-x-8"
          role="group"
          aria-labelledby="wahl-frage"
        >
          {spalten.map(({ service, wahl }, i) =>
            wahl ? (
              <button
                type="button"
                class="wahl-knopf"
                aria-pressed="false"
                aria-controls={`leistung-${i}`}
                data-wahl-knopf={i}
              >
                {wahl.worte.join(' ')}
                <span class="sr-only"> Antwort: {service.title}</span>
              </button>
            ) : (
              <span aria-hidden="true" />
            ),
          )}
        </div>
        <p class="mt-3 mb-0 text-sm text-fg-muted">
          Nichts davon?{' '}
          <a class="text-accent underline underline-offset-4" href={href('/#kontakt')}>
            Erzählen Sie es
          </a>
          .
        </p>
      </div>
    )
  }

  <dl class="m-0 grid grid-cols-1 gap-x-8 sm:grid-cols-3" data-leistungen>
    {
      spalten.map(({ service, items, belege, wahl }, i) => (
        <div
          class="leistung flex flex-col border-t border-border pt-4 pb-8"
          id={`leistung-${i}`}
          data-leistung={i}
        >
          <dt class="text-lg font-semibold tracking-tight">{service.title}</dt>
          {/* `grow`: Belege und Aufklapper stehen über alle Spalten auf einer Höhe. */}
          <dd class="prose-flow mt-2 ml-0 grow text-sm leading-relaxed text-fg-muted">
            {wahl ? <span set:html={wahl.html} /> : service.description}
          </dd>
          {belege.length > 0 && (
            <dd class="mt-3 mb-0 ml-0 text-xs leading-relaxed text-fg-muted">
              Belege:{' '}
              {belege.map((slug, j) => (
                <>
                  {j > 0 && ', '}
                  {ohneSeite.has(slug) ? (
                    projektTitel.get(slug)
                  ) : (
                    <a
                      class="text-accent underline underline-offset-4"
                      href={href(`/projekte/${slug}`)}
                    >
                      {projektTitel.get(slug) ?? slug}
                    </a>
                  )}
                </>
              ))}
            </dd>
          )}
          {items.length > 0 && (
            <dd class="mt-4 ml-0 border-t border-border text-sm">
              <Disclosure title="Im Einzelnen" meta={punkte(items.length)}>
                <ul class="mt-0 grid list-none grid-cols-1 gap-y-5 p-0">
                  {items.map((item) => (
                    <li>
                      <span class="block text-sm font-medium">{item.title}</span>
                      <span class="prose-flow block text-sm text-fg-muted">{item.description}</span>
                      {item.evidence.length > 0 && (
                        <span class="mt-1 block text-xs text-fg-muted">
                          Beleg:{' '}
                          {item.evidence.map((slug, j) => (
                            <>
                              {j > 0 && ', '}
                              {ohneSeite.has(slug) ? (
                                projektTitel.get(slug)
                              ) : (
                                <a
                                  class="text-accent underline-offset-4"
                                  href={href(`/projekte/${slug}`)}
                                >
                                  {projektTitel.get(slug) ?? slug}
                                </a>
                              )}
                            </>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </Disclosure>
            </dd>
          )}
        </div>
      ))
    }
  </dl>
</Section>

<style>
  /*
   * Die Sätze sind Knöpfe im Stil des Sekundärknopfs (DESIGN.md), links
   * bündig, weil sie Text sind. Gewählt: verdünntes Orange, Rand Orange.
   */
  .wahl-knopf {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-fg);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
    transition:
      color var(--duration-base) var(--ease-quiet),
      background-color var(--duration-base) var(--ease-quiet),
      border-color var(--duration-base) var(--ease-quiet);
  }
  .wahl-knopf:hover,
  .wahl-knopf[aria-pressed='true'] {
    border-color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  /*
   * Die Antwort trägt den Marker nur, wenn ihr Satz gewählt ist; sonst ist sie
   * Text wie jeder andere. Gewählt treten die anderen Spalten zurück: ihr
   * Titel wird Bleistiftgrau statt Tinte. Keine Deckkraft (bis 2026-10-17
   * 35 %): Die drückte den Text unter 4,5 : 1, obwohl er lesbar bleiben soll.
   */
  .leistung :global(mark.marker[data-antwort]) {
    color: inherit;
    background-size: 0% 100%;
    transition:
      background-size var(--duration-slow) var(--ease-quiet),
      color var(--duration-base) var(--ease-quiet);
  }
  .leistung[data-gewaehlt] :global(mark.marker[data-antwort]) {
    color: var(--color-fg);
    background-size: 100% 100%;
    transition-duration: 600ms, var(--duration-base);
  }
  .leistung dt {
    transition: color var(--duration-base) var(--ease-quiet);
  }
  [data-leistungen][data-wahl-an] .leistung:not([data-gewaehlt]) dt {
    color: var(--color-fg-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .wahl-knopf,
    .leistung dt,
    .leistung :global(mark.marker[data-antwort]) {
      transition: none;
    }
  }
</style>

<script>
  import { alle, bewegt } from '@/lib/motion'

  const wahl = document.querySelector<HTMLElement>('[data-wahl]')
  const liste = document.querySelector<HTMLElement>('[data-leistungen]')

  if (wahl && liste) {
    const knoepfe = alle<HTMLButtonElement>('[data-wahl-knopf]', wahl)
    const spalten = alle('[data-leistung]', liste)
    wahl.hidden = false

    /** `nr` wählt eine Spalte, `null` hebt die Wahl auf. */
    const waehlen = (nr: string | null) => {
      for (const knopf of knoepfe) {
        knopf.setAttribute('aria-pressed', String(knopf.dataset.wahlKnopf === nr))
      }
      liste.toggleAttribute('data-wahl-an', nr !== null)
      for (const spalte of spalten)
        spalte.toggleAttribute('data-gewaehlt', spalte.dataset.leistung === nr)
      const spalte = spalten.find((s) => s.dataset.leistung === nr)
      if (!spalte) return

      // Die Belege im Einzelnen gleich mit zeigen; der Aufklapper öffnet sich wie bei einem Klick.
      const aufklapper = spalte.querySelector<HTMLDetailsElement>('details')
      if (aufklapper && !aufklapper.open) aufklapper.querySelector('summary')?.click()

      // Am Handy steht die Spalte womöglich unter dem Fenster: hinführen, nicht springen.
      const oben = spalte.getBoundingClientRect().top
      if (oben > window.innerHeight * 0.7 || oben < 0) {
        spalte.scrollIntoView({ block: 'start', behavior: bewegt() ? 'smooth' : 'auto' })
      }
    }

    for (const knopf of knoepfe) {
      knopf.addEventListener('click', () => {
        const nr = knopf.dataset.wahlKnopf ?? null
        waehlen(knopf.getAttribute('aria-pressed') === 'true' ? null : nr)
      })
    }
  }
</script>
