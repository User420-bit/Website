---
/**
 * 02 Leistungen: erst die drei Arten Software, dann die Einzelpunkte zum
 * Aufklappen. Jeder Einzelpunkt nennt das Projekt, das ihn belegt: ohne Beleg
 * kein Eintrag, sonst wäre es eine Wunschliste.
 */
import { getCollection, getEntry } from 'astro:content'
import Disclosure from '@/components/Disclosure.astro'
import Section from '@/components/Section.astro'
import { href } from '@/lib/site'

const company = (await getEntry('company', 'main'))!.data
const projekte = await getCollection('projekte')
const projektTitel = new Map(projekte.map((p) => [p.id, p.data.title]))
/** Unveröffentlichte Projekte haben keine Seite; ein Beleg nennt sie ohne Link. */
const ohneSeite = new Set(projekte.filter((p) => !p.data.published).map((p) => p.id))
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order)
const punkte = (n: number) => (n === 1 ? '1 Punkt' : `${n} Punkte`)
---

<Section
  id="leistungen"
  index="02"
  title="Angeboten wird nur, was schon gebaut wurde"
  intro="Ob Programm, Website oder Web-App: klein genug, um verstanden zu werden, und solide genug, um zu bleiben."
>
  <dl class="m-0 grid grid-cols-1 gap-x-8 sm:grid-cols-3">
    {
      company.services.map((service) => (
        <div class="border-t border-border pt-4 pb-8">
          <dt class="text-lg font-semibold tracking-tight">{service.title}</dt>
          <dd class="prose-flow mt-2 ml-0 text-sm leading-relaxed text-fg-muted">
            {service.description}
          </dd>
        </div>
      ))
    }
  </dl>

  <h3 class="mt-12 mb-0 text-sm font-medium text-fg-muted">Im Einzelnen</h3>
  <p class="mt-1 max-w-[65ch] text-sm text-fg-muted">
    Hinter jedem Punkt steht das Projekt, das ihn belegt.
  </p>
  <div class="mt-3 border-t border-border">
    {
      leistungen.map((group) => (
        <Disclosure title={group.data.title} meta={punkte(group.data.items.length)}>
          <p class="prose-flow mt-0 max-w-[65ch] text-sm text-fg-muted">{group.data.description}</p>
          <ul class="mt-5 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
            {group.data.items.map((item) => (
              <li>
                <span class="block text-sm font-medium">{item.title}</span>
                <span class="prose-flow block text-sm text-fg-muted">{item.description}</span>
                {item.evidence.length > 0 && (
                  <span class="mt-1 block text-xs text-fg-muted">
                    Beleg:{' '}
                    {item.evidence.map((slug, i) => (
                      <>
                        {i > 0 && ', '}
                        {ohneSeite.has(slug) ? (
                          projektTitel.get(slug)
                        ) : (
                          <a
                            class="text-accent underline-offset-4"
                            href={href(`/projekte/${slug}`)}
                          >
                            {projektTitel.get(slug) ?? slug}
                          </a>
                        )}
                      </>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </Disclosure>
      ))
    }
  </div>
</Section>
