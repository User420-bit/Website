---
/**
 * 05 Kontakt: nur die Handlung. Ab 1024 px zwei Spalten unter je einer
 * Haarlinie, wie die drei Arten in 02: links die Adresse groß und markierbar
 * (wer am PC nur Webmail nutzt, klickt mit einem mailto:-Knopf allein ins
 * Leere), darunter der Knopf; rechts die Erreichbarkeit. Schmaler stapelt
 * sich beides, die Adresse zuerst.
 *
 * Kein Bild: Das Foto des Rosenheimer Landes stand bis zum 2026-10-07 rechts
 * neben der Adresse und war dort größer als sie. Jetzt steht es in 04, beim
 * Text über Ort und Person; hier bleibt die Adresse das einzige große Element.
 *
 * Bewegung (docs/BEWEGUNG_PLAN.md, G): Adresse und Erreichbarkeit bewegen
 * sich in ihren Komponenten. Hier nur die Haarlinie über der Adresse: Sie
 * zieht von links auf wie die Linien der Erreichbarkeit daneben.
 *
 * Schlusspunkt (docs/NACH_DEM_HERO_PLAN.md): Über der Adresse steht noch
 * einmal die Eröffnung des Heros, „Sie erzählen. Ich höre zu.“, und läuft
 * Wort für Wort ein wie das Gerede. Die Seite endet, wo sie angefangen hat,
 * nur dass jetzt die Adresse darunter steht. Wort und Einlauf kommen aus
 * `GeredeEcho.astro` (`data-echo-gruppe`, `data-echo-wort`).
 */
import { getEntry } from 'astro:content'
import Button from '@/components/Button.astro'
import CopyEmail from '@/components/CopyEmail.astro'
import MetaList from '@/components/MetaList.astro'
import Section from '@/components/Section.astro'
import { mailto } from '@/lib/site'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const anfrage = mailto(company.email, contact.subject)
/** Wie viele Wörter der Eröffnung vor Zeile `z` stehen: Die Nummer läuft über die Zeilen weiter. */
const vorher = (z: number) =>
  company.heroAuftakt.slice(0, z).reduce((n, zeile) => n + zeile.split(' ').length, 0)

/** Erreichbarkeit im Kontakt: der Ort, dann die Profile, die in profile.json gesetzt sind. */
const erreichbarkeit: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: 'Ort', value: company.location },
]
if (profile.social.linkedin) {
  erreichbarkeit.push({
    label: 'Profil',
    value: 'LinkedIn',
    href: profile.social.linkedin,
    external: true,
  })
}
if (profile.social.github) {
  erreichbarkeit.push({
    label: 'Code',
    value: 'GitHub',
    href: profile.social.github,
    external: true,
  })
}
---

{/* Die Antwortzeit steht hier, bei der Adresse, und nicht mehr im Hero. */}
<Section
  id="kontakt"
  index="05"
  title={contact.heading}
  intro={`${contact.description} ${contact.responseTime}`}
>
  {
    /*
      Jede Spalte bringt ihre Haarlinie selbst mit: die Handlung als Kante,
      die Erreichbarkeit als erste Zeile ihrer Liste. Nebeneinander liegen
      beide auf einer Höhe, gestapelt hat jeder Block seine eigene.
    */
  }
  <div
    class="grid grid-cols-1 items-start gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"
  >
    <div
      class="kontakt-handlung relative border-t border-border pt-6"
      data-kontakt-handlung
      data-echo-gruppe
    >
      <span aria-hidden="true" class="kontakt-linie" data-bewegt data-kontakt-linie></span>
      <p class="m-0 mb-5 text-xl leading-snug font-semibold tracking-tight sm:text-2xl">
        {
          company.heroAuftakt.map((zeile, z) => (
            <span class:list={['block', z > 0 && 'text-fg-muted']}>
              {zeile.split(' ').map((wort, i) => (
                <>
                  <span data-echo-wort style={`--i: ${vorher(z) + i}`}>
                    {wort}
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </p>
      <CopyEmail email={company.email} />
      <p class="mt-3 mb-0 max-w-[65ch] text-xs text-fg-muted">
        Öffnet sich kein Mailprogramm? Dann die Adresse markieren und kopieren.
      </p>
      <p class="mt-8 mb-0">
        <Button href={anfrage}>E-Mail schreiben</Button>
      </p>
    </div>

    <MetaList rows={erreichbarkeit} einziehen />
  </div>
</Section>

<style>
  /*
   * Die Haarlinie bleibt als `border-top`, damit das Layout mit und ohne
   * Skript gleich hoch ist. Mit Bewegung wird die Kante durchsichtig, und an
   * ihrer Stelle liegt ein eigener Strich, der von links aufziehen kann (wie
   * in 02 Leistungen).
   */
  .kontakt-linie {
    display: none;
  }
  html[data-bewegung] .kontakt-handlung {
    border-top-color: transparent;
  }
  html[data-bewegung] .kontakt-linie {
    position: absolute;
    inset-inline: 0;
    top: -1px;
    display: block;
    height: 1px;
    background-color: var(--color-border);
    transform-origin: left;
  }
  html[data-bewegung] .kontakt-linie[data-bewegt] {
    transform: scaleX(0);
  }
</style>

<script>
  import { DAUER, KURVE, animate, inView, wennBewegt } from '@/lib/motion'

  const handlung = document.querySelector<HTMLElement>('[data-kontakt-handlung]')
  const linie = handlung?.querySelector<HTMLElement>('[data-kontakt-linie]')

  wennBewegt(() => {
    if (!handlung || !linie) return
    // Einmal, ohne Rückweg, zur selben Zeit wie die Linien der Erreichbarkeit.
    const halt = inView(
      handlung,
      () => {
        halt()
        animate(
          linie,
          { transform: ['scaleX(0)', 'scaleX(1)'] },
          { duration: DAUER.szene, ease: KURVE },
        ).then(() =>
          // Ein Bild später räumen: Motion schreibt den Endwert erst nach dem
          // Auflösen als Inline-Style.
          requestAnimationFrame(() => {
            linie.removeAttribute('data-bewegt')
            linie.style.removeProperty('transform')
          }),
        )
      },
      { amount: 0.2 },
    )
  })
</script>
