---
/**
 * 05 Kontakt: links die Handlung, die Adresse groß und markierbar (wer am PC
 * nur Webmail nutzt, klickt mit einem mailto:-Knopf allein ins Leere),
 * darunter Knopf und Erreichbarkeit. Ab 1024 px steht rechts daneben das Foto
 * und füllt die Höhe der Handlung. Eine Haarlinie über beiden Spalten, so
 * beginnen sie auf einer Höhe; schmaler stapelt sich alles, die Handlung zuerst.
 */
import { getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Button from '@/components/Button.astro'
import CopyEmail from '@/components/CopyEmail.astro'
import MetaList from '@/components/MetaList.astro'
import Section from '@/components/Section.astro'
import { mailto } from '@/lib/site'
import rosenheimerLand from '@/assets/kontakt/rosenheimer-land.jpg'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const anfrage = mailto(company.email, contact.subject)

/** Erreichbarkeit im Kontakt: der Ort, dann die Profile, die in profile.json gesetzt sind. */
const erreichbarkeit: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: 'Ort', value: company.location },
]
if (profile.social.linkedin) {
  erreichbarkeit.push({
    label: 'Profil',
    value: 'LinkedIn',
    href: profile.social.linkedin,
    external: true,
  })
}
if (profile.social.github) {
  erreichbarkeit.push({
    label: 'Code',
    value: 'GitHub',
    href: profile.social.github,
    external: true,
  })
}
---

<Section id="kontakt" index="05" title={contact.heading} intro={contact.description}>
  <div
    class="grid grid-cols-1 gap-12 border-t border-border pt-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"
  >
    <div>
      <CopyEmail email={company.email} />
      <p class="mt-3 mb-0 max-w-[65ch] text-xs text-fg-muted">
        Öffnet sich kein Mailprogramm? Dann die Adresse markieren und kopieren.
      </p>
      <p class="mt-8 mb-0">
        <Button href={anfrage}>E-Mail schreiben</Button>
      </p>
      <MetaList rows={erreichbarkeit} class="mt-10" />
    </div>

    {
      /*
      Der Raum, von dem der Hero spricht, als eigenes Foto: das Rosenheimer
      Land vom Breitenstein aus. Beleg für den Ort, keine Stimmungsfläche,
      deshalb hinter der Handlung. Unter 640 px zeigt ein 4:3-Ausschnitt die
      Mitte größer, sonst bliebe vom Land nur ein Strich; ab 1024 px
      schneidet die Spalte etwa 17:10 aus. `sizes` rechnet den Zoom jeweils mit
      ein (Faktor 1,84 bzw. rund 1,45).
    */
    }
    <figure class="m-0 lg:flex lg:flex-col">
      <Image
        class="block aspect-[4/3] h-auto w-full rounded-sm border border-border object-cover object-[60%_50%] sm:aspect-auto lg:h-0 lg:min-h-64 lg:flex-1"
        src={rosenheimerLand}
        alt="Blick vom Breitenstein über das Rosenheimer Land: bewaldete Hänge im Vordergrund, dahinter Felder, Moore, Ortschaften und Seen bis zum Horizont."
        widths={[640, 1024, 1600, 2048]}
        sizes="(min-width: 1024px) 44rem, (min-width: 640px) calc(100vw - 2rem), calc((100vw - 2rem) * 1.84)"
        loading="lazy"
      />
      <figcaption class="mt-3 text-xs text-fg-muted">
        Das Rosenheimer Land, vom Breitenstein aus gesehen. Eigenes Foto.
      </figcaption>
    </figure>
  </div>
</Section>
