---
/**
 * 05 Kontakt: nur die Handlung. Ab 1024 px zwei Spalten unter je einer
 * Haarlinie, wie die drei Arten in 02: links die Adresse groß und markierbar
 * (wer am PC nur Webmail nutzt, klickt mit einem mailto:-Knopf allein ins
 * Leere), darunter der Knopf; rechts die Erreichbarkeit. Schmaler stapelt
 * sich beides, die Adresse zuerst.
 *
 * Kein Bild: Das Foto des Rosenheimer Landes stand bis zum 2026-10-07 rechts
 * neben der Adresse und war dort größer als sie. Jetzt steht es in 04, beim
 * Text über Ort und Person; hier bleibt die Adresse das einzige große Element.
 *
 * Seit 2026-10-14 zieht hier nichts mehr ein (docs/RUHE_PLAN.md).
 *
 * Schlusspunkt (docs/NACH_DEM_HERO_PLAN.md): Über der Adresse steht noch
 * einmal die Eröffnung des Heros, „Sie erzählen. Ich höre zu.“ Die Seite
 * endet, wo sie angefangen hat, nur dass jetzt die Adresse darunter steht.
 * Die Zeile steht ruhig: Bewegt wird hier die Adresse.
 *
 * Der Antworttermin (bis 2026-10-22: Datum und sieben Tage als Kalender unter
 * dem Knopf) ist entfallen, er versprach zu konkret. Die Antwortzeit steht
 * nur noch als Regel im Intro.
 */
import { getEntry } from 'astro:content'
import Button from '@/components/Button.astro'
import CopyEmail from '@/components/CopyEmail.astro'
import MetaList from '@/components/MetaList.astro'
import Section from '@/components/Section.astro'
import { mailto } from '@/lib/site'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const anfrage = mailto(company.email, contact.subject)

/** Erreichbarkeit im Kontakt: der Ort, dann die Profile, die in profile.json gesetzt sind. */
const erreichbarkeit: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: 'Ort', value: company.location },
]
if (profile.social.linkedin) {
  erreichbarkeit.push({
    label: 'Profil',
    value: 'LinkedIn',
    href: profile.social.linkedin,
    external: true,
  })
}
if (profile.social.github) {
  erreichbarkeit.push({
    label: 'Code',
    value: 'GitHub',
    href: profile.social.github,
    external: true,
  })
}
---

{/* Die Antwortzeit steht hier, bei der Adresse, und nicht mehr im Hero. */}
<Section id="kontakt" index="05" title={contact.heading} intro={contact.description}>
  <span slot="intro">{' ' + contact.responseTime}</span>
  {
    /*
      Jede Spalte bringt ihre Haarlinie selbst mit: die Handlung als Kante,
      die Erreichbarkeit als erste Zeile ihrer Liste. Nebeneinander liegen
      beide auf einer Höhe, gestapelt hat jeder Block seine eigene.
    */
  }
  <div
    class="grid grid-cols-1 items-start gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]"
  >
    <div class="border-t border-border pt-6">
      <p class="m-0 mb-5 text-xl leading-snug font-semibold tracking-tight sm:text-2xl">
        {
          company.heroAuftakt.map((zeile, z) => (
            <span class:list={['block', z > 0 && 'text-fg-muted']}>{zeile}</span>
          ))
        }
      </p>
      <CopyEmail email={company.email} />
      <p class="mt-3 mb-0 max-w-[65ch] text-xs text-fg-muted">
        Öffnet sich kein Mailprogramm? Dann die Adresse markieren und kopieren.
      </p>
      <p class="mt-8 mb-0">
        <Button href={anfrage}>E-Mail schreiben</Button>
      </p>
    </div>

    <MetaList rows={erreichbarkeit} />
  </div>
</Section>
