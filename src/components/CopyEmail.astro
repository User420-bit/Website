---
/**
 * E-Mail-Adresse als markierbarer Text plus "Adresse kopieren". Wer Webmail
 * nutzt, hat von einem mailto:-Link nichts — die Adresse muss sich mitnehmen
 * lassen. Der Knopf erscheint erst, wenn der Browser die Zwischenablage
 * anbietet; ohne JavaScript bleibt die Adresse einfach lesbar. Gespeichert
 * wird nichts. Mehrfach auf einer Seite nutzbar: Knopf und Rückmeldung teilen
 * sich ein Elternelement, darüber findet das Script die richtige Zeile.
 *
 * Bewegung (docs/BEWEGUNG_PLAN.md, G): Der Unterstrich der Adresse zieht von
 * links auf, sobald sie ins Fenster kommt. Er ist deshalb kein
 * `text-decoration`, sondern ein Hintergrund wie bei `.row-title`, und liegt
 * auf einem inneren `<span>`, damit eine umbrochene Adresse (schmale
 * Bildschirme) unter jeder Zeile ihre Linie behält. „Adresse kopieren“ gibt
 * bei Druck nach, „Kopiert.“ zieht ein und blendet nach 2 s aus.
 *
 * `schreiben` (Signatur des Kontakts, docs/SEKTIONEN_SIGNATUR_PLAN.md): Statt
 * der aufziehenden Linie tippt sich die Adresse ein, Zeichen für Zeichen
 * (55 ms je Zeichen), mit Unterstrich; danach blinkt ein oranger Cursor
 * dreimal und verschwindet, zusammen unter 3 s. Der Text selbst wird nicht
 * zerlegt: Ein `clip-path` deckt ihn schrittweise an den gemessenen
 * Zeichengrenzen auf, so bleiben Link, Vorlesen und Markieren wie sie sind.
 * Bricht die Adresse um (sehr schmal), zieht wie sonst nur die Linie auf.
 */
interface Props {
  email: string
  /** Adresse tippt sich beim Hereinscrollen ein (siehe oben). */
  schreiben?: boolean
  class?: string
}

const { email, schreiben = false, class: className = '' } = Astro.props
---

<div class:list={['flex flex-col items-start gap-3', className]}>
  <a
    class="adresse display text-2xl font-semibold wrap-anywhere text-fg no-underline sm:text-3xl"
    href={`mailto:${email}`}
  >
    <span
      class="adresse-linie"
      data-adresse-linie
      data-bewegt
      data-schreiben={schreiben || undefined}>{email}</span
    >{schreiben && <span aria-hidden="true" class="adresse-cursor" data-adresse-cursor />}
  </a>
  <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <button
      type="button"
      hidden
      data-copy={email}
      class="cursor-pointer rounded-md border border-border-strong bg-surface px-3.5 py-2 text-sm font-medium text-fg transition-colors hover:border-accent hover:bg-accent-soft hover:text-accent motion-reduce:transition-none"
    >
      Adresse kopieren
    </button>
    <span role="status" aria-live="polite" data-copy-status class="text-sm text-fg-muted"></span>
  </span>
</div>

<style>
  /*
   * Farbe der Linie als eigene Eigenschaft, damit sie bei Hover wie vorher in
   * 200 ms nach Orange wechselt: Einen Verlauf kann der Browser nicht
   * überblenden, eine registrierte Farbe schon.
   */
  @property --adresse-linie {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }

  .adresse {
    --adresse-linie: var(--color-border);
    transition: --adresse-linie var(--duration-base) var(--ease-quiet);
  }
  .adresse:hover,
  .adresse:focus-visible {
    --adresse-linie: var(--color-accent);
  }

  /*
   * 1 px Linie unter jeder Zeile. Das Polster unten setzt sie dorthin, wo
   * `underline-offset-8` sie vorher hatte; senkrechtes Polster an einem
   * Inline-Element ändert die Zeilenhöhe nicht.
   */
  .adresse-linie {
    padding-bottom: 0.05em;
    background-image: linear-gradient(var(--adresse-linie), var(--adresse-linie));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /*
   * Anfangszustand nur mit Skript und erlaubter Bewegung. `background-size`
   * deckt das gemeinsame Sicherheitsnetz aus global.css nicht ab, deshalb
   * läuft hier daneben ein eigenes, das nach 2 s dasselbe tut.
   */
  html[data-bewegung] .adresse-linie[data-bewegt] {
    background-size: 0% 1px;
    animation:
      bewegt-sichtbar 0s 2s both,
      adresse-linie-sichtbar 0s 2s both;
  }
  @keyframes adresse-linie-sichtbar {
    to {
      background-size: 100% 1px;
    }
  }

  /*
   * Schreiben: Die Adresse ist anfangs ganz abgedeckt (das Sicherheitsnetz
   * oben deckt sie nach 2 s auf, falls das Modul nicht läuft). `inline-block`,
   * damit `clip-path` eine einzige Box hat; das Skript prüft vorher, dass die
   * Adresse in eine Zeile passt.
   */
  html[data-bewegung] .adresse-linie[data-schreiben][data-bewegt] {
    clip-path: inset(0 100% 0 0);
  }
  /* Bezugspunkt des Cursors beim Schreiben. */
  .adresse {
    position: relative;
  }
  .adresse-cursor {
    position: absolute;
    top: 0.12em;
    bottom: 0.2em;
    left: 0;
    width: 2px;
    background-color: var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .adresse {
      transition: none;
    }
  }
</style>

<script>
  import { DAUER, KURVE, WEG_TEXT, animate, bewegt, inView, press } from '@/lib/motion'

  /**
   * Hält das Sicherheitsnetz (CSS-Animation nach 2 s) an, solange es noch
   * nicht gegriffen hat: Ab jetzt zeigt das Skript das Element. Falsch, wenn
   * das Netz schon gegriffen hat (Skript kam spät); dann ist das Element
   * sichtbar und soll nicht noch einmal verschwinden.
   */
  function netzAnhalten(el: Element): boolean {
    const netz = el.getAnimations().filter((a) => a instanceof CSSAnimation)
    if (netz.some((a) => a.playState === 'finished')) return false
    for (const a of netz) a.cancel()
    return true
  }

  /**
   * Räumt erst im nächsten Bild auf: Motion schreibt die Endwerte selbst noch
   * als Inline-Stil, nachdem `then` gelaufen ist.
   */
  const danach = (aufraeumen: () => void) => requestAnimationFrame(() => aufraeumen())

  /** Endzustand der Linie: Anfangszustand weg, eigene Inline-Werte weg. */
  function linieInRuhe(el: HTMLElement) {
    el.removeAttribute('data-bewegt')
    el.style.removeProperty('background-size')
  }

  const mitBewegung = bewegt()

  /** Millisekunden je Zeichen beim Schreiben; der Cursor blinkt danach dreimal (je 500 ms). */
  const ZEICHEN_MS = 55
  const BLINKEN = 3

  /*
   * Schreiben: Zeichengrenzen über einen Range messen, dann den Text in
   * Sprüngen an genau diesen Grenzen aufdecken, Cursor an der Kante mit.
   * Falsch, wenn die Adresse umbricht; dann bleibt es bei der Linie.
   */
  function schreiben(linie: HTMLElement): boolean {
    const text = linie.firstChild
    const cursor = linie.parentElement?.querySelector<HTMLElement>('[data-adresse-cursor]')
    if (!(text instanceof Text) || !cursor) return false
    const range = document.createRange()
    range.selectNodeContents(text)
    if (range.getClientRects().length > 1) return false

    linie.style.display = 'inline-block'
    linie.style.backgroundSize = '100% 1px'
    const kasten = linie.getBoundingClientRect()
    const versatz = kasten.left - linie.parentElement!.getBoundingClientRect().left
    const grenzen = [0]
    for (let i = 1; i <= text.length; i++) {
      range.setStart(text, 0)
      range.setEnd(text, i)
      grenzen.push(range.getBoundingClientRect().right - kasten.left)
    }
    const breite = kasten.width
    const schritte = grenzen.length - 1
    const dauer = schritte * ZEICHEN_MS

    /*
     * Beobachtet wird der Link, nicht der Text: Chromium rechnet den
     * `clip-path` des Ziels in die Sichtbarkeit ein, eine ganz abgedeckte
     * Adresse käme also nie ins Fenster.
     */
    inView(
      linie.parentElement!,
      () => {
        const auf = linie.animate(
          grenzen.map((x, k) => ({
            clipPath: `inset(0 ${Math.max(0, breite - x).toFixed(1)}px 0 0)`,
            offset: k / schritte,
            easing: 'step-end',
          })),
          { duration: dauer, fill: 'forwards' },
        )
        cursor.style.opacity = '1'
        const mit = cursor.animate(
          grenzen.map((x, k) => ({
            transform: `translateX(${(versatz + x).toFixed(1)}px)`,
            offset: k / schritte,
            easing: 'step-end',
          })),
          { duration: dauer, fill: 'forwards' },
        )
        void Promise.all([auf.finished, mit.finished])
          .then(() => {
            // Endzustand wie ohne Bewegung: nichts abgedeckt, nichts transformiert.
            linie.removeAttribute('data-bewegt')
            for (const p of ['clip-path', 'display', 'background-size'])
              linie.style.removeProperty(p)
            auf.cancel()
            return cursor.animate([{ opacity: 1 }, { opacity: 0 }], {
              duration: 250,
              iterations: BLINKEN * 2,
              direction: 'alternate',
              easing: 'steps(1, end)',
            }).finished
          })
          .then(() => {
            cursor.style.opacity = '0'
            mit.cancel()
          })
      },
      { amount: 0.6 },
    )
    return true
  }

  for (const linie of document.querySelectorAll<HTMLElement>('[data-adresse-linie]')) {
    if (!mitBewegung || !netzAnhalten(linie)) {
      linieInRuhe(linie)
      continue
    }
    if ('schreiben' in linie.dataset) {
      if (schreiben(linie)) continue
      // Umbrochen: Abdeckung weg, dann wie sonst die Linie.
      linie.style.removeProperty('display')
      linie.style.removeProperty('background-size')
      linie.style.clipPath = 'none'
    }
    // Einmal, sobald die Adresse im Fenster steht, ohne Rückweg.
    inView(
      linie,
      () => {
        animate(
          linie,
          { backgroundSize: ['0% 1px', '100% 1px'] },
          { duration: DAUER.szene, ease: KURVE },
        ).then(() => danach(() => linieInRuhe(linie)))
      },
      { amount: 0.2 },
    )
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]')
    if (!status || !navigator.clipboard) continue

    button.hidden = false
    let timer: number | undefined
    // Zählt die Klicks, damit ein spätes Ausblenden keine neue Rückmeldung löscht.
    let runde = 0

    if (mitBewegung) {
      // Der Knopf gibt bei Druck nach und kommt zurück; danach steht kein Transform.
      press(button, () => {
        animate(button, { scale: 0.98 }, { duration: DAUER.schnell, ease: KURVE })
        return () => {
          animate(button, { scale: 1 }, { duration: DAUER.schnell, ease: KURVE }).then(() =>
            danach(() => button.style.removeProperty('transform')),
          )
        }
      })
    }

    /** Leert die Rückmeldung; mit Bewegung blendet sie vorher aus. */
    const leeren = (meine: number) => {
      if (!mitBewegung) {
        status.textContent = ''
        return
      }
      animate(status, { opacity: 0 }, { duration: DAUER.basis, ease: KURVE }).then(() =>
        danach(() => {
          if (meine !== runde) return
          status.textContent = ''
          status.style.removeProperty('opacity')
        }),
      )
    }

    button.addEventListener('click', async () => {
      const meine = ++runde
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
        status.textContent = 'Kopiert.'
      } catch {
        status.textContent = 'Bitte die Adresse markieren und kopieren.'
      }
      if (mitBewegung) {
        // Die Rückmeldung zieht ein wie Text sonst auch: 8 px, 320 ms.
        animate(
          status,
          { opacity: [0, 1], y: [WEG_TEXT, 0] },
          { duration: DAUER.langsam, ease: KURVE },
        ).then(() =>
          danach(() => {
            if (meine !== runde) return
            status.style.removeProperty('opacity')
            status.style.removeProperty('transform')
          }),
        )
      }
      window.clearTimeout(timer)
      timer = window.setTimeout(() => leeren(meine), 2000)
    })
  }
</script>
