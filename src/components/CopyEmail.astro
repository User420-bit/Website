---
/**
 * E-Mail-Adresse als markierbarer Text plus "Adresse kopieren". Wer Webmail
 * nutzt, hat von einem mailto:-Link nichts — die Adresse muss sich mitnehmen
 * lassen. Der Knopf erscheint erst, wenn der Browser die Zwischenablage
 * anbietet; ohne JavaScript bleibt die Adresse einfach lesbar. Gespeichert
 * wird nichts. Mehrfach auf einer Seite nutzbar: Knopf und Rückmeldung teilen
 * sich ein Elternelement, darüber findet das Script die richtige Zeile.
 *
 * `large`: die Hauptadresse in Title Large, Knopf und Rückmeldung darunter.
 * `inline`: eine Zeile in Body Small für die Ausweichadresse, optional mit
 * `label` davor ("Oder an").
 */
interface Props {
  email: string
  size?: 'large' | 'inline'
  label?: string
  class?: string
}

const { email, size = 'large', label, class: className = '' } = Astro.props
---

{
  size === 'large' ? (
    <div class:list={['flex flex-col items-start gap-3', className]}>
      <a
        class="display text-2xl font-semibold wrap-anywhere text-fg underline decoration-border underline-offset-8 transition-colors hover:decoration-accent motion-reduce:transition-none sm:text-3xl"
        href={`mailto:${email}`}
      >
        {email}
      </a>
      <span class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <button
          type="button"
          hidden
          data-copy={email}
          class="cursor-pointer rounded-sm border border-fg/25 px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none"
        >
          Adresse kopieren
        </button>
        <span role="status" aria-live="polite" data-copy-status class="text-sm text-fg-muted" />
      </span>
    </div>
  ) : (
    <p
      class:list={[
        'm-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-fg-muted',
        className,
      ]}
    >
      {label && <span>{label}</span>}
      <a
        class="font-medium wrap-anywhere text-fg underline decoration-border underline-offset-4 transition-colors hover:decoration-accent motion-reduce:transition-none"
        href={`mailto:${email}`}
      >
        {email}
      </a>
      <span class="inline-flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <button
          type="button"
          hidden
          data-copy={email}
          class="cursor-pointer text-sm font-medium text-fg underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent motion-reduce:transition-none"
        >
          Adresse kopieren
        </button>
        <span role="status" aria-live="polite" data-copy-status class="text-sm text-fg-muted" />
      </span>
    </p>
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]')
    if (!status || !navigator.clipboard) continue

    button.hidden = false
    let timer: number | undefined
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '')
        status.textContent = 'Kopiert.'
      } catch {
        status.textContent = 'Bitte die Adresse markieren und kopieren.'
      }
      window.clearTimeout(timer)
      timer = window.setTimeout(() => (status.textContent = ''), 2000)
    })
  }
</script>
