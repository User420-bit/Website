---
/**
 * Eine Zeile im Arbeiten-Index: Titel, Art, Zeitraum. Die ganze Zeile ist der
 * Link; Hover und Tastaturfokus sehen gleich aus.
 */
import Arrow from '@/components/Arrow.astro'
import KindLabel from '@/components/KindLabel.astro'
import { href } from '@/lib/site'

interface Props {
  slug: string
  title: string
  kind: string
  period: string
}

const { slug, title, kind, period } = Astro.props
---

<li
  class="group relative grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-6 gap-y-1 border-b border-border py-4 sm:grid-cols-[minmax(0,1fr)_9rem_11rem_1rem]"
>
  <h3
    class="m-0 text-base font-medium transition-transform group-focus-within:translate-x-1 group-hover:translate-x-1 motion-reduce:transform-none motion-reduce:transition-none"
  >
    <a
      class="row-title text-fg no-underline after:absolute after:inset-0 after:content-['']"
      href={href(`/projekte/${slug}`)}
    >
      {title}
    </a>
  </h3>
  <KindLabel kind={kind} class="col-start-1 row-start-2 sm:col-start-2 sm:row-start-1" />
  <span
    class="col-start-2 row-start-2 text-sm text-fg-muted tabular-nums sm:col-start-3 sm:row-start-1"
  >
    {period}
  </span>
  <Arrow
    class="col-start-2 row-start-1 self-center justify-self-end text-fg-muted transition-transform group-focus-within:translate-x-0.5 group-hover:translate-x-0.5 group-hover:text-accent motion-reduce:transition-none sm:col-start-4"
  />
</li>
