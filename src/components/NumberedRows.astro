---
/**
 * Nummerierte Zeilen: Ziffer, Titel, Erklärung, Haarlinie darunter. Dasselbe
 * Muster trägt die Werte in „Arbeitsweise“. Die
 * Ziffer ist Ordnung fürs Auge, keine Information — die Reihenfolge steht
 * ohnehin im `<ol>`, deshalb `aria-hidden`.
 *
 * `titleColumn`: ab `sm` bekommt der Titel eine eigene Spalte, die Erklärung
 * steht daneben (Arbeitsweise: kurze Namen). Ohne steht die Erklärung unter
 * dem Titel.
 *
 * Bewegung (docs/BEWEGUNG_PLAN.md, E): Kommt die Liste ins Fenster, baut sie
 * sich Zeile um Zeile von oben auf. Die Haarlinie unter der Zeile zieht von
 * links auf, Titel und Erklärung ziehen 8 px ein, die Ziffer rastet als
 * Letztes ein (nur Deckkraft, kein Zählen). Damit die Linie aufziehen kann,
 * ist sie kein `border-bottom`, sondern ein eigenes Element am unteren Rand;
 * das Pixel, das der Rand belegte, hält `pb-[calc(1rem+1px)]` frei. Ohne
 * Skript sieht die Liste darum genauso aus wie vorher.
 *
 * `fahrplan` (Signatur von 03 Arbeitsweise, docs/SEKTIONEN_SIGNATUR_PLAN.md):
 * „Erst klären, was geht, dann bauen“ ist eine Reihenfolge. Neben den Ziffern
 * läuft beim Scrollen eine orange Linie von der ersten zur letzten, ihre
 * Spitze steht immer bei 60 % der Fensterhöhe; jede Ziffer, die sie erreicht,
 * rastet in Orange ein. Ans Scrollen gebunden wie die Flüge im Hero, also
 * auch zurück. Nur mit Bewegung; ohne steht die Liste wie immer.
 */
import GeredeEcho from '@/components/GeredeEcho.astro'
import type { Echo } from '@/lib/echo'

interface Props {
  /** `echo`: optionaler Rückbezug aufs Gerede des Heros (`lib/echo.ts`), steht über der Erklärung. */
  items: readonly { title: string; description: string; echo?: Echo }[]
  titleColumn?: boolean
  /** Linie, die beim Scrollen von Ziffer zu Ziffer läuft (siehe oben). */
  fahrplan?: boolean
  class?: string
}

const { items, titleColumn = false, fahrplan = false, class: className = '' } = Astro.props
---

<div class="relative" data-zeilen-rahmen>
  <ol data-zeilen class:list={['m-0 list-none border-t border-border p-0', className]}>
    {
      items.map((item, i) => (
        <li
          class:list={[
            'relative grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 pt-4 pb-[calc(1rem+1px)]',
            titleColumn && 'sm:grid-cols-[2rem_10rem_minmax(0,1fr)]',
          ]}
          data-echo-gruppe={item.echo ? '' : undefined}
        >
          <span
            aria-hidden="true"
            data-bewegt
            data-zeile-ziffer
            class="zeile-ziffer text-sm text-fg-muted tabular-nums"
          >
            {i + 1}
          </span>
          <span data-bewegt data-zeile-text class="zeile-text font-medium">
            {item.title}
          </span>
          <span
            data-bewegt
            data-zeile-text
            class:list={[
              'zeile-text prose-flow col-start-2 mt-1 max-w-[55ch] text-sm text-fg-muted',
              titleColumn && 'sm:col-start-3 sm:mt-0',
            ]}
          >
            {item.echo ? (
              <>
                <GeredeEcho worte={item.echo.worte} class="mb-1.5" />
                <span class="block" set:html={item.echo.html} />
              </>
            ) : (
              item.description
            )}
          </span>
          <span
            aria-hidden="true"
            data-bewegt
            data-zeile-linie
            class="zeile-linie absolute inset-x-0 bottom-0 h-px bg-border"
          />
        </li>
      ))
    }
  </ol>
  {
    fahrplan && (
      <span aria-hidden="true" class="fahrplan" data-fahrplan>
        <span class="fahrplan-strich" data-fahrplan-strich />
      </span>
    )
  }
</div>

<style>
  /*
   * Der Fahrplan: eine Haarlinie zwischen erster und letzter Ziffer, darin der
   * orange Strich, der von oben wächst. Lage und Länge misst das Skript.
   */
  .fahrplan {
    display: none;
  }
  :global(html[data-bewegung]) .fahrplan {
    position: absolute;
    left: 1.125rem;
    display: block;
    width: 1px;
    background-color: var(--color-border);
  }
  .fahrplan-strich {
    position: absolute;
    inset: 0 -0.5px;
    background-color: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
  }
  .zeile-ziffer {
    transition: color var(--duration-base) var(--ease-quiet);
  }
  li[data-erreicht] .zeile-ziffer {
    color: var(--color-accent);
    font-weight: 600;
  }

  /*
   * Anfangszustände nur mit Skript und erlaubter Bewegung (`data-bewegung`
   * setzt MotionReady). Ohne das Attribut steht alles sofort.
   */
  :global(html[data-bewegung]) .zeile-linie {
    transform: scaleX(0);
    transform-origin: left;
  }
  :global(html[data-bewegung]) .zeile-text {
    opacity: 0;
    transform: translateY(8px);
  }
  :global(html[data-bewegung]) .zeile-ziffer {
    opacity: 0;
  }
</style>

<script>
  import {
    DAUER,
    KURVE,
    STAFFEL,
    WEG_TEXT,
    alle,
    animate,
    inView,
    scroll,
    wennBewegt,
  } from '@/lib/motion'

  /*
   * Abstand zwischen zwei Zeilen. Der Plan sieht hier 80 ms vor, etwas mehr als
   * `STAFFEL`: Innerhalb einer Zeile staffeln Titel und Erklärung schon um
   * `STAFFEL`, die Zeilen selbst sollen sich davon sichtbar absetzen.
   */
  const STAFFEL_ZEILE = 0.08

  /** Der Endzustand, wie ohne Skript. Inline, damit er über dem Anfangszustand aus CSS steht. */
  function ruhe(el: HTMLElement) {
    el.style.opacity = '1'
    el.style.transform = 'none'
  }

  /*
   * Das Sicherheitsnetz in global.css zeigt jedes `data-bewegt` nach 2 s, falls
   * das Modul nicht läuft. Hier läuft es; die Liste soll aber erst erscheinen,
   * wenn sie ins Fenster kommt, und das kann viel später sein. Darum nimmt jedes
   * Element das Netz ab, solange es noch nicht gegriffen hat. Hat es schon
   * gegriffen (Modul kam spät), steht die Liste bereits und bleibt so: lieber
   * keine Bewegung als ein Aufblitzen.
   */
  function netzAbnehmen(teile: HTMLElement[]): boolean {
    const gegriffen = teile.some((el) =>
      el
        .getAnimations()
        .some(
          (a) =>
            a instanceof CSSAnimation &&
            a.animationName === 'bewegt-sichtbar' &&
            a.playState === 'finished',
        ),
    )
    if (gegriffen) return false
    for (const el of teile) el.style.animation = 'none'
    return true
  }

  function zeilen(liste: HTMLElement) {
    const reihen = alle('li', liste)
    if (!netzAbnehmen(alle('[data-bewegt]', liste))) return

    inView(
      liste,
      () => {
        reihen.forEach((reihe, i) => {
          const start = i * STAFFEL_ZEILE
          const linie = reihe.querySelector<HTMLElement>('[data-zeile-linie]')
          const ziffer = reihe.querySelector<HTMLElement>('[data-zeile-ziffer]')

          if (linie) {
            animate(
              linie,
              { transform: ['scaleX(0)', 'none'] },
              { duration: DAUER.szene, ease: KURVE, delay: start },
            ).then(() => ruhe(linie))
          }
          alle('[data-zeile-text]', reihe).forEach((text, j) => {
            animate(
              text,
              { opacity: [0, 1], y: [WEG_TEXT, 0] },
              { duration: DAUER.langsam, ease: KURVE, delay: start + j * STAFFEL },
            ).then(() => ruhe(text))
          })
          // Die Ziffer rastet ein, wenn der Titel angekommen ist: kurz, nur Deckkraft.
          if (ziffer) {
            animate(
              ziffer,
              { opacity: [0, 1] },
              { duration: DAUER.schnell, ease: KURVE, delay: start + DAUER.langsam },
            ).then(() => ruhe(ziffer))
          }
        })
        // Keine Rückgabe, also kein Rückweg: Was da ist, bleibt da.
      },
      { amount: 0.2 },
    )
  }

  /*
   * Fahrplan: Die Spitze der Linie steht bei 60 % der Fensterhöhe. Gemessen
   * werden die Mitten der Ziffern (bei jeder Größenänderung neu), dann je
   * Bild nur die Lage des Rahmens. Ziffern bewegen sich beim Einzug nicht,
   * nur ihre Deckkraft; die Maße stimmen also auch währenddessen.
   */
  function fahrplan(rahmen: HTMLElement) {
    const spur = rahmen.querySelector<HTMLElement>('[data-fahrplan]')
    const strich = rahmen.querySelector<HTMLElement>('[data-fahrplan-strich]')
    const reihen = alle('li', rahmen)
    const ziffern = reihen.map((reihe) => reihe.querySelector<HTMLElement>('[data-zeile-ziffer]'))
    if (!spur || !strich || reihen.length < 2 || ziffern.some((z) => !z)) return

    let mitten: number[] = []
    const messen = () => {
      const oben = rahmen.getBoundingClientRect().top
      mitten = ziffern.map((z) => {
        const b = z!.getBoundingClientRect()
        return b.top + b.height / 2 - oben
      })
      spur.style.top = `${mitten[0]}px`
      spur.style.height = `${mitten.at(-1)! - mitten[0]!}px`
    }
    const stellen = () => {
      const spitze = window.innerHeight * 0.6 - rahmen.getBoundingClientRect().top
      const laenge = mitten.at(-1)! - mitten[0]!
      const weit = Math.min(1, Math.max(0, (spitze - mitten[0]!) / laenge))
      strich.style.transform = `scaleY(${weit.toFixed(4)})`
      reihen.forEach((reihe, i) => reihe.toggleAttribute('data-erreicht', spitze >= mitten[i]! - 1))
    }
    const neu = () => {
      messen()
      stellen()
    }
    neu()
    void document.fonts.ready.then(neu)
    window.addEventListener('resize', neu)
    scroll(stellen)
  }

  wennBewegt(() => {
    alle('[data-zeilen]').forEach(zeilen)
    alle('[data-zeilen-rahmen]')
      .filter((rahmen) => rahmen.querySelector('[data-fahrplan]'))
      .forEach(fahrplan)
  })
</script>
