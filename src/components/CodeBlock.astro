---
interface Props {
  language: string
  snippet: string
}

const { language, snippet } = Astro.props

/*
 * Klassen liegen in Variablen, damit die Markup-Zeile kurz genug bleibt:
 * Prettier bricht sonst um, und in einem `<pre>` landet die Einrueckung als
 * sichtbarer Leerraum im gerenderten Code.
 */
const preClass =
  'mt-4 overflow-x-auto rounded-lg border border-border bg-bg-elevated p-4 text-sm leading-relaxed'
const codeClass = `language-${language}`
---

<pre class={preClass}><code class={codeClass} set:text={snippet.trim()} /></pre>
