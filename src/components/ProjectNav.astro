---
/**
 * Kopfzeile jeder Projektseite: links zurück zu allen Arbeiten, rechts zwei
 * Knöpfe zur vorherigen und nächsten Arbeit. So blättert man gleich am Anfang
 * weiter und muss nicht erst ans Ende der Seite; Vor/Zurück mit Titeln steht
 * dort zusätzlich (ProjectPage).
 *
 * Die Knöpfe sind 2rem groß, ihre Trefferfläche reicht auf 44 px; negativer
 * Rand hält die Zeile so hoch wie den Link allein. Fehlt ein Nachbar (erste
 * oder letzte Arbeit), steht der Knopf blass und ohne Link da, damit der
 * andere nicht springt.
 */
import type { Projekt } from '@/components/ProjectPage.astro'
import Arrow from '@/components/Arrow.astro'
import { href } from '@/lib/site'

interface Props {
  prev: Projekt | null
  next: Projekt | null
  /** Klassen des Links „Alle Arbeiten“, wenn der Kopf ihn anders färbt (PointCare). */
  linkClass?: string
  class?: string
}

const {
  prev,
  next,
  linkClass = 'inline-flex items-center gap-2 text-sm text-fg-muted no-underline hover:text-accent',
  class: className,
} = Astro.props

const knoepfe = [
  { nachbar: prev, richtung: 'left' as const, label: 'Vorherige Arbeit' },
  { nachbar: next, richtung: 'right' as const, label: 'Nächste Arbeit' },
]
---

<nav
  aria-label="Arbeiten blättern"
  class:list={['flex items-center justify-between gap-4', className]}
>
  <a class={linkClass} href={href('/projekte/')}>
    <Arrow direction="left" /> Alle Arbeiten
  </a>
  <span class="-my-1.5 flex gap-2">
    {
      knoepfe.map(({ nachbar, richtung, label }) =>
        nachbar ? (
          <a
            class="blaettern"
            href={href(`/projekte/${nachbar.id}`)}
            aria-label={`${label}: ${nachbar.data.title}`}
            title={`${label}: ${nachbar.data.title}`}
          >
            <Arrow direction={richtung} />
          </a>
        ) : (
          <span class="blaettern blaettern-leer" aria-hidden="true">
            <Arrow direction={richtung} />
          </span>
        ),
      )
    }
  </span>
</nav>

<style>
  .blaettern {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid color-mix(in oklch, currentColor 30%, transparent);
    border-radius: var(--radius-sm);
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      color var(--duration-base) var(--ease-quiet),
      border-color var(--duration-base) var(--ease-quiet);
  }
  /* Trefferfläche 44 px, ohne dass der Knopf größer aussieht. */
  .blaettern::before {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }
  a.blaettern:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .blaettern-leer {
    opacity: 0.35;
  }
  @media (prefers-reduced-motion: reduce) {
    .blaettern {
      transition: none;
    }
  }
</style>
