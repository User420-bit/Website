---
/**
 * Der gemeinsame Körper einer Projektseite: Zurück-Link, H1, Summary,
 * Meta-Liste, Links, Screenshots, die vier Textblöcke, Vor/Zurück und die
 * Anfrage-Zeile. `src/pages/projekte/[slug].astro` rendert ihn direkt, oder
 * über die Seitenkomponente des Projekts aus `src/components/projekte/`,
 * die ihn an benannten Stellen erweitert oder Teile ersetzt.
 *
 * Slots, in Seitenreihenfolge:
 * - `hero`: ersetzt Zurück-Link, H1 und Summary. Wer ihn füllt, muss die H1
 *   mit `data.title` selbst setzen; `scripts/verify-build.mjs` prüft genau
 *   eine H1 mit diesem Text.
 * - `stage`: direkt unter der Summary, vor der Meta-Liste (die Bühne).
 * - `after-meta`: nach Meta-Liste und Links, vor den Screenshots.
 * - `before-text`: vor „Worum es geht“.
 * - `after-text`: nach „Erkenntnisse“, vor Vor/Zurück.
 *
 * `hide` blendet Standardteile aus, wenn die Seitenkomponente sie selbst
 * anders zeigt. `articleClass` hängt Klassen an den `<article>`.
 *
 * Übergang von der Kachel (DESIGN.md, Bewegung): Der `<article>` trägt den
 * Namen `projekt-<slug>`, genau ein Element darin markiert mit
 * `data-uebergang` das erste große Bild im ersten Bildschirm, meist die Bühne.
 * Dorthin wächst das Bildfeld der Kachel. Welches es ist, entscheidet die
 * Seiten- oder Szenenkomponente; `scripts/verify-build.mjs` prüft, dass es
 * genau eins gibt.
 */
import ProjectNav from '@/components/ProjectNav.astro'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import Arrow from '@/components/Arrow.astro'
import Button from '@/components/Button.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import MetaList from '@/components/MetaList.astro'
import ScreenshotGallery from '@/components/ScreenshotGallery.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { href, uebergang } from '@/lib/site'

export type Projekt = CollectionEntry<'projekte'>
export type Teil =
  | 'meta'
  | 'links'
  | 'gallery'
  | 'text'
  | 'features'
  | 'engineering'
  | 'code'
  | 'learnings'
  | 'pager'
  | 'inquiry'

export interface Props {
  projekt: Projekt
  prev: Projekt | null
  next: Projekt | null
  hide?: Teil[]
  articleClass?: string
}

const { projekt, prev, next, hide = [], articleClass } = Astro.props
const { Content } = await render(projekt)
const data = projekt.data
const zeigt = (teil: Teil) => !hide.includes(teil)

// Wie auf der Startseite: Überschrift über dem Inhalt, Haarlinie oben.
const block = 'mt-12 border-t border-border pt-6'
const blockTitle = 'm-0 text-xl font-semibold tracking-tight'
const list = 'prose-flow m-0 max-w-[65ch] list-none space-y-3 p-0 text-fg-muted'
const lists = [
  { teil: 'features' as const, title: 'Funktionen', items: data.features },
  { teil: 'engineering' as const, title: 'Technische Entscheidungen', items: data.engineering },
]
---

<BaseLayout title={`${data.title} – Klartext`} description={data.summary}>
  <article class:list={['pt-6 pb-12 sm:py-16', articleClass]} style={uebergang(projekt.id)}>
    {
      Astro.slots.has('hero') ? (
        <slot name="hero" />
      ) : (
        <>
          <ProjectNav prev={prev} next={next} />

          <h1 class="display mt-4 mb-0 text-4xl font-semibold text-balance sm:mt-6 sm:text-5xl">
            {data.title}
          </h1>
          <p class="prose-flow mt-3 max-w-[65ch] text-base leading-relaxed text-fg-muted sm:mt-5 sm:text-lg">
            {data.summary}
          </p>
        </>
      )
    }

    {/* Erst sagen, worum es geht, dann zeigen, dann die Fakten. */}
    <slot name="stage" />

    {
      zeigt('meta') && (
        <div class="mt-8">
          <MetaList
            rows={[
              { label: 'Art', value: data.kind, variant: 'kind' },
              { label: 'Zeitraum', value: data.period, variant: 'numeric' },
              ...(data.status ? [{ label: 'Stand', value: data.status }] : []),
              { label: 'Technik', value: data.techStack.join(' · '), variant: 'mono' },
            ]}
          />
        </div>
      )
    }

    {
      zeigt('links') && (data.live || data.github) && (
        <ul class="mt-6 flex list-none flex-wrap gap-3 p-0">
          {data.live && (
            <li>
              <Button href={data.live} external>
                Live ansehen
              </Button>
            </li>
          )}
          {data.github && (
            <li>
              <Button href={data.github} variant="secondary" external>
                Code auf GitHub
              </Button>
            </li>
          )}
        </ul>
      )
    }

    <slot name="after-meta" />

    {/* Erst das Bild, dann der Text: Der Beleg steht vor der Beschreibung. */}
    {zeigt('gallery') && <ScreenshotGallery shots={data.screenshots} title={data.title} />}

    <slot name="before-text" />

    {
      zeigt('text') && (
        <section class={block}>
          <h2 class={blockTitle}>Worum es geht</h2>
          <div class="prose-flow mt-4 max-w-[65ch] space-y-4 leading-relaxed text-fg-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4">
            <Content />
          </div>
        </section>
      )
    }

    {
      lists.map(
        ({ teil, title, items }) =>
          zeigt(teil) &&
          items.length > 0 && (
            <section class={block}>
              <h2 class={blockTitle}>{title}</h2>
              <ul class:list={[list, 'mt-4']}>
                {items.map((item) => (
                  <li class="border-b border-border pb-3">{item}</li>
                ))}
              </ul>
            </section>
          ),
      )
    }

    {
      zeigt('code') && data.codeExample && (
        <section class={block}>
          <h2 class={blockTitle}>Code</h2>
          <div class="mt-4 min-w-0">
            <CodeBlock language={data.codeExample.language} snippet={data.codeExample.snippet} />
          </div>
        </section>
      )
    }

    {
      /*
      Erkenntnisse sind die Randnotiz des Werkstattbuchs: Das Label steht ueber
      dem Text, der in voller Tinte statt in Bleistiftgrau laeuft.
    */
    }
    {
      zeigt('learnings') && data.learnings.length > 0 && (
        <section class={block}>
          <h2 class={blockTitle}>Erkenntnisse</h2>
          <ul class="prose-flow m-0 mt-4 max-w-[65ch] list-none space-y-3 p-0 text-fg">
            {data.learnings.map((learning) => (
              <li class="border-b border-border pb-3">{learning}</li>
            ))}
          </ul>
        </section>
      )
    }

    <slot name="after-text" />

    {
      zeigt('pager') && (
        <nav aria-label="Weitere Arbeiten" class="mt-16 border-t border-fg">
          <ul class="m-0 grid list-none grid-cols-2 gap-x-4 p-0 sm:gap-x-8">
            <li class="border-b border-border">
              {prev && (
                <a
                  class="group block py-4 text-fg no-underline"
                  href={href(`/projekte/${prev.id}`)}
                >
                  <span class="flex items-center gap-2 text-sm text-fg-muted">
                    <Arrow
                      direction="left"
                      class="transition-transform group-hover:-translate-x-0.5 motion-reduce:transition-none"
                    />
                    Vorherige Arbeit
                  </span>
                  <span class="row-title mt-1 inline-block font-medium">{prev.data.title}</span>
                </a>
              )}
            </li>
            <li class="border-b border-border text-right">
              {next && (
                <a
                  class="group block py-4 text-fg no-underline"
                  href={href(`/projekte/${next.id}`)}
                >
                  <span class="flex items-center justify-end gap-2 text-sm text-fg-muted">
                    Nächste Arbeit
                    <Arrow class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" />
                  </span>
                  <span class="row-title mt-1 inline-block font-medium">{next.data.title}</span>
                </a>
              )}
            </li>
          </ul>
        </nav>
      )
    }

    {zeigt('inquiry') && <InquiryPrompt class="mt-10" />}
  </article>
</BaseLayout>
