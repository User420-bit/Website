---
/**
 * Der gemeinsame Körper einer Projektseite: Zurück-Link, H1, Summary,
 * Meta-Liste, Links, Screenshots, die vier Textblöcke, Vor/Zurück und die
 * Anfrage-Zeile. `src/pages/projekte/[slug].astro` rendert ihn direkt, oder
 * über die Seitenkomponente des Projekts aus `src/components/projekte/`,
 * die ihn an benannten Stellen erweitert oder Teile ersetzt.
 *
 * Slots, in Seitenreihenfolge:
 * - `hero`: ersetzt Zurück-Link, H1 und Summary. Wer ihn füllt, muss die H1
 *   mit `data.title` selbst setzen; `scripts/verify-build.mjs` prüft genau
 *   eine H1 mit diesem Text.
 * - `stage`: direkt unter der Summary, vor der Meta-Liste (die Bühne).
 * - `after-meta`: nach Meta-Liste und Links, vor den Screenshots.
 * - `before-text`: vor „Worum es geht“.
 * - `after-text`: nach „Erkenntnisse“, vor Vor/Zurück.
 *
 * `hide` blendet Standardteile aus, wenn die Seitenkomponente sie selbst
 * anders zeigt. `articleClass` hängt Klassen an den `<article>`.
 *
 * Übergang von der Kachel (DESIGN.md, Bewegung): Der `<article>` trägt den
 * Namen `projekt-<slug>`, genau ein Element darin markiert mit
 * `data-uebergang` das erste große Bild im ersten Bildschirm, meist die Bühne.
 * Dorthin wächst das Bildfeld der Kachel. Welches es ist, entscheidet die
 * Seiten- oder Szenenkomponente; `scripts/verify-build.mjs` prüft, dass es
 * genau eins gibt.
 *
 * Bewegung (docs/BEWEGUNG_PLAN.md, H): H1 und Summary stehen sofort, die
 * Slots gehören ihren Seiten und Bühnen. Was dieser Körper selbst zeigt,
 * zieht beim Hereinscrollen einmal ein: Meta-Liste, Links, und je Textblock
 * die Haarlinie (zieht von links auf), die Überschrift und der Inhalt,
 * Listenpunkte gestaffelt. Jede Gruppe trägt `data-einzug`, jedes versteckte
 * Element `data-bewegt="projektseite"`; das Skript unten bewegt nur diese.
 */
import ProjectNav from '@/components/ProjectNav.astro'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import Arrow from '@/components/Arrow.astro'
import Button from '@/components/Button.astro'
import CodeBlock from '@/components/CodeBlock.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import MetaList from '@/components/MetaList.astro'
import ScreenshotGallery from '@/components/ScreenshotGallery.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { href, uebergang } from '@/lib/site'

export type Projekt = CollectionEntry<'projekte'>
export type Teil =
  | 'meta'
  | 'links'
  | 'gallery'
  | 'text'
  | 'features'
  | 'engineering'
  | 'code'
  | 'learnings'
  | 'pager'
  | 'inquiry'

export interface Props {
  projekt: Projekt
  prev: Projekt | null
  next: Projekt | null
  hide?: Teil[]
  articleClass?: string
}

const { projekt, prev, next, hide = [], articleClass } = Astro.props
const { Content } = await render(projekt)
const data = projekt.data
const zeigt = (teil: Teil) => !hide.includes(teil)

// Wie auf der Startseite: Überschrift über dem Inhalt, Haarlinie oben.
// `relative` und `mit-linie` tragen die Haarlinie, die beim Hereinscrollen aufzieht.
const block = 'mit-linie relative mt-12 border-t border-border pt-6'
const blockTitle = 'm-0 text-xl font-semibold tracking-tight'
const list = 'prose-flow m-0 max-w-[65ch] list-none space-y-3 p-0 text-fg-muted'
const lists = [
  { teil: 'features' as const, title: 'Funktionen', items: data.features },
  { teil: 'engineering' as const, title: 'Technische Entscheidungen', items: data.engineering },
]
---

<BaseLayout title={`${data.title} – Klartext`} description={data.summary}>
  <article class:list={['pt-6 pb-12 sm:py-16', articleClass]} style={uebergang(projekt.id)}>
    {
      Astro.slots.has('hero') ? (
        <slot name="hero" />
      ) : (
        <>
          <ProjectNav prev={prev} next={next} />

          <h1 class="display mt-4 mb-0 text-4xl font-semibold text-balance sm:mt-6 sm:text-5xl">
            {data.title}
          </h1>
          <p class="prose-flow mt-3 max-w-[65ch] text-base leading-relaxed text-fg-muted sm:mt-5 sm:text-lg">
            {data.summary}
          </p>
        </>
      )
    }

    {/* Erst sagen, worum es geht, dann zeigen, dann die Fakten. */}
    <slot name="stage" />

    {
      zeigt('meta') && (
        <div class="mt-8" data-einzug data-bewegt="projektseite">
          <MetaList
            rows={[
              { label: 'Art', value: data.kind, variant: 'kind' },
              { label: 'Zeitraum', value: data.period, variant: 'numeric' },
              ...(data.status ? [{ label: 'Stand', value: data.status }] : []),
              { label: 'Technik', value: data.techStack.join(' · '), variant: 'mono' },
            ]}
          />
        </div>
      )
    }

    {
      zeigt('links') && (data.live || data.github) && (
        <ul class="mt-6 flex list-none flex-wrap gap-3 p-0" data-einzug data-bewegt="projektseite">
          {data.live && (
            <li>
              <Button href={data.live} external>
                Live ansehen
              </Button>
            </li>
          )}
          {data.github && (
            <li>
              <Button href={data.github} variant="secondary" external>
                Code auf GitHub
              </Button>
            </li>
          )}
        </ul>
      )
    }

    <slot name="after-meta" />

    {/* Erst das Bild, dann der Text: Der Beleg steht vor der Beschreibung. */}
    {zeigt('gallery') && <ScreenshotGallery shots={data.screenshots} title={data.title} />}

    <slot name="before-text" />

    {
      zeigt('text') && (
        <section class={block} data-einzug>
          <span class="haarlinie" aria-hidden="true" data-bewegt="projektseite" />
          <h2 class={blockTitle} data-bewegt="projektseite">
            Worum es geht
          </h2>
          <div
            data-bewegt="projektseite"
            class="prose-flow mt-4 max-w-[65ch] space-y-4 leading-relaxed text-fg-muted [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4"
          >
            <Content />
          </div>
        </section>
      )
    }

    {
      lists.map(
        ({ teil, title, items }) =>
          zeigt(teil) &&
          items.length > 0 && (
            <section class={block} data-einzug="liste">
              <span class="haarlinie" aria-hidden="true" data-bewegt="projektseite" />
              <h2 class={blockTitle} data-bewegt="projektseite">
                {title}
              </h2>
              <ul class:list={[list, 'mt-4']}>
                {items.map((item) => (
                  <li class="border-b border-border pb-3" data-bewegt="projektseite">
                    {item}
                  </li>
                ))}
              </ul>
            </section>
          ),
      )
    }

    {
      zeigt('code') && data.codeExample && (
        <section class={block} data-einzug>
          <span class="haarlinie" aria-hidden="true" data-bewegt="projektseite" />
          <h2 class={blockTitle} data-bewegt="projektseite">
            Code
          </h2>
          <div class="mt-4 min-w-0" data-bewegt="projektseite">
            <CodeBlock language={data.codeExample.language} snippet={data.codeExample.snippet} />
          </div>
        </section>
      )
    }

    {
      /*
      Erkenntnisse sind die Randnotiz des Werkstattbuchs: Das Label steht ueber
      dem Text, der in voller Tinte statt in Bleistiftgrau laeuft.
    */
    }
    {
      zeigt('learnings') && data.learnings.length > 0 && (
        <section class={block} data-einzug="liste">
          <span class="haarlinie" aria-hidden="true" data-bewegt="projektseite" />
          <h2 class={blockTitle} data-bewegt="projektseite">
            Erkenntnisse
          </h2>
          <ul class="prose-flow m-0 mt-4 max-w-[65ch] list-none space-y-3 p-0 text-fg">
            {data.learnings.map((learning) => (
              <li class="border-b border-border pb-3" data-bewegt="projektseite">
                {learning}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <slot name="after-text" />

    {
      zeigt('pager') && (
        <nav aria-label="Weitere Arbeiten" class="mt-16 border-t border-fg">
          <ul class="m-0 grid list-none grid-cols-2 gap-x-4 p-0 sm:gap-x-8">
            <li class="border-b border-border">
              {prev && (
                <a
                  class="group block py-4 text-fg no-underline"
                  href={href(`/projekte/${prev.id}`)}
                >
                  <span class="flex items-center gap-2 text-sm text-fg-muted">
                    <Arrow
                      direction="left"
                      class="transition-transform group-hover:-translate-x-0.5 motion-reduce:transition-none"
                    />
                    Vorherige Arbeit
                  </span>
                  <span class="row-title mt-1 inline-block font-medium">{prev.data.title}</span>
                </a>
              )}
            </li>
            <li class="border-b border-border text-right">
              {next && (
                <a
                  class="group block py-4 text-fg no-underline"
                  href={href(`/projekte/${next.id}`)}
                >
                  <span class="flex items-center justify-end gap-2 text-sm text-fg-muted">
                    Nächste Arbeit
                    <Arrow class="transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none" />
                  </span>
                  <span class="row-title mt-1 inline-block font-medium">{next.data.title}</span>
                </a>
              )}
            </li>
          </ul>
        </nav>
      )
    }

    {zeigt('inquiry') && <InquiryPrompt class="mt-10" />}
  </article>
</BaseLayout>

<style>
  /*
   * Anfangszustände nur mit Skript und erlaubter Bewegung (MotionReady) und
   * nur auf dem Bildschirm: Ein Ausdruck zeigt jeden Block, auch einen, der
   * noch nicht ins Fenster gescrollt wurde.
   */
  @media screen {
    :global(html[data-bewegung]) [data-bewegt='projektseite'] {
      opacity: 0;
      transform: translateY(8px);
    }
    /* Solange die Haarlinie aufzieht, zeichnet sie die Linie, nicht der Rand. */
    :global(html[data-bewegung]) .mit-linie:has(> .haarlinie) {
      border-top-color: transparent;
    }
    :global(html[data-bewegung]) .haarlinie {
      display: block;
    }
    :global(html[data-bewegung]) .haarlinie[data-bewegt='projektseite'] {
      opacity: 1;
      transform: scaleX(0);
    }
  }
  /* Liegt genau auf dem Rand des Blocks; ohne Bewegung gibt es sie nicht. */
  .haarlinie {
    display: none;
    position: absolute;
    top: -1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
    pointer-events: none;
  }
</style>

<script>
  import {
    DAUER,
    KURVE,
    STAFFEL,
    WEG_TEXT,
    alle,
    animate,
    inView,
    stagger,
    wennBewegt,
  } from '@/lib/motion'

  /*
   * Das Sicherheitsnetz in global.css deckt nach 2 s auf. Kommt dieses Modul
   * später an, steht womöglich schon alles; es noch einmal zu verstecken,
   * hieße flackern. Dann bleibt es beim Netz.
   */
  const ZU_SPAET = 1800

  /**
   * Nach dem Einzug bleibt nichts zurück: kein Anfangszustand, kein
   * Inline-Stil, kein Transform (Motion hinterließe `translateY(0px)`). Erst
   * im nächsten Bild, denn Motion schreibt seinen Endwert selbst noch einmal
   * im nächsten Bild.
   */
  const aufraeumen = (teile: HTMLElement[]) =>
    requestAnimationFrame(() => {
      for (const teil of teile) {
        teil.removeAttribute('data-bewegt')
        teil.style.removeProperty('opacity')
        teil.style.removeProperty('transform')
        teil.style.removeProperty('animation')
      }
    })

  wennBewegt(() => {
    if (performance.now() > ZU_SPAET) return
    for (const gruppe of alle('[data-einzug]')) {
      const teile = alle('[data-bewegt="projektseite"]', gruppe)
      if (gruppe.dataset.bewegt === 'projektseite') teile.unshift(gruppe)
      // Das Modul läuft: Das Netz würde Blöcke unter dem Fenster nach 2 s
      // aufdecken und beim Hereinscrollen noch einmal einziehen lassen.
      for (const teil of teile) teil.style.animation = 'none'
      const linien = teile.filter((teil) => teil.classList.contains('haarlinie'))
      const text = teile.filter((teil) => !linien.includes(teil))
      // Blöcke können höher sein als das Fenster; ein Anteil wie 0,2 würde
      // dann nie erreicht. Gezählt wird ab dem Moment, in dem die Oberkante
      // ein Stück ins Fenster gerückt ist.
      inView(
        gruppe,
        () => {
          for (const linie of linien) {
            animate(
              linie,
              { transform: ['scaleX(0)', 'none'] },
              { duration: DAUER.szene, ease: KURVE },
            ).then(() => linie.remove())
          }
          animate(
            text,
            { opacity: [0, 1], transform: [`translateY(${WEG_TEXT}px)`, 'none'] },
            {
              duration: DAUER.langsam,
              ease: KURVE,
              delay: stagger(gruppe.dataset.einzug === 'liste' ? 0.04 : STAFFEL),
            },
          ).then(() => aufraeumen(text))
        },
        { margin: '0px 0px -15% 0px' },
      )
    }
  })
</script>
