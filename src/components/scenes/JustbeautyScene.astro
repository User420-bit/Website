---
/**
 * JustBeauty: zwölf Seiten, ein Takt. Die Blätter tragen die Seitennamen des
 * Entwurfs und stehen als Fächer neben dem Titel, ohne eigene Fläche. Eine
 * Welle läuft durch sie hindurch, jedes Blatt hebt sich einmal, und der Punkt
 * neben „ein Takt“ schlägt zu jedem Blatt: das Master-Timing des Prototyps,
 * sichtbar gemacht.
 *
 * Darunter ein Umschalter, mit dem man die Erkenntnis des Projekts
 * nachprüfen kann. „Zwölf Takte“ gibt jedem Blatt eigene Dauer, Kurve und
 * Verzögerung, einzeln lauter vernünftige Werte, zusammen unruhig.
 * „Anhalten“ stellt jede Bewegung der Seite still. Alles ohne JavaScript:
 * Radio-Buttons, `:has()`, eine animierte Variable.
 *
 * Takt, Kurve und Farben kommen von der Seite (`.jb-seite` in
 * JustbeautyPage.astro), damit es sie genau einmal gibt. Ohne Bewegung
 * (reduzierte Bewegung, kein `:has()`) steht der Fächer offen, und der
 * Umschalter fehlt, weil er dann nichts schalten könnte.
 */

/** Ein Rechteck im Schema eines Blatts, Raster 40 × 30: Feld, `r` Rosé, `o` Umriss. */
type Form = [x: number, y: number, w: number, h: number, art?: 'r' | 'o']

/**
 * Die zwölf Seiten aus der Projektdatei, jede mit einem Schema ihrer Art.
 * Die Schemata sind gezeichnet, nicht abgenommen: So sieht die Seitenart aus,
 * nicht der Entwurf.
 */
const seiten: { name: string; form: Form[] }[] = [
  {
    name: 'Shop',
    form: [
      [0, 0, 40, 12, 'r'],
      [0, 15, 12, 9],
      [14, 15, 12, 9],
      [28, 15, 12, 9],
      [0, 27, 22, 2],
    ],
  },
  {
    name: 'Kategorien',
    form: [
      [0, 0, 19, 13],
      [21, 0, 19, 13, 'r'],
      [0, 16, 19, 13],
      [21, 16, 19, 13],
    ],
  },
  {
    name: 'Produkt',
    form: [
      [0, 0, 18, 29, 'r'],
      [22, 1, 18, 3],
      [22, 8, 12, 2],
      [22, 12, 15, 2],
      [22, 22, 18, 7],
    ],
  },
  {
    name: 'Bestseller',
    form: [
      [0, 0, 7, 7, 'r'],
      [10, 2, 30, 3],
      [0, 11, 7, 7],
      [10, 13, 24, 3],
      [0, 22, 7, 7],
      [10, 24, 18, 3],
    ],
  },
  {
    name: 'Routinen',
    form: [
      [0, 0, 7, 7, 'r'],
      [10, 2, 26, 2],
      [3, 7, 1, 4],
      [0, 11, 7, 7, 'o'],
      [10, 13, 20, 2],
      [3, 18, 1, 4],
      [0, 22, 7, 7, 'o'],
      [10, 24, 24, 2],
    ],
  },
  {
    name: 'Beratung',
    form: [
      [0, 0, 26, 8],
      [14, 11, 26, 8, 'r'],
      [0, 22, 20, 7],
    ],
  },
  {
    name: 'Händler',
    form: [
      [0.5, 0.5, 39, 19, 'o'],
      [8, 6, 3, 3, 'r'],
      [23, 11, 3, 3, 'r'],
      [31, 4, 3, 3, 'r'],
      [0, 24, 28, 2],
      [0, 28, 18, 1],
    ],
  },
  {
    name: 'Über uns',
    form: [
      [0, 0, 40, 13],
      [0, 17, 40, 2],
      [0, 21, 34, 2],
      [0, 25, 38, 2, 'r'],
    ],
  },
  {
    name: 'Prämien',
    form: [
      [0, 3, 40, 4],
      [0, 3, 26, 4, 'r'],
      [0.5, 14.5, 11, 14, 'o'],
      [14.5, 14.5, 11, 14, 'o'],
      [28, 14, 12, 15, 'r'],
    ],
  },
  {
    name: 'Kontakt',
    form: [
      [0.5, 0.5, 39, 6, 'o'],
      [0.5, 9.5, 39, 10, 'o'],
      [0, 23, 16, 6, 'r'],
    ],
  },
  {
    name: 'Suche',
    form: [
      [0.5, 0.5, 39, 7, 'o'],
      [34, 2, 4, 4, 'r'],
      [0, 12, 7, 7],
      [10, 14, 26, 2],
      [0, 22, 7, 7],
      [10, 24, 20, 2],
    ],
  },
  {
    name: 'Warenkorb',
    form: [
      [0, 0, 7, 7],
      [10, 2, 22, 2],
      [0, 9, 7, 7],
      [10, 11, 16, 2],
      [0, 19, 40, 1],
      [22, 21, 18, 2],
      [0, 25, 40, 5, 'r'],
    ],
  },
]

/**
 * Nur für „Zwölf Takte“: je Blatt eine Dauer, eine Kurve, eine Verzögerung.
 * Jede für sich wäre eine gute Animation.
 */
const eigen = [
  ['2.3s', 'ease-in', '-0.4s'],
  ['1.2s', 'linear', '-1.1s'],
  ['3.1s', 'cubic-bezier(0.68, -0.6, 0.32, 1.6)', '0s'],
  ['1.7s', 'steps(3)', '-2.2s'],
  ['2.8s', 'ease-out', '-0.5s'],
  ['1.1s', 'cubic-bezier(0.9, 0, 0.1, 1)', '-0.9s'],
  ['3.6s', 'ease', '-0.1s'],
  ['1.5s', 'cubic-bezier(0.3, 1.8, 0.6, 1)', '-0.6s'],
  ['2.1s', 'steps(5)', '-1.4s'],
  ['3.9s', 'ease-in-out', '-0.2s'],
  ['1.3s', 'cubic-bezier(0.1, 0.7, 0.3, 1)', '-0.3s'],
  ['2.6s', 'linear', '-1.7s'],
]

const modi = [
  {
    id: 'eins',
    label: 'Ein Takt',
    satz: 'Alle Blätter hängen an einer Zeitbasis, wie jede Bewegung im Prototyp.',
  },
  {
    id: 'zwoelf',
    label: 'Zwölf Takte',
    satz: 'Jedes Blatt mit eigener Dauer und Kurve: einzeln gut, zusammen unruhig.',
  },
  { id: 'aus', label: 'Anhalten', satz: 'Nichts auf dieser Seite bewegt sich mehr.' },
]
---

<figure class="jb-figur m-0" id="takt">
  <div class="jb-faecher" aria-hidden="true">
    <ol class="jb-blaetter">
      {
        seiten.map((seite, i) => (
          <li
            class="jb-blatt"
            style={`--i: ${i}; --d: ${eigen[i][0]}; --k: ${eigen[i][1]}; --v: ${eigen[i][2]}`}
          >
            <span class="jb-name">{seite.name}</span>
            <svg class="jb-form" viewBox="0 0 40 30">
              {seite.form.map(([x, y, w, h, art]) => (
                <rect x={x} y={y} width={w} height={h} class={art && `jb-${art}`} />
              ))}
            </svg>
          </li>
        ))
      }
    </ol>
    {seiten.map((_, i) => <span class="jb-strich" style={`--i: ${i}`} />)}
    <p class="jb-notiz">
      12 Seiten · 315 Produkte <span class="jb-puls"></span> ein Takt
    </p>
  </div>

  <fieldset class="jb-takt m-0 mt-6 min-w-0 border-0 p-0">
    <legend class="sr-only">Takt der Bewegung auf dieser Seite</legend>
    <div class="flex flex-wrap gap-x-6 border-b border-border">
      {
        modi.map((modus, i) => (
          <label class="jb-reiter relative inline-flex cursor-pointer items-baseline rounded-sm py-2.5 text-sm font-medium text-fg-muted transition-colors hover:text-fg has-checked:text-fg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent motion-reduce:transition-none">
            <input
              class="sr-only"
              type="radio"
              name="jb-takt"
              id={`jb-takt-${modus.id}`}
              value={modus.id}
              checked={i === 0}
              aria-describedby={`jb-satz-${modus.id}`}
            />
            {modus.label}
          </label>
        ))
      }
    </div>
    {
      modi.map((modus) => (
        <p class="jb-satz m-0 mt-3 text-sm text-fg-muted" id={`jb-satz-${modus.id}`}>
          {modus.satz}
        </p>
      ))
    }
  </fieldset>

  <figcaption class="mt-4 text-sm text-fg-muted">
    <span class="font-medium text-fg">Szene</span> · Die zwölf Seiten des Entwurfs als Fächer, jede als
    Schema ihrer Art gezeichnet. Kein Screenshot.
  </figcaption>
</figure>

<style>
  @property --jb-auf {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }
  @property --jb-hub {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  /*
   * Maße des Fächers: Blattbreite und -höhe, Abstand vom Drehpunkt zur
   * Blattunterkante, Winkel zwischen zwei Blättern, Hub der Welle. Der
   * Drehpunkt liegt mittig an der Unterkante, auf der Notiz.
   */
  .jb-faecher {
    --jb-b: 5.25rem;
    --jb-h: 7rem;
    --jb-r: 5rem;
    --jb-w: 6.5deg;
    --jb-hoch: 1.5rem;
    position: relative;
    height: calc(var(--jb-r) + var(--jb-h) + var(--jb-hoch) + 0.75rem);
    color: var(--jb-tinte);
  }
  @media (min-width: 640px) {
    .jb-faecher {
      --jb-b: 6.5rem;
      --jb-h: 8.5rem;
      --jb-r: 6rem;
      --jb-w: 7deg;
      --jb-hoch: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .jb-faecher {
      --jb-b: 7rem;
      --jb-h: 9.25rem;
      --jb-r: 6.5rem;
    }
  }

  .jb-blaetter {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Alle Blätter drehen um denselben Punkt. `--jb-auf` spreizt den Fächer
   * (0 geschlossen, 1 offen), `--jb-hub` hebt ein Blatt entlang seiner eigenen
   * Achse aus dem Fächer.
   */
  .jb-blatt {
    position: absolute;
    left: 50%;
    bottom: var(--jb-r);
    width: var(--jb-b);
    height: var(--jb-h);
    margin-left: calc(var(--jb-b) / -2);
    padding: 0.4rem 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--jb-papier);
    border: 1px solid var(--jb-linie);
    border-top: 2px solid var(--jb-rose);
    border-radius: var(--radius-sm);
    transform-origin: 50% calc(100% + var(--jb-r));
    transform: rotate(calc((var(--i) - 5.5) * var(--jb-w) * var(--jb-auf)))
      translateY(var(--jb-hub));
  }
  .jb-name {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .jb-name {
      font-size: 0.8125rem;
    }
  }
  .jb-form {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: var(--jb-feld);
  }
  .jb-form .jb-r {
    fill: var(--jb-rose-zart);
  }
  .jb-form .jb-o {
    fill: none;
    stroke: var(--jb-linie);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Die Skala unter dem Fächer: ein Strich je Blatt, auf demselben Winkel. */
  .jb-strich {
    position: absolute;
    left: 50%;
    bottom: calc(var(--jb-r) - 1.25rem);
    width: 1px;
    height: 0.5rem;
    background: var(--jb-rose);
    transform-origin: 50% calc(100% + var(--jb-r) - 1.25rem);
    transform: rotate(calc((var(--i) - 5.5) * var(--jb-w) * var(--jb-auf)));
  }

  .jb-notiz {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    margin: 0;
    text-align: center;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--jb-tinte);
  }
  /* Der Punkt trennt „ein Takt“ ab und schlägt ihn; Form und Schlag stehen auf der Seite. */
  .jb-notiz :global(.jb-puls) {
    margin-inline: 0.1rem;
    vertical-align: 0.1em;
  }

  /* Der gewählte Reiter trägt einen Strich in Rosé auf der Haarlinie. */
  .jb-reiter::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    background: var(--jb-rose);
    transform: scaleX(0);
    transform-origin: left;
  }
  .jb-reiter:has(:checked)::after {
    transform: scaleX(1);
  }

  /* Ohne Bewegung schaltet der Umschalter nichts, also fehlt er. */
  .jb-takt,
  .jb-satz {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .jb-faecher {
      animation: jb-oeffnen calc(2 * var(--jb-takt)) var(--jb-kurve) both;
    }

    @supports selector(:has(*)) {
      .jb-takt {
        display: block;
      }
      .jb-figur:has(#jb-takt-eins:checked) #jb-satz-eins,
      .jb-figur:has(#jb-takt-zwoelf:checked) #jb-satz-zwoelf,
      .jb-figur:has(#jb-takt-aus:checked) #jb-satz-aus {
        display: block;
      }
      .jb-reiter::after {
        transition: transform var(--jb-takt) var(--jb-kurve);
      }

      /*
       * Ein Takt: Jedes Blatt hebt sich einen Takt lang und senkt sich einen
       * Takt lang, das nächste folgt einen Takt später. Zwölf Blätter, zwölf
       * Takte je Runde. Der Punkt schlägt dazu (JustbeautyPage.astro).
       */
      .jb-blatt {
        animation-name: jb-welle;
        animation-duration: calc(12 * var(--jb-takt));
        animation-timing-function: var(--jb-kurve);
        animation-delay: calc((var(--i) + 2) * var(--jb-takt));
        animation-iteration-count: infinite;
      }

      /* Zwölf Takte: dieselbe Bewegung, aber jedes Blatt mit eigener Zeit. */
      .jb-figur:has(#jb-takt-zwoelf:checked) .jb-blatt {
        animation-duration: var(--d);
        animation-timing-function: var(--k);
        animation-delay: var(--v);
      }
      .jb-figur:has(#jb-takt-aus:checked) .jb-blatt {
        animation-name: none;
      }
    }
  }

  @keyframes jb-oeffnen {
    from {
      --jb-auf: 0.15;
    }
    to {
      --jb-auf: 1;
    }
  }
  @keyframes jb-welle {
    0%,
    16.667%,
    100% {
      --jb-hub: 0px;
    }
    8.333% {
      --jb-hub: calc(-1 * var(--jb-hoch));
    }
  }
</style>
