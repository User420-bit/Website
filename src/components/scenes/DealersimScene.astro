---
/**
 * DealerSim: der erste Raum, zum Anfassen. Keine Fläche, kein Band: Der Raum
 * steht als isometrische Pixel-Insel neben dem Titel, so wie das Spiel ihn
 * zeigt, mit Wänden, Kachelboden, drei Stationen, einem Band und einer
 * Person. Oben links die Anzeige des Spiels mit Level und Zähler.
 *
 * Ohne Skript läuft die Produktion still weiter: Die Ware fährt, und ein
 * Zähler über `@property` zählt seit dem Aufruf mit, denn das Spiel läuft
 * auch, wenn niemand spielt. Mit Skript lassen sich die Stationen ausbauen
 * (Klick, Enter oder Leertaste): Die Stufe steigt, die Produktion wird
 * schneller, das Level steigt mit den Stück, und der Raum füllt sich mit
 * Zelten, Personal und Einrichtung. Nichts wird gespeichert.
 *
 * Alles liegt auf dem Pixelraster aus `dealersim/pixel.ts` und wird nur in
 * ganzen Vielfachen skaliert (×3 auf dem Handy, ×4 darüber).
 */
import {
  BILDSCHIRM,
  GESTELL,
  KACHEL_B,
  KACHEL_H,
  LAMPE,
  PERSON,
  PFLANZE,
  TISCH,
  ZELT,
  raute,
  sprite,
  treppe,
} from './dealersim/pixel'

// Raster: 6 × 6 Kacheln, obere Spitze des Bodens bei (OX, OY).
const B = 112
const H = 84
const OX = 56
const OY = 30
const N = 6
const WAND = 26
const spitze = (cx: number, cy: number) => ({
  x: OX + ((cx - cy) * KACHEL_B) / 2,
  y: OY + ((cx + cy) * KACHEL_H) / 2,
})
const mitte = (cx: number, cy: number) => {
  const { x, y } = spitze(cx, cy)
  return { x, y: y + KACHEL_H / 2 }
}

const links = spitze(0, N)
const oben = spitze(0, 0)
const rechts = spitze(N, 0)
const unten = spitze(N, N)

const wand = {
  links: treppe([
    [links.x, links.y],
    [oben.x, oben.y],
    [oben.x, oben.y - WAND],
    [links.x, links.y - WAND],
  ]),
  rechts: treppe([
    [oben.x, oben.y],
    [rechts.x, rechts.y],
    [rechts.x, rechts.y - WAND],
    [oben.x, oben.y - WAND],
  ]),
  kanteLinks: treppe([
    [links.x, links.y - WAND],
    [oben.x, oben.y - WAND],
    [oben.x, oben.y - WAND + 2],
    [links.x, links.y - WAND + 2],
  ]),
  kanteRechts: treppe([
    [oben.x, oben.y - WAND],
    [rechts.x, rechts.y - WAND],
    [rechts.x, rechts.y - WAND + 2],
    [oben.x, oben.y - WAND + 2],
  ]),
}
// Fugen: senkrechte Paneele in beiden Wänden, alle acht Pixel, wie im Spiel.
const fugen = [8, 16, 24, 32, 40]
  .flatMap((d) => [
    { x: links.x + d, y: links.y - WAND + 2 - d / 2 },
    { x: rechts.x - d - 1, y: rechts.y - WAND + 2 - d / 2 },
  ])
  .map(({ x, y }) => `M${x} ${Math.ceil(y)}h1v${WAND - 2}h-1z`)
  .join('')
const sockel = {
  links: treppe([
    [links.x, links.y],
    [unten.x, unten.y],
    [unten.x, unten.y + 3],
    [links.x, links.y + 3],
  ]),
  rechts: treppe([
    [unten.x, unten.y],
    [rechts.x, rechts.y],
    [rechts.x, rechts.y + 3],
    [unten.x, unten.y + 3],
  ]),
}
const boden = treppe([
  [links.x, links.y],
  [oben.x, oben.y],
  [rechts.x, rechts.y],
  [unten.x, unten.y],
])
const karo = Array.from({ length: N * N }, (_, i) => [i % N, Math.floor(i / N)] as const)
  .filter(([cx, cy]) => (cx + cy) % 2 === 1)
  .map(([cx, cy]) => {
    const { x, y } = spitze(cx, cy)
    return treppe(raute(x, y))
  })
  .join('')

// Das Band läuft eine Kachel vor den Stationen, von Anbau bis Verkauf.
const bandA = mitte(1, 2)
const bandB = mitte(5, 2)
const band = treppe([
  [bandA.x + 4, bandA.y - 2],
  [bandB.x + 4, bandB.y - 2],
  [bandB.x - 4, bandB.y + 2],
  [bandA.x - 4, bandA.y + 2],
])
const bandKante = treppe([
  [bandA.x - 4, bandA.y + 2],
  [bandB.x - 4, bandB.y + 2],
  [bandB.x - 4, bandB.y + 3],
  [bandA.x - 4, bandA.y + 3],
])
const WARE = ['.oo.', 'oooo', 'OOOO']
const ware = sprite(WARE, bandA.x - 2, bandA.y - 2)
const weg = { x: bandB.x - bandA.x, y: bandB.y - bandA.y }

type Raster = readonly string[]
interface Figur {
  raster: Raster
  cx: number
  cy: number
  /** Station, die sich ausbauen lässt. */
  station?: { id: string; name: string }
  /** Erscheint ab dieser Summe der Stufen (Start: 3, voll ausgebaut: 30). */
  ab?: number
  person?: boolean
}
const figuren: Figur[] = [
  { raster: ZELT, cx: 1, cy: 1, station: { id: 'anbau', name: 'Anbau' } },
  { raster: GESTELL, cx: 3, cy: 1, station: { id: 'verarbeitung', name: 'Verarbeitung' } },
  { raster: TISCH, cx: 5, cy: 1, station: { id: 'verkauf', name: 'Verkauf' } },
  { raster: PERSON, cx: 3, cy: 3, person: true },
  { raster: PFLANZE, cx: 0, cy: 5, ab: 5 },
  { raster: PERSON, cx: 1, cy: 4, ab: 8, person: true },
  { raster: ZELT, cx: 0, cy: 2, ab: 11 },
  { raster: ZELT, cx: 0, cy: 4, ab: 14 },
  { raster: LAMPE, cx: 5, cy: 5, ab: 17 },
  { raster: PERSON, cx: 5, cy: 3, ab: 21, person: true },
  { raster: PFLANZE, cx: 6, cy: 0, ab: 25 },
  { raster: BILDSCHIRM, cx: 3, cy: 5, ab: 30 },
]
const gesetzt = figuren.map((f, i) => {
  const { x, y } = mitte(f.cx, f.cy)
  const breite = f.raster[0].length
  const x0 = x - breite / 2
  const y0 = y + 2 - f.raster.length
  return { ...f, i, x0, y0, x, pfade: sprite(f.raster, x0, y0) }
})
// Maler-Reihenfolge: hinten zuerst. Was vor dem Band steht, kommt nach dem Band.
const hinten = gesetzt.filter((f) => f.cy < 2).sort((a, b) => a.cx + a.cy - (b.cx + b.cy))
const vorn = gesetzt.filter((f) => f.cy >= 2).sort((a, b) => a.cx + a.cy - (b.cx + b.cy))
const stationen = gesetzt.filter((f) => f.station)

const prozent = (wert: number, von: number) => `${((wert / von) * 100).toFixed(3)}%`
---

<figure class="ds-raum m-0" data-ds-raum data-uebergang>
  <div class="ds-bild">
    <svg viewBox={`0 0 ${B} ${H}`} aria-hidden="true">
      <path class="wand-l" d={wand.links}></path>
      <path class="wand-r" d={wand.rechts}></path>
      <path class="fuge" d={fugen}></path>
      <path class="kante" d={wand.kanteLinks + wand.kanteRechts}></path>
      <path class="sockel-l" d={sockel.links}></path>
      <path class="sockel-r" d={sockel.rechts}></path>
      <path class="boden" d={boden}></path>
      <path class="karo" d={karo}></path>
      {
        hinten.map((f) => (
          <g
            class:list={['figur', f.ab && 'extra', f.person && 'person']}
            data-ab={f.ab}
            data-sprite={f.station?.id}
            style={`--i: ${f.i}`}
          >
            {f.pfade.map(({ farbe, d }) => (
              <path class={`f-${farbe}`} d={d} />
            ))}
          </g>
        ))
      }
      <path class="band-kante" d={bandKante}></path>
      <path class="band" d={band}></path>
      {
        [0, 1, 2, 3].map((i) => (
          <g class="ware" style={`--i: ${i}; --wx: ${weg.x}px; --wy: ${weg.y}px`}>
            {ware.map(({ farbe, d }) => (
              <path class={`f-${farbe}`} d={d} />
            ))}
          </g>
        ))
      }
      {
        vorn.map((f) => (
          <g
            class:list={['figur', f.ab && 'extra', f.person && 'person']}
            data-ab={f.ab}
            style={`--i: ${f.i}`}
          >
            {f.pfade.map(({ farbe, d }) => (
              <path class={`f-${farbe}`} d={d} />
            ))}
          </g>
        ))
      }
    </svg>

    <p class="hud" aria-hidden="true">
      <span class="hud-zeile">
        <span class="hud-lv">LV <span data-lv>1</span></span>
        <span class="hud-balken" data-xp></span>
      </span>
      <span class="hud-zeile">
        <span class="hud-klein"></span>
        <span class="hud-zahl" data-stueck></span>
      </span>
      <span class="hud-zeile hud-weg" data-weg hidden></span>
    </p>

    {
      /* Ohne Skript sind die Schilder nur Beschriftung: `inert` nimmt sie aus Fokus und Vorlesen. */
    }
    <div class="schilder" data-schilder inert>
      {
        stationen.map((f, n) => (
          <button
            type="button"
            class="schild"
            data-station={f.station!.id}
            data-name={f.station!.name}
            style={`left: ${prozent(f.x0, B)}; top: ${prozent(f.y0 - 1, H)}`}
          >
            <span class="schild-flaeche">
              <span class="schild-name">
                {n + 1}. {f.station!.name}
              </span>
              <span class="sr-only"> ausbauen, jetzt Stufe </span>
              <span class="sr-only" data-sr>
                1
              </span>
              <span class="schild-stufe" aria-hidden="true" data-stufe>
                L1
              </span>
            </span>
            <span class="schild-takt" aria-hidden="true" />
          </button>
        ))
      }
    </div>
  </div>
  <p class="sr-only" role="status" data-meldung></p>
  <figcaption class="mt-3 max-w-[65ch] text-sm text-fg-muted">
    <span class="font-medium text-fg">Szene</span> · Der erste Raum, nachgezeichnet. Er produziert weiter,
    auch wenn niemand spielt.<span data-hinweis hidden
      >{' '}Ein Klick auf eine Station baut sie aus.</span
    >{' '}
    Kein Screenshot.
  </figcaption>
</figure>

<script>
  const raum = document.querySelector<HTMLElement>('[data-ds-raum]')
  if (raum) {
    const $ = <T extends Element = HTMLElement>(s: string) => raum.querySelector(s) as T
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const knoepfe = [...raum.querySelectorAll<HTMLButtonElement>('[data-station]')]
    const stufe: Record<string, number> = {}
    for (const k of knoepfe) stufe[k.dataset.station!] = 1
    const summe = () => Object.values(stufe).reduce((a, b) => a + b, 0)
    // Stück je Sekunde: 0,5 auf Stufe 1 wie der CSS-Zähler, 5 voll ausgebaut.
    const rate = () => summe() / 6
    let stueck = performance.now() / 2000
    let zuletzt = performance.now()
    let wegSeit = 0
    let level = 1

    const takt = () => {
      const jetzt = performance.now()
      stueck += (rate() * (jetzt - zuletzt)) / 1000
      zuletzt = jetzt
    }
    const zeigen = () => {
      const n = Math.floor(stueck)
      // Level L braucht 10 · L Stück bis zum nächsten.
      let lv = 1
      let rest = n
      while (rest >= lv * 10) rest -= lv++ * 10
      $('[data-stueck]').textContent = `×${n}`
      $('[data-lv]').textContent = String(lv)
      if (lv > level)
        $('.hud-lv').animate([{ color: 'var(--ds-stufe)' }, { color: 'inherit' }], {
          duration: 900,
          easing: 'steps(3)',
        })
      level = lv
      $('[data-xp]').style.setProperty('--xp', String(rest / (lv * 10)))
    }
    const melden = (text: string) => ($('[data-meldung]').textContent = text)

    $('[data-schilder]').inert = false
    $('[data-hinweis]').hidden = false
    if (!still) {
      raum.dataset.live = ''
      zeigen()
      setInterval(() => {
        takt()
        zeigen()
      }, 250)
      // Offline-Produktion wie im Spiel: Was im Hintergrund lief, steht kurz da.
      document.addEventListener('visibilitychange', () => {
        takt()
        if (document.hidden) {
          wegSeit = stueck
          return
        }
        const plus = Math.floor(stueck - wegSeit)
        const feld = $('[data-weg]')
        if (plus < 5) return
        feld.textContent = `+${plus} im Hintergrund`
        feld.hidden = false
        setTimeout(() => (feld.hidden = true), 8000)
      })
    }

    for (const k of knoepfe) {
      k.addEventListener('click', () => {
        const id = k.dataset.station!
        const name = k.dataset.name
        if (stufe[id] >= 10) return melden(`${name} ist voll ausgebaut.`)
        takt()
        stufe[id]++
        k.querySelector('[data-stufe]')!.textContent = `L${stufe[id]}`
        k.querySelector('[data-sr]')!.textContent = String(stufe[id])
        k.style.setProperty('--stufe', String(stufe[id]))
        if (stufe[id] === 10) k.setAttribute('aria-disabled', 'true')
        raum.style.setProperty('--tempo', String(summe() / 3))
        for (const e of raum.querySelectorAll('[data-ab]'))
          e.classList.toggle('da', summe() >= Number(e.getAttribute('data-ab')))
        melden(
          `${name} auf Stufe ${stufe[id]}.${summe() === 30 ? ' Der Raum ist voll ausgebaut.' : ''}`,
        )
        if (summe() === 30)
          $('[data-hinweis]').textContent =
            ' Voll ausgebaut. Wie ein Raum auf Level 41 aussieht, zeigt das erste Bild darunter.'
        if (!still)
          raum
            .querySelector(`[data-sprite="${id}"]`)
            ?.animate([{ transform: 'translateY(-2px)' }, { transform: 'none' }], {
              duration: 240,
              easing: 'steps(2)',
            })
      })
    }
  }
</script>

<style>
  @property --ds-stueck {
    syntax: '<integer>';
    inherits: true;
    initial-value: 0;
  }

  /*
   * Farben nur für diese Szene. Boden und Wände haben einen Zwilling für den
   * Dunkelmodus; die Figuren sind Pixelgrafik mit eigener Kontur und bleiben in
   * beiden Modi gleich, wie ein Sprite auf jedem Hintergrund.
   */
  .ds-raum {
    --ds-wand-l: oklch(0.62 0.045 285);
    --ds-wand-r: oklch(0.56 0.05 285);
    --ds-kante: oklch(0.74 0.035 285);
    --ds-fuge: oklch(0.53 0.05 285);
    --ds-boden: oklch(0.76 0.07 72);
    --ds-karo: oklch(0.69 0.08 66);
    --ds-sockel-l: oklch(0.55 0.07 60);
    --ds-sockel-r: oklch(0.48 0.065 58);
    --ds-band: oklch(0.42 0.02 270);
    --ds-band-kante: oklch(0.32 0.02 270);
    --ds-hud: oklch(0.25 0.03 280);
    --ds-hud-rand: oklch(0.46 0.05 280);
    --ds-hud-text: oklch(0.95 0.01 280);
    --ds-hud-leise: oklch(0.74 0.03 280);
    --ds-xp: oklch(0.8 0.11 200);
    --ds-stufe: oklch(0.88 0.14 95);
    --ds-schild: oklch(0.3 0.045 215);
    --ds-schild-rand: oklch(0.72 0.1 200);
    --ds-schild-text: oklch(0.93 0.05 200);
    --ds-stueck: 0;
    --tempo: 1;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .ds-raum {
      --ds-wand-l: oklch(0.37 0.06 282);
      --ds-wand-r: oklch(0.32 0.055 282);
      --ds-kante: oklch(0.47 0.05 282);
      --ds-fuge: oklch(0.29 0.05 282);
      --ds-boden: oklch(0.55 0.075 68);
      --ds-karo: oklch(0.46 0.07 62);
      --ds-sockel-l: oklch(0.36 0.05 58);
      --ds-sockel-r: oklch(0.31 0.045 56);
    }
  }
  :root[data-theme='dark'] .ds-raum {
    --ds-wand-l: oklch(0.37 0.06 282);
    --ds-wand-r: oklch(0.32 0.055 282);
    --ds-kante: oklch(0.47 0.05 282);
    --ds-fuge: oklch(0.29 0.05 282);
    --ds-boden: oklch(0.55 0.075 68);
    --ds-karo: oklch(0.46 0.07 62);
    --ds-sockel-l: oklch(0.36 0.05 58);
    --ds-sockel-r: oklch(0.31 0.045 56);
  }

  /* Ganze Vielfache des Pixelrasters (112 × 84), damit jedes Pixel gleich groß ist. */
  .ds-bild {
    position: relative;
    width: min(100%, 336px);
    aspect-ratio: 112 / 84;
  }
  @media (min-width: 640px) {
    .ds-bild {
      width: 448px;
    }
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    shape-rendering: crispEdges;
  }

  .wand-l {
    fill: var(--ds-wand-l);
  }
  .wand-r {
    fill: var(--ds-wand-r);
  }
  .kante {
    fill: var(--ds-kante);
  }
  .fuge {
    fill: var(--ds-fuge);
  }
  .boden {
    fill: var(--ds-boden);
  }
  .karo {
    fill: var(--ds-karo);
  }
  .sockel-l {
    fill: var(--ds-sockel-l);
  }
  .sockel-r {
    fill: var(--ds-sockel-r);
  }
  .band {
    fill: var(--ds-band);
  }
  .band-kante {
    fill: var(--ds-band-kante);
  }

  .f-k {
    fill: oklch(0.23 0.03 280);
  }
  .f-m {
    fill: oklch(0.74 0.02 270);
  }
  .f-M {
    fill: oklch(0.52 0.03 270);
  }
  .f-d {
    fill: oklch(0.31 0.03 270);
  }
  .f-g {
    fill: oklch(0.74 0.17 140);
  }
  .f-G {
    fill: oklch(0.54 0.13 145);
  }
  .f-y {
    fill: oklch(0.93 0.1 95);
  }
  .f-w {
    fill: oklch(0.62 0.09 60);
  }
  .f-W {
    fill: oklch(0.46 0.07 55);
  }
  .f-p {
    fill: oklch(0.66 0.15 300);
  }
  .f-P {
    fill: oklch(0.52 0.14 300);
  }
  .f-o {
    fill: oklch(0.78 0.15 62);
  }
  .f-O {
    fill: oklch(0.64 0.17 45);
  }
  .f-b {
    fill: oklch(0.62 0.17 265);
  }
  .f-n {
    fill: oklch(0.33 0.07 270);
  }
  .f-s {
    fill: oklch(0.82 0.08 55);
  }
  .f-h {
    fill: oklch(0.36 0.05 50);
  }
  .f-t {
    fill: oklch(0.8 0.1 200);
  }

  .extra:not(.da) {
    display: none;
  }

  /* Die Ware steht ohne Bewegung verteilt auf dem Band. */
  .ware {
    transform: translate(calc(var(--wx) * var(--i) / 4), calc(var(--wy) * var(--i) / 4));
  }

  /* Anzeige oben links, wie die Leiste im Spiel. */
  .hud {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    display: grid;
    gap: 0.125rem;
    padding: 0.375rem 0.5rem;
    background-color: var(--ds-hud);
    color: var(--ds-hud-text);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    clip-path: var(--ds-pixelecke);
    border: 2px solid var(--ds-hud-rand);
  }
  .hud-zeile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .hud-zeile[hidden] {
    display: none;
  }
  .hud-lv {
    white-space: nowrap;
  }
  .hud-klein,
  .hud-weg {
    color: var(--ds-hud-leise);
    font-weight: 500;
  }
  .hud-balken {
    --xp: 0.3;
    width: 3.5rem;
    height: 0.375rem;
    background:
      linear-gradient(var(--ds-xp) 0 0) left / calc(var(--xp) * 100%) 100% no-repeat,
      var(--ds-hud-rand);
  }
  /* Ohne Zähler steht, was immer stimmt; mit Zähler, wie viel seit dem Aufruf verpackt wurde. */
  .hud-klein::before {
    content: 'Produktion';
  }
  .hud-zahl::after {
    content: 'läuft';
  }

  /* Stationsschilder, links an der Figur angeschlagen wie im Spiel. */
  .schilder {
    position: absolute;
    inset: 0;
  }
  .schild {
    position: absolute;
    translate: 0 -100%;
    display: grid;
    gap: 2px;
    min-height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }
  .schilder[inert] .schild {
    cursor: default;
  }
  .schild:focus-visible {
    border-radius: 0;
  }
  .schild-flaeche {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.375rem;
    border: 1px solid var(--ds-schild-rand);
    background-color: var(--ds-schild);
    color: var(--ds-schild-text);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    clip-path: var(--ds-pixelecke-1);
  }
  .schild:not([aria-disabled]):hover .schild-flaeche {
    background-color: var(--ds-schild-rand);
    color: var(--ds-schild);
  }
  .schild-stufe {
