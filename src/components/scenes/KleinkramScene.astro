---
/**
 * Kleinkram: ein Kassenzettel auf dem Schreibtisch. Beispieldaten in
 * Tabellenziffern, unten der Stand zur Kleinunternehmergrenze (§ 19 UStG),
 * der sich beim Scrollen füllt. Die Zackenkante unten ist ein `clip-path`.
 * Alle Zahlen sind erfunden; die Bildunterschrift sagt das.
 */
import ProjectScene from '@/components/ProjectScene.astro'

const posten = [
  { label: 'Rechnung 2026-031', wert: '1.190,00' },
  { label: 'Rechnung 2026-030', wert: '640,00' },
  { label: 'Angebot 2026-012', wert: 'offen' },
  { label: 'Zeiten KW 38', wert: '12,5 h' },
]
const summen = [
  { label: 'Einnahmen', wert: '14.280,00' },
  { label: 'Ausgaben', wert: '3.110,00' },
  { label: 'Gewinn', wert: '11.170,00', stark: true },
]

// Zackenkante: 14 Zacken über die Breite, je 0,4rem hoch, von rechts nach links
// gezeichnet, damit der Pfad die Fläche umläuft statt sie zu kreuzen.
const zacken = Array.from({ length: 29 }, (_, i) => {
  const x = 100 - (i / 28) * 100
  const y = i % 2 === 0 ? '100%' : 'calc(100% - 0.4rem)'
  return `${x.toFixed(2)}% ${y}`
}).join(', ')
---

<ProjectScene
  caption="Ein Kassenzettel mit Beispieldaten, wie ihn die Übersicht zusammenrechnet, unten der Stand zur Kleinunternehmergrenze, der sich beim Scrollen füllt."
  surface="oklch(0.9 0.012 80)"
  surfaceDark="oklch(0.22 0.006 80)"
>
  <div class="tisch">
    <div class="zettel" style={`clip-path: polygon(0 0, 100% 0, ${zacken})`}>
      <p class="kopf">Kleinkram · September 2026</p>
      <dl class="posten">
        {
          posten.map(({ label, wert }) => (
            <>
              <dt>{label}</dt>
              <dd>{wert}</dd>
            </>
          ))
        }
      </dl>
      <dl class="posten summen">
        {
          summen.map(({ label, wert, stark }) => (
            <>
              <dt class:list={[stark && 'stark']}>{label}</dt>
              <dd class:list={[stark && 'stark']}>{wert}</dd>
            </>
          ))
        }
      </dl>
      <div class="grenze">
        <p class="grenze-label">
          <span>Umsatz zur § 19-Grenze</span>
          <span class="grenze-wert"></span>
        </p>
        <span class="balken"><span class="balken-stand"></span></span>
      </div>
    </div>
  </div>
</ProjectScene>

<style>
  @property --kk-stand {
    syntax: '<integer>';
    inherits: true;
    initial-value: 57;
  }

  .tisch {
    --kk-stand: 57;
    --kk-papier: oklch(0.995 0.003 80);
    --kk-tinte: oklch(0.2 0.005 80);
    --kk-matt: oklch(0.5 0.008 80);
    --kk-linie: oklch(0.8 0.006 80);
    display: grid;
    place-items: center;
    padding-block: 2rem;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .tisch {
      --kk-papier: oklch(0.3 0.006 80);
      --kk-tinte: oklch(0.95 0.003 80);
      --kk-matt: oklch(0.72 0.008 80);
      --kk-linie: oklch(0.45 0.006 80);
    }
  }
  :root[data-theme='dark'] .tisch {
    --kk-papier: oklch(0.3 0.006 80);
    --kk-tinte: oklch(0.95 0.003 80);
    --kk-matt: oklch(0.72 0.008 80);
    --kk-linie: oklch(0.45 0.006 80);
  }

  .zettel {
    width: min(100%, 22rem);
    padding: 1.25rem 1.25rem 1.75rem;
    background: var(--kk-papier);
    color: var(--kk-tinte);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    transform: rotate(-1deg);
  }
  .kopf {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kk-matt);
  }
  .posten {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    padding-block: 0.75rem;
    border-top: 1px dashed var(--kk-linie);
  }
  .posten dt {
    color: var(--kk-matt);
  }
  .posten dd {
    margin: 0;
    text-align: right;
  }
  .stark {
    color: var(--kk-tinte);
    font-weight: 600;
  }
  .summen dd {
    color: var(--kk-tinte);
  }

  .grenze {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--kk-linie);
  }
  .grenze-label {
    margin: 0 0 0.4rem;
    display: flex;
    justify-content: space-between;
    color: var(--kk-matt);
  }
  .grenze-wert {
    color: var(--kk-tinte);
    font-weight: 600;
  }
  .grenze-wert::after {
    counter-reset: kk-stand calc(var(--kk-stand));
    content: counter(kk-stand) ' %';
  }
  .balken {
    display: block;
    height: 0.375rem;
    border: 1px solid var(--kk-linie);
    border-radius: 2px;
  }
  .balken-stand {
    display: block;
    height: 100%;
    width: calc(var(--kk-stand) * 1%);
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /*
       * Langschreibweise mit Absicht: Der CSS-Minifier zieht `animation-timeline`
       * sonst in die Kurzform `animation`, und die verwirft der Browser als Ganzes.
       */
      .tisch {
        animation-name: kk-fuellen;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 50vh;
      }
    }
  }

  @keyframes kk-fuellen {
    from {
      --kk-stand: 0;
    }
    to {
      --kk-stand: 57;
    }
  }
</style>
