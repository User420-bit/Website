---
/**
 * Availably: zwei iPhones auf dem Tisch, darin die echte App. Die Rahmen sind
 * gezeichnet (iPhone 16 Pro: Titanrand, Tasten, Kamerasteuerung), die
 * Bildschirme zeigen Aufnahmen aus zwei Simulatoren mit Beispielnamen
 * (Availably/docs/vorschau/BRIEFING_WEBSITE.md). Das ist die eine Bühne, die
 * keine Szene ist: Was auf den Bildschirmen läuft, ist Beleg, deshalb beginnt
 * die Bildunterschrift mit „Aufnahme“ statt „Szene“ (DESIGN.md, Bühne).
 *
 * Der Ablauf folgt der Regel der App („Macht das Availably ruhiger oder
 * lauter?“): Beim Laden liegen beide iPhones flach und stehen auf, der
 * Bildschirm geht an, der erste Moment läuft einmal, dann ist Ruhe. Drei
 * Momente stehen zur Wahl (Radio-Knöpfe, ohne Skript über `:has()`): Status
 * teilen, Koppeln, Zeitlimit. Auf der Leitung zwischen den Telefonen wandert
 * ein Punkt nur, wenn die App wirklich etwas sendet; beim Zeitlimit bleibt sie
 * still, weil beide Seiten das Ende selbst ausrechnen.
 *
 * Ohne Skript und mit reduzierter Bewegung steht der Endzustand: iPhones
 * aufrecht, das letzte Bild jedes Clips als Standbild. Das Skript spielt die
 * Clips, legt die Farbe des Schlusspunkts der H1 (AvailablyPage) im Takt der
 * Aufnahme fest und schickt den Punkt über die Leitung.
 */
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

const MOMENTE = [
  {
    id: 'status',
    name: 'Status teilen',
    text: 'Jonas setzt „Fokus“ für 30 Minuten und tippt „Fertig“. Lea zieht die Ansicht nach unten und holt den neuen Stand vom Server, von allein spätestens nach einer Minute. Keine Nachricht, keine Nachfrage.',
  },
  {
    id: 'koppeln',
    name: 'Koppeln',
    text: 'Lea gibt den Code von Jonas ein. Bei ihr steht sofort „Ihr seid verbunden.“, bei Jonas wird aus der offenen Einladung ihre Karte. Keine Anfrage, keine Annahme.',
  },
  {
    id: 'zeitlimit',
    name: 'Zeitlimit',
    text: 'Leas „Beschäftigt“ läuft ab, und ihr iPhone springt von selbst auf „Verfügbar“. Das von Jonas rechnet das Ende ebenfalls selbst aus, spätestens 15 Sekunden später. Gesendet wird dafür nichts.',
  },
] as const

const PERSONEN = [
  { id: 'jonas', name: 'Jonas' },
  { id: 'lea', name: 'Lea' },
] as const

// Erstes und letztes Bild jedes Clips, aus den Rohaufnahmen gezogen.
const bilder = import.meta.glob<ImageMetadata>('/src/assets/projekte/availably/*.png', {
  eager: true,
  import: 'default',
})
const standbild = async (name: string) => {
  const src = bilder[`/src/assets/projekte/availably/${name}.png`]
  if (!src) throw new Error(`Standbild fehlt: ${name}.png`)
  return (await getImage({ src, width: 540, format: 'webp' })).src
}

const clips = await Promise.all(
  PERSONEN.map(async (person) => ({
    ...person,
    clips: await Promise.all(
      MOMENTE.map(async ({ id }) => ({
        id,
        src: `${import.meta.env.BASE_URL}aufnahmen/availably/${id}-${person.id}.mp4`,
        anfang: await standbild(`${id}-${person.id}-anfang`),
        ende: await standbild(`${id}-${person.id}-ende`),
      })),
    ),
  })),
)
---

<figure class="av m-0 mt-6 sm:mt-10" data-av>
  <div class="av-flaeche" data-uebergang>
    <div class="av-buehne mx-auto max-w-5xl px-4">
      <div class="paar" aria-hidden="true">
        {
          clips.map((person) => (
            <div class:list={['geraet', person.id]}>
              <div class="iphone">
                <span class="taste aktion" />
                <span class="taste lauter" />
                <span class="taste leiser" />
                <span class="taste seite" />
                <span class="kamerasteuerung" />
                <div class="glas">
                  <div class="schirm">
                    {person.clips.map((clip) => (
                      <img data-m={clip.id} src={clip.ende} alt="" width="540" height="1174" />
                    ))}
                    {person.clips.map((clip) => (
                      <video
                        data-m={clip.id}
                        src={clip.src}
                        poster={clip.ende}
                        data-anfang={clip.anfang}
                        width="540"
                        height="1174"
                        muted
                        playsinline
                        preload="none"
                        disablepictureinpicture
                        disableRemotePlayback
                      />
                    ))}
                  </div>
                </div>
              </div>
              <p class="wer">{person.name}</p>
            </div>
          ))
        }

        {/* Die Kopplung: kein Chat, keine Nachricht, nur diese eine Leitung. */}
        <div class="leitung">
          <span class="oben">
            <span class="gekoppelt">gekoppelt</span>
            <span class="offen">Einladung offen</span>
          </span>
          <span class="linie"><span class="server"></span><span class="bote"></span></span>
          <span class="unten">
            <span class="code">U7M2TG</span>
            <span class="still">nichts gesendet</span>
          </span>
        </div>
      </div>

      <div class="pult">
        <div class="steuerung">
          <fieldset class="momente">
            <legend class="sr-only">Moment wählen</legend>
            <span class="daumen" aria-hidden="true"></span>
            {
              MOMENTE.map(({ id, name }, i) => (
                <label class="moment">
                  <input
                    type="radio"
                    name="av-moment"
                    value={id}
                    checked={i === 0}
                    autocomplete="off"
                  />
                  <span>{name}</span>
                </label>
              ))
            }
          </fieldset>
          <button type="button" class="knopf" data-av-knopf aria-label="Abspielen" hidden>
            <svg class="spielen" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5Z"
              ></path>
            </svg>
            <svg class="anhalten" viewBox="0 0 16 16" aria-hidden="true">
              <rect x="4" y="3" width="2.75" height="10" rx="0.6"></rect>
              <rect x="9.25" y="3" width="2.75" height="10" rx="0.6"></rect>
            </svg>
          </button>
        </div>
        <div class="texte">
          {
            MOMENTE.map(({ id, text }) => (
              <p class="text" data-m={id}>
                {text}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <figcaption class="mt-3 max-w-[65ch] text-sm text-fg-muted">
    <span class="font-medium text-fg">Aufnahme</span> · Zwei iPhone-Simulatoren (iPhone 16 Pro, iOS 18.6)
    mit Beispielnamen und einem Server auf dem eigenen Rechner. Die Clips sind echt und zugeschnitten,
    nicht beschleunigt und ohne Überblendung. Gezeichnet sind nur die Rahmen der iPhones und der Punkt
    auf der Leitung.
  </figcaption>
</figure>

<script>
  /*
   * Spielt die Clips eines Moments auf beiden iPhones gleichzeitig und hält
   * Schlusspunkt und Leitung im Takt der Aufnahme. Ohne dieses Skript stehen
   * die letzten Bilder als Standbild; kein Speicher, keine Anfrage außer den
   * Clips selbst.
   */
  const root = document.querySelector<HTMLElement>('[data-av]')
  const knopf = root?.querySelector<HTMLButtonElement>('[data-av-knopf]')
  if (root && knopf) {
    const seite = root.closest<HTMLElement>('.av-seite')
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[name="av-moment"]')]
    const alle = [...root.querySelectorAll('video')]
    // Sekunde im Clip → Status, den der Partner sieht (Farbe des Schlusspunkts),
    // oder mit „>“ der Weg des Punkts auf der Leitung.
    const TAKTE: Record<string, [number, string][]> = {
      status: [
        [0, 'verfuegbar'],
        [1.45, '>hin'],
        [3.05, '>weiter'],
        [3.5, 'fokus'],
      ],
      koppeln: [
        [0, 'keiner'],
        [2.1, '>zurueck'],
        [2.5, 'verfuegbar'],
      ],
      zeitlimit: [
        [0, 'beschaeftigt'],
        [2.5, 'verfuegbar'],
      ],
    }
    let bild = 0
    let laeuft = false
    let beruehrt = false

    const moment = () => radios.find((r) => r.checked)?.value ?? 'status'
    const clips = () => alle.filter((v) => v.dataset.m === moment())
    const knopfZeigt = (an: boolean) => {
      laeuft = an
      knopf.dataset.an = String(an)
      knopf.setAttribute('aria-label', an ? 'Anhalten' : 'Abspielen')
    }
    const setze = (t: number) => {
      for (const [ab, was] of TAKTE[moment()] ?? []) {
        if (t < ab) break
        if (was.startsWith('>')) {
          if (root.dataset.bote !== was.slice(1)) root.dataset.bote = was.slice(1)
        } else {
          seite?.style.setProperty(
            '--av-jetzt',
            was === 'keiner' ? 'currentColor' : `var(--av-${was})`,
          )
        }
      }
    }
    const halt = () => {
      cancelAnimationFrame(bild)
      for (const v of alle) v.pause()
      root.classList.remove('spielt')
      delete root.dataset.bote
      seite?.style.removeProperty('--av-jetzt')
      knopfZeigt(false)
    }
    const takt = () => {
      const vs = clips()
      setze(vs[0]?.currentTime ?? 0)
      if (vs.every((v) => v.ended)) return halt()
      bild = requestAnimationFrame(takt)
    }
    const weiter = (vs: HTMLVideoElement[]) => {
      knopfZeigt(true)
      Promise.all(vs.map((v) => v.play())).then(takt, halt)
    }
    const spiele = () => {
      halt()
      const vs = clips()
      for (const v of vs) v.currentTime = 0
      root.classList.add('spielt')
      setze(0)
      weiter(vs)
    }

    knopf.hidden = false
    knopf.addEventListener('click', () => {
      beruehrt = true
      if (laeuft) {
        cancelAnimationFrame(bild)
        for (const v of alle) v.pause()
        knopfZeigt(false)
      } else if (root.classList.contains('spielt')) weiter(clips())
      else spiele()
    })

    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches
    root.addEventListener('change', () => {
      beruehrt = true
      if (ruhig) halt()
      else spiele()
    })

    // Einmal vorführen, wenn die iPhones stehen und im Blick sind, dann Ruhe.
    // Bis dahin zeigt jeder Clip sein erstes Bild, damit nichts zurückspringt.
    if (!ruhig) {
      for (const v of alle) v.poster = v.dataset.anfang ?? v.poster
      for (const v of clips()) v.preload = 'auto'
      const blick = new IntersectionObserver(
        ([eintrag]) => {
          if (!eintrag?.isIntersecting) return
          blick.disconnect()
          window.setTimeout(() => beruehrt || spiele(), 1900)
        },
        { threshold: 0.4 },
      )
      // Die Telefone, nicht die ganze Figur: Auf dem Handy ist sie höher als der halbe Bildschirm.
      const paar = root.querySelector('.paar')
      if (paar) blick.observe(paar)
    }
  }
</script>

<style>
  /*
   * Farben des Schlusspunkts: Apples Systemfarben, so wie die App sie zeigt
   * (Briefing, Abschnitt 4), mit den Werten des Dunkelmodus als Zwilling. Sie
   * hängen am Artikel, weil der Schlusspunkt der H1 außerhalb dieser
   * Komponente steht. Ohne Skript gilt das Ende des gewählten Moments.
   */
  :global(.av-seite) {
    --av-verfuegbar: #34c759;
    --av-beschaeftigt: #ff9500;
    --av-fokus: #007aff;
    --av-jetzt: var(--av-fokus);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) .av-seite) {
      --av-verfuegbar: #30d158;
      --av-beschaeftigt: #ff9f0a;
      --av-fokus: #0a84ff;
    }
  }
  :global(:root[data-theme='dark'] .av-seite) {
    --av-verfuegbar: #30d158;
    --av-beschaeftigt: #ff9f0a;
    --av-fokus: #0a84ff;
  }
  :global(
    .av-seite:has(input[name='av-moment']:is([value='koppeln'], [value='zeitlimit']):checked)
  ) {
    --av-jetzt: var(--av-verfuegbar);
  }

  /*
   * Maße: Alles hängt an der Breite eines iPhones (`--av-w`), abgeleitet aus
   * der Fensterbreite, damit auch die Tischkante im Hintergrund weiß, wo die
   * Telefone stehen. Rand 1,4 %, schwarzer Glasrand 2,2 %, darin der
   * Bildschirm im Seitenverhältnis der Aufnahmen (1206 × 2622); so kommt das
   * Gerät auf das Verhältnis des iPhone 16 Pro (71,5 × 149,6 mm).
   */
  .av {
    --av-mitte: 3.25rem;
    --av-paar: min(100vw - 2rem, 33rem);
    --av-w: calc((var(--av-paar) - var(--av-mitte)) / 2);
    --av-h: calc(var(--av-w) * 2.0896);
    --av-oben: 2rem;
    --av-steh: 0.75rem;
    --av-drehung: 8deg;

    --av-wand: oklch(0.955 0.004 80);
    --av-kante: oklch(0.85 0.01 75);
    --av-tisch-hinten: oklch(0.93 0.007 75);
    --av-tisch: oklch(0.905 0.009 75);

    /* Die Geräte haben eine Farbe, egal wie die Seite steht: Wüstentitan und Titan natur. */
    --av-glas: #0a0a0b;
  }
  @media (min-width: 640px) {
    .av {
      --av-mitte: 5.5rem;
      --av-oben: 2.5rem;
      --av-steh: 1rem;
      --av-drehung: 10deg;
    }
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .av {
      --av-wand: oklch(0.205 0.004 80);
      --av-kante: oklch(0.33 0.006 75);
      --av-tisch-hinten: oklch(0.25 0.006 75);
      --av-tisch: oklch(0.225 0.006 75);
    }
  }
  :root[data-theme='dark'] .av {
    --av-wand: oklch(0.205 0.004 80);
    --av-kante: oklch(0.33 0.006 75);
    --av-tisch-hinten: oklch(0.25 0.006 75);
    --av-tisch: oklch(0.225 0.006 75);
  }

  /*
   * Wand und Tisch, über die volle Fensterbreite. Die Kante liegt knapp über
   * dem Fuß der iPhones, damit sie auf dem Tisch stehen und nicht davor.
   */
  .av-flaeche {
    --av-kante-y: calc(var(--av-oben) + var(--av-h) - var(--av-steh));
    margin-inline: calc(50% - 50vw);
    padding-block: var(--av-oben) 1.5rem;
    overflow: hidden;
    background: linear-gradient(
      to bottom,
      var(--av-wand) var(--av-kante-y),
      var(--av-kante) var(--av-kante-y) calc(var(--av-kante-y) + 1px),
      var(--av-tisch-hinten) calc(var(--av-kante-y) + 1px),
      var(--av-tisch)
    );
  }

  .av-buehne {
    display: grid;
    row-gap: 1.75rem;
  }
  @media (min-width: 960px) {
    .av-flaeche {
      padding-bottom: 2.5rem;
    }
    .av-buehne {
      grid-template-columns: var(--av-paar) minmax(0, 24rem);
      column-gap: 4.5rem;
      align-items: center;
    }
    /* Das Pult hängt an der Wand, auf Höhe der Karten in der App. */
    .pult {
      margin-bottom: calc(var(--av-h) * 0.25);
    }
  }

  /* Jonas links, Lea rechts, dazwischen die Leitung. */
  .paar {
    display: grid;
    grid-template-columns: var(--av-w) var(--av-mitte) var(--av-w);
    width: var(--av-paar);
  }
  .geraet {
    perspective: 1400px;
  }
  .jonas {
    grid-column: 1;
    perspective-origin: 110% 30%;
    --av-rand: #b8a08b;
    --av-rand-hell: #e2d1c1;
    --av-rand-dunkel: #7b6858;
    --av-dreh: var(--av-drehung);
    --av-spaet: 0s;
  }
  .lea {
    grid-column: 3;
    perspective-origin: -10% 30%;
    --av-rand: #b2ada5;
    --av-rand-hell: #dcd8d1;
    --av-rand-dunkel: #75706a;
    --av-dreh: calc(var(--av-drehung) * -1);
    --av-spaet: 0.12s;
  }

  /*
   * Das Gerät: Titanrand als Fläche, darüber der schwarze Glasrand, darin der
   * Bildschirm. Eine zweite Lage dahinter gibt dem Rand Tiefe, sobald sich
   * das Telefon dreht; Tasten und Kamerasteuerung sitzen in dieser Tiefe.
   */
  .iphone {
    position: relative;
    height: var(--av-h);
    padding: calc(var(--av-w) * 0.014);
    border-radius: calc(var(--av-w) * 0.179);
    background:
      linear-gradient(
        90deg,
        var(--av-rand-dunkel),
        var(--av-rand-hell) 1.2%,
        var(--av-rand) 3%,
        var(--av-rand) 97%,
        var(--av-rand-hell) 98.8%,
        var(--av-rand-dunkel)
      ),
      var(--av-rand);
    transform: rotateY(var(--av-dreh));
    transform-origin: 50% 100%;
    transform-style: preserve-3d;
  }
  .iphone::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--av-rand-dunkel);
    transform: translateZ(calc(var(--av-w) * -0.05));
  }

  .taste,
  .kamerasteuerung {
    position: absolute;
    width: calc(var(--av-w) * 0.016);
    border-radius: calc(var(--av-w) * 0.01);
    transform: translateZ(calc(var(--av-w) * -0.025));
  }
  .taste {
    background: linear-gradient(
      90deg,
      var(--av-rand-dunkel),
      var(--av-rand-hell) 45%,
      var(--av-rand)
    );
  }
  .aktion,
  .lauter,
  .leiser {
    left: calc(var(--av-w) * -0.012);
  }
  .aktion {
    top: 18.5%;
    height: 5.2%;
  }
  .lauter {
    top: 26.5%;
    height: 9%;
  }
  .leiser {
    top: 37.5%;
    height: 9%;
  }
  .seite {
    right: calc(var(--av-w) * -0.012);
    top: 28%;
    height: 14%;
  }
  /* Kamerasteuerung: flach im Rand, aus Saphirglas, deshalb dunkel. */
  .kamerasteuerung {
    right: 0;
    top: 57%;
    height: 10.5%;
    background: linear-gradient(90deg, #2c2c2e, #6e6e73 55%, #3a3a3c);
    transform: none;
  }

  .glas {
    position: relative;
    height: 100%;
    padding: calc(var(--av-w) * 0.022);
    border-radius: calc(var(--av-w) * 0.165);
    background: var(--av-glas);
  }
  .schirm {
    position: relative;
    display: grid;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--av-w) * 0.143);
    background: #f2f2f7;
  }
  /*
   * Unter jedem Clip liegt sein letztes Bild. Ohne Skript zeigt der Browser
   * an einem Video eigene Bedienelemente, deshalb steht dann nur das Bild.
   */
  .schirm :is(img, video) {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    visibility: hidden;
  }
  @media (scripting: none) {
    .schirm video {
      display: none;
    }
  }
  .av:has([value='status']:checked) [data-m='status'],
  .av:has([value='koppeln']:checked) [data-m='koppeln'],
  .av:has([value='zeitlimit']:checked) [data-m='zeitlimit'] {
    visibility: visible;
  }

  /* Ausgeschalteter Bildschirm und ein Lichtstreif auf dem Glas; beide nur beim Aufstehen. */
  .schirm::after,
  .glas::after {
    content: '';
    position: absolute;
    pointer-events: none;
    opacity: 0;
  }
  .schirm::after {
    inset: 0;
    background: var(--av-glas);
  }
  .glas::after {
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
        105deg,
        transparent 40%,
        rgb(255 255 255 / 0.2) 50%,
        transparent 60%
      )
      0 0 / 300% 100% no-repeat;
  }

  .wer {
    margin: 0.625rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--color-fg-muted);
    text-align: center;
  }

  /*
   * Die Leitung auf Höhe der Partnerkarte in der App. Der Kreis in der Mitte
   * ist der Server: Dort wartet der Status, bis das andere iPhone nachfragt.
   */
  .leitung {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    height: var(--av-h);
    font-size: 0.6875rem;
    line-height: 1rem;
    color: var(--color-fg-muted);
    text-align: center;
  }
  .linie {
    position: absolute;
    top: calc(var(--av-w) * 0.56 - 2px);
    inset-inline: 0.375rem;
    height: 4px;
    container-type: inline-size;
    background: radial-gradient(circle, var(--color-fg-muted) 0 1px, transparent 1.5px) 0 50% / 6px
      4px repeat-x;
    transition: opacity var(--duration-slow) var(--ease-quiet);
  }
  .server {
    position: absolute;
    top: -0.1875rem;
    left: calc(50% - 0.3125rem);
    width: 0.625rem;
    height: 0.625rem;
    border: 1.5px solid var(--color-fg-muted);
    border-radius: 50%;
    background: var(--av-wand);
  }
  .bote {
    position: absolute;
    top: -0.125rem;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--av-fokus);
    opacity: 0;
  }
  .av:has([value='koppeln']:checked) .bote {
    background-color: var(--av-verfuegbar);
  }
  .oben,
  .unten {
    position: absolute;
    inset-inline: -0.5rem;
    display: grid;
  }
  .oben {
    top: calc(var(--av-w) * 0.56 - 1.625rem);
  }
  .unten {
    top: calc(var(--av-w) * 0.56 + 0.625rem);
  }
  .oben > *,
