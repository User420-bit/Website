  .tg-lava .tg-wand-rechts::after {
    background-position:
      left 6rem top 9rem,
      left 3rem top 30rem;
  }

  /*
   * ---------- Schacht und Fahrzeug ----------
   * Breit liegen sie im Rand links der Spalte, schmal in einem Streifen am
