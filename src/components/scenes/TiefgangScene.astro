   * der Text auf ruhigem Grund steht. Schmal bleibt nur ein Streifen links um den
   * Stollen (siehe unten).
   */
  .tg-wand {
    position: absolute;
    top: 0;
    bottom: 0;
    width: max(0px, calc(50% - 32rem));
    pointer-events: none;
  }
  .tg-wand::before {
    content: '';
    position: absolute;
