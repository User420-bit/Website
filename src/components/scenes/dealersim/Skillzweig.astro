---
/**
 * Die Funktionen von DealerSim als ein Zweig im Skill-Baum des Spiels: jede
 * Funktion ein Knoten, die Knoten auf einer senkrechten Linie. Der Text ist
 * derselbe wie in der Liste des gemeinsamen Körpers und steht immer da; nur
 * der Knoten schaltet sich frei, wenn seine Zeile beim Lesen ins Bild kommt.
 *
 * Ohne scrollgetriebene Animation oder bei reduzierter Bewegung sind alle
 * Knoten freigeschaltet: Der Endzustand steht. Farben nur aus den Tokens.
 */
interface Props {
  items: readonly string[]
  class?: string
}

const { items, class: className } = Astro.props
---

<ul class:list={['zweig prose-flow m-0 max-w-[65ch] list-none p-0 text-fg-muted', className]}>
  {
    items.map((item) => (
      <li class="ast">
        <span class="knoten" aria-hidden="true" />
        <span class="block border-b border-border pb-3">{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .ast {
    position: relative;
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    column-gap: 1rem;
  }
  .ast + .ast {
    margin-top: 0.75rem;
  }

  /* Die Linie des Zweigs: von Knoten zu Knoten, zwei Pixel breit. */
  .ast:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(0.375rem - 1px);
    top: calc(0.4375rem + 0.75rem);
    bottom: calc(-0.75rem - 0.4375rem);
    width: 2px;
    background-color: var(--color-border);
  }

  /* Ein Knoten: Quadrat mit abgeschnittenen Pixelecken, gefüllt heißt freigeschaltet. */
  .knoten {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.4375rem;
    border: 2px solid var(--color-fg);
    background-color: var(--color-fg);
    clip-path: polygon(
      2px 0,
      calc(100% - 2px) 0,
      calc(100% - 2px) 2px,
      100% 2px,
      100% calc(100% - 2px),
      calc(100% - 2px) calc(100% - 2px),
      calc(100% - 2px) 100%,
      2px 100%,
      2px calc(100% - 2px),
      0 calc(100% - 2px),
      0 2px,
      2px 2px
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /*
       * Langschreibweise mit Absicht: Der CSS-Minifier zieht `animation-timeline`
       * sonst in die Kurzform `animation`, und die verwirft der Browser als Ganzes.
       */
      .knoten {
        animation-name: ds-freischalten;
        animation-timing-function: steps(1, jump-end);
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 100% cover 40%;
      }
    }
  }

  @keyframes ds-freischalten {
    from {
      border-color: var(--color-border);
      background-color: transparent;
    }
    to {
      border-color: var(--color-fg);
      background-color: var(--color-fg);
    }
  }
</style>
