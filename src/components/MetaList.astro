---
/**
 * Eckdaten als linierte Definitionsliste: Label links (6rem), Wert rechts,
 * Haarlinie über jeder Zeile. Auf den Projektseiten Art, Zeitraum, Stand und
 * Technik — nur dort stehen Technik-Namen, in Mono. Im Kontakt Ort und
 * Profile. Ein `href` macht den Wert zum Link; externe Links öffnen im neuen
 * Tab und sagen das für Screenreader dazu.
 *
 * `einziehen` (docs/BEWEGUNG_PLAN.md, G): Die Zeilen kommen beim
 * Hereinscrollen einmal, Zeile um Zeile wie die Nummernzeilen der
 * Arbeitsweise: Die Haarlinie zieht von links auf, Label und Wert ziehen
 * 8 px ein. Nur auf Wunsch: Auf den Projektseiten zieht die Meta-Liste mit
 * ihrem Block ein (Plan, Abschnitt H); doppelt gestaffelt wäre zu viel.
 */
import KindLabel from '@/components/KindLabel.astro'

interface Row {
  label: string
  value: string
  /** `kind`: Art des Projekts über KindLabel · `numeric`: Tabellenziffern · `mono`: Technik-Namen */
  variant?: 'kind' | 'numeric' | 'mono'
  href?: string
  external?: boolean
}

interface Props {
  rows: readonly Row[]
  /** Zeilen beim Hereinscrollen gestaffelt einziehen lassen (Kontakt). */
  einziehen?: boolean
  class?: string
}

const { rows, einziehen = false, class: className = '' } = Astro.props
/** Nur mit `einziehen` tragen Zeile, Label und Wert einen Anfangszustand. */
const bewegt = einziehen ? { 'data-bewegt': '' } : {}
const valueClass = {
  kind: '',
  numeric: 'tabular-nums',
  mono: 'font-mono text-xs leading-6 text-fg-muted',
}
---

<dl
  class:list={['m-0 max-w-[65ch] border-b border-border', className]}
  data-metaliste-einzug={einziehen ? '' : undefined}
>
  {
    rows.map((row) => (
      <div
        class="metazeile grid grid-cols-[6rem_minmax(0,1fr)] gap-x-4 border-t border-border py-2.5 text-sm"
        {...bewegt}
      >
        <dt class="text-fg-muted" {...bewegt}>
          {row.label}
        </dt>
        <dd class:list={['m-0', row.variant ? valueClass[row.variant] : 'prose-flow']} {...bewegt}>
          {row.variant === 'kind' ? (
            <KindLabel kind={row.value} />
          ) : row.href ? (
            <a
              class="text-accent underline underline-offset-4"
              href={row.href}
              {...(row.external ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
            >
              {row.value}
              {row.external && <span class="sr-only"> (öffnet in neuem Tab)</span>}
            </a>
          ) : (
            row.value
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  /*
   * Anfangszustand nur mit Skript und erlaubter Bewegung. Die Haarlinie ist
   * der obere Rand der Zeile; ein Vieleck schneidet von ihm alles rechts der
   * Spitze weg und lässt den Rest der Zeile frei. Zieht die Spitze nach
   * rechts, zieht die Linie auf, ohne dass ein Pixel Layout sich ändert.
   */
  html[data-bewegung] .metazeile[data-bewegt] {
    clip-path: polygon(0 0, 0% 0, 0% 1px, 100% 1px, 100% 100%, 0 100%);
  }
  html[data-bewegung] .metazeile > [data-bewegt] {
    opacity: 0;
    transform: translateY(8px);
  }
</style>

<script>
  /*
   * Motion erst laden, wenn eine Liste es braucht: Die Meta-Liste steht auf
   * jeder Projektseite, bewegt sich aber nur im Kontakt. So kostet sie dort
   * kein Byte von Motion.
   */
  const listen = document.querySelectorAll<HTMLElement>('[data-metaliste-einzug]')
  if (listen.length > 0) import('@/lib/motion').then(einziehen)

  /** Abstand von Zeile zu Zeile, wie bei den Nummernzeilen (Plan, Abschnitt E). */
  const ZEILEN_STAFFEL = 0.08
  const LINIE_ZU = 'polygon(0 0, 0% 0, 0% 1px, 100% 1px, 100% 100%, 0 100%)'
  const LINIE_AUF = 'polygon(0 0, 100% 0, 100% 1px, 100% 1px, 100% 100%, 0 100%)'

  /**
   * Räumt erst im nächsten Bild auf: Motion schreibt die Endwerte selbst noch
   * als Inline-Stil, nachdem `then` gelaufen ist.
   */
  const danach = (aufraeumen: () => void) => requestAnimationFrame(() => aufraeumen())

  /** Endzustand: Anfangszustand und eigene Inline-Werte weg. */
  function inRuhe(el: HTMLElement) {
    el.removeAttribute('data-bewegt')
    for (const p of ['clip-path', 'opacity', 'transform']) el.style.removeProperty(p)
  }

  /**
   * Hält das Sicherheitsnetz aus global.css an, solange es noch nicht
   * gegriffen hat. Falsch, wenn es schon gegriffen hat (Skript kam spät);
   * dann steht alles und soll nicht noch einmal verschwinden.
   */
  function netzAnhalten(els: Element[]): boolean {
    const netz = els.flatMap((el) => el.getAnimations().filter((a) => a instanceof CSSAnimation))
    if (netz.some((a) => a.playState === 'finished')) return false
    for (const a of netz) a.cancel()
    return true
  }

  function einziehen({
    DAUER,
    KURVE,
    STAFFEL,
    WEG_TEXT,
    alle,
    animate,
    bewegt,
    inView,
  }: typeof import('@/lib/motion')) {
    for (const liste of listen) {
      const versteckt = alle('[data-bewegt]', liste)
      if (!bewegt() || !netzAnhalten(versteckt)) {
        versteckt.forEach(inRuhe)
        continue
      }
      inView(
        liste,
        () => {
          alle(':scope > .metazeile', liste).forEach((zeile, i) => {
            const start = i * ZEILEN_STAFFEL
            animate(
              zeile,
              { clipPath: [LINIE_ZU, LINIE_AUF] },
              { duration: DAUER.szene, ease: KURVE, delay: start },
            ).then(() => danach(() => inRuhe(zeile)))
            ;[...zeile.children].forEach((teil, j) => {
              const el = teil as HTMLElement
              animate(
                el,
                { opacity: [0, 1], y: [WEG_TEXT, 0] },
                { duration: DAUER.langsam, ease: KURVE, delay: start + j * STAFFEL },
              ).then(() => danach(() => inRuhe(el)))
            })
          })
        },
        { amount: 0.2 },
      )
    }
  }
</script>
