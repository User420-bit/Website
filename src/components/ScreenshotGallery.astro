---
/**
 * Bilder einer Referenz, so entschieden am 2026-09-23: das Leitbild groß mit
 * Bildunterschrift, darunter die übrigen Bilder als Kontaktabzug, alle in
 * derselben Höhe und im eigenen Seitenverhältnis, damit kein Handybild
 * beschnitten wird. Ein Klick vergrößert jedes Bild in einer Lightbox.
 *
 * Die Lightbox ist ein natives Popover (`popover`, `popovertarget`) und braucht
 * kein JavaScript: Esc und ein Klick neben das Bild schließen sie, beim Öffnen
 * springt der Fokus auf "Schließen", beim Schließen zurück auf das Bild.
 * Blättern in der Lightbox gibt es bewusst nicht, dafür bräuchte es ein
 * Script; geblättert wird im Kontaktabzug.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Shot {
  image: ImageMetadata
  caption: string
}

interface Props {
  shots: readonly Shot[]
  /** Projekttitel, für die Kopfzeile der Lightbox. */
  title: string
}

const { shots, title } = Astro.props

const hochformat = (shot: Shot) => shot.image.height > shot.image.width
// Querformate zuerst, das erste davon ist das Leitbild. Hochformate (Handy, Dialoge) danach.
const bilder = [...shots.filter((shot) => !hochformat(shot)), ...shots.filter(hochformat)]
const erstes = bilder[0]
const leitbild = erstes && !hochformat(erstes) ? erstes : undefined
const weitere = leitbild ? bilder.slice(1) : bilder
const id = (shot: Shot) => `bild-${bilder.indexOf(shot) + 1}`

const knopf =
  'block cursor-zoom-in overflow-hidden rounded-sm border border-border p-0 transition-colors hover:border-fg/40 focus-visible:border-fg/40 motion-reduce:transition-none'
---

{
  bilder.length > 0 && (
    <div class="mt-10">
      {leitbild && (
        <figure class="m-0">
          <button
            type="button"
            class:list={[knopf, 'w-full']}
            popovertarget={id(leitbild)}
            aria-label={`Bild vergrößern: ${leitbild.caption}`}
          >
            <Image
              class="block w-full"
              src={leitbild.image}
              alt=""
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1024px) 62rem, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </button>
          {/* Die Bildunterschrift steckt schon im Namen des Knopfs; Screenreader lesen sie nicht doppelt. */}
          <figcaption aria-hidden="true" class="mt-2 max-w-[65ch] text-sm text-fg-muted">
            {leitbild.caption}
          </figcaption>
        </figure>
      )}

      {weitere.length > 0 && (
        <ul class="mt-6 flex list-none flex-wrap gap-3 p-0">
          {weitere.map((shot) => (
            <li>
              <button
                type="button"
                class={knopf}
                popovertarget={id(shot)}
                aria-label={`Bild vergrößern: ${shot.caption}`}
              >
                <Image
                  class="block h-20 w-auto sm:h-28"
                  src={shot.image}
                  alt=""
                  widths={hochformat(shot) ? [80, 160] : [240, 480]}
                  sizes={
                    hochformat(shot)
                      ? '(min-width: 640px) 52px, 37px'
                      : '(min-width: 640px) 200px, 142px'
                  }
                />
              </button>
            </li>
          ))}
        </ul>
      )}

      {bilder.map((shot, i) => (
        <div
          id={id(shot)}
          popover
          role="dialog"
          aria-label={`${title}, Bild ${i + 1} von ${bilder.length}`}
          class="lightbox m-auto max-h-dvh max-w-[min(100vw,1600px)] overflow-auto border-0 bg-transparent p-4 text-fg backdrop:bg-bg sm:p-6"
        >
          <div class="flex items-center justify-between gap-4">
            <p class="m-0 text-sm text-fg-muted tabular-nums">
              {title} · Bild {i + 1} von {bilder.length}
            </p>
            {/*
              autofocus ist hier Absicht: Ein Popover setzt den Fokus beim Öffnen auf dieses
              Element, sonst bliebe er hinter der Lightbox auf dem Vorschaubild stehen.
            */}
            {/* eslint-disable astro/jsx-a11y/no-autofocus */}
            <button
              type="button"
              class="inline-flex shrink-0 cursor-pointer items-center gap-2 rounded-sm border border-fg/25 px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none"
              popovertarget={id(shot)}
              popovertargetaction="hide"
              autofocus
            >
              Schließen
              <svg
                aria-hidden="true"
                class="size-3.5"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
            </button>
            {/* eslint-enable astro/jsx-a11y/no-autofocus */}
          </div>
          {/* Die Bildunterschrift beschreibt das Bild; ein gleichlautendes alt würde doppelt gelesen. */}
          <figure class="m-0 mt-4">
            <Image
              class="block h-auto max-h-[calc(100dvh-10rem)] w-auto max-w-full rounded-sm border border-border"
              src={shot.image}
              alt=""
              widths={hochformat(shot) ? [480, 780] : [960, 1600]}
              sizes={
                hochformat(shot)
                  ? '(min-width: 640px) 26rem, 80vw'
                  : '(min-width: 1640px) 1600px, 96vw'
              }
            />
            <figcaption class="mt-3 max-w-[65ch] text-sm text-fg-muted">{shot.caption}</figcaption>
          </figure>
        </div>
      ))}
    </div>
  )
}

<style is:global>
  /* Hinter der offenen Lightbox scrollt die Seite nicht mit. */
  html:has(.lightbox:popover-open) {
    overflow: hidden;
  }
</style>
