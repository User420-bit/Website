---
/**
 * Bilder einer Referenz, so entschieden am 2026-09-23: das Leitbild groß mit
 * Bildunterschrift, darunter die übrigen Bilder als Kontaktabzug, alle in
 * derselben Höhe und im eigenen Seitenverhältnis, damit kein Handybild
 * beschnitten wird. Ein Klick vergrößert jedes Bild in einer Lightbox.
 *
 * Die Lightbox ist ein natives Popover (`popover`, `popovertarget`) und braucht
 * kein JavaScript: Esc und ein Klick neben das Bild schließen sie, beim Öffnen
 * springt der Fokus auf "Schließen", beim Schließen zurück auf das Bild.
 *
 * Geblättert wird in der Lightbox selbst (entschieden am 2026-10-07, vorher
 * nur im Kontaktabzug): "Zurück" und "Weiter" zeigen per `popovertarget` auf
 * die Nachbar-Lightbox, im Kreis. Das Script unten schließt vor dem Blättern
 * die offene Lightbox (sonst stapelt der Browser die nächste als Kind
 * darüber), und ergänzt, was HTML nicht kann: Pfeiltasten, Wischen am Handy,
 * und dass der Fokus nach dem Blättern auf demselben Knopf bleibt, statt auf
 * "Schließen" zu springen. Ohne Script bleibt Blättern bedienbar, nur Esc
 * braucht dann einen Druck je geblättertem Bild.
 *
 * Bewegung (docs/BEWEGUNG_PLAN.md, H): Das Leitbild steht still, es ist das
 * Ziel des Übergangs von der Kachel und darf in keinem Moment verschoben sein.
 * Der Kontaktabzug kommt beim Hereinscrollen Bild um Bild (16 px, 60 ms
 * Staffel). Die Lightbox blendet beim Öffnen in 200 ms auf, das Bild wächst
 * von 0,98; reines CSS (`@starting-style`), Schließen geht sofort.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Arrow from '@/components/Arrow.astro'

interface Shot {
  image: ImageMetadata
  caption: string
}

interface Props {
  shots: readonly Shot[]
  /** Projekttitel, für die Kopfzeile der Lightbox. */
  title: string
  /**
   * Das Leitbild ist das Ziel des Übergangs von der Kachel (`data-uebergang`,
   * siehe ProjectPage). Nur setzen, wenn es im ersten Bildschirm steht und die
   * Seite kein anderes Ziel markiert.
   */
  uebergang?: boolean
}

const { shots, title, uebergang = false } = Astro.props

const hochformat = (shot: Shot) => shot.image.height > shot.image.width
// Querformate zuerst, das erste davon ist das Leitbild. Hochformate (Handy, Dialoge) danach.
const bilder = [...shots.filter((shot) => !hochformat(shot)), ...shots.filter(hochformat)]
const erstes = bilder[0]
const leitbild = erstes && !hochformat(erstes) ? erstes : undefined
const weitere = leitbild ? bilder.slice(1) : bilder
const id = (shot: Shot) => `bild-${bilder.indexOf(shot) + 1}`

const knopf =
  'block cursor-zoom-in overflow-hidden rounded-sm border border-border p-0 transition-colors hover:border-fg/40 focus-visible:border-fg/40 motion-reduce:transition-none'
/** Knöpfe in der Kopfzeile der Lightbox, Blättern und Schließen im selben Stil. */
const kopfKnopf =
  'inline-flex h-9 shrink-0 cursor-pointer items-center justify-center gap-2 rounded-sm border border-fg/25 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none'
/** Nachbar im Kreis: nach dem letzten Bild kommt das erste. */
const nachbar = (i: number, schritt: number) =>
  bilder[(i + schritt + bilder.length) % bilder.length]!
---

{
  bilder.length > 0 && (
    <div class="mt-10">
      {leitbild && (
        <figure class="m-0">
          <button
            type="button"
            class:list={[knopf, 'w-full']}
            popovertarget={id(leitbild)}
            aria-label={`Bild vergrößern: ${leitbild.caption}`}
            data-uebergang={uebergang || undefined}
          >
            <Image
              class="block w-full"
              src={leitbild.image}
              alt=""
              widths={[800, 1200, 1600]}
              sizes="(min-width: 1024px) 62rem, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </button>
          {/* Die Bildunterschrift steckt schon im Namen des Knopfs; Screenreader lesen sie nicht doppelt. */}
          <figcaption aria-hidden="true" class="mt-2 max-w-[65ch] text-sm text-fg-muted">
            {leitbild.caption}
          </figcaption>
        </figure>
      )}

      {weitere.length > 0 && (
        <ul class="mt-6 flex list-none flex-wrap gap-3 p-0" data-kontaktabzug>
          {weitere.map((shot) => (
            <li data-bewegt="galerie">
              <button
                type="button"
                class={knopf}
                popovertarget={id(shot)}
                aria-label={`Bild vergrößern: ${shot.caption}`}
              >
                <Image
                  class="block h-20 w-auto sm:h-28"
                  src={shot.image}
                  alt=""
                  widths={hochformat(shot) ? [80, 160] : [240, 480]}
                  sizes={
                    hochformat(shot)
                      ? '(min-width: 640px) 52px, 37px'
                      : '(min-width: 640px) 200px, 142px'
                  }
                />
              </button>
            </li>
          ))}
        </ul>
      )}

      {bilder.map((shot, i) => (
        <div
          id={id(shot)}
          popover
          role="dialog"
          aria-label={`${title}, Bild ${i + 1} von ${bilder.length}`}
          class="lightbox m-auto max-h-dvh max-w-[min(100vw,1600px)] overflow-auto border-0 bg-transparent p-4 text-fg backdrop:bg-bg sm:p-6"
        >
          <div class="flex items-center justify-between gap-4">
            <p class="m-0 text-sm text-fg-muted tabular-nums">
              {title} · Bild {i + 1} von {bilder.length}
            </p>
            <div class="flex items-center gap-2">
              {bilder.length > 1 && (
                <>
                  <button
                    type="button"
                    class:list={[kopfKnopf, 'w-9']}
                    popovertarget={id(nachbar(i, -1))}
                    data-blaettern="-1"
                  >
                    <Arrow direction="left" />
                    <span class="sr-only">Vorheriges Bild</span>
                  </button>
                  <button
                    type="button"
                    class:list={[kopfKnopf, 'w-9']}
                    popovertarget={id(nachbar(i, 1))}
                    data-blaettern="1"
                  >
                    <Arrow />
                    <span class="sr-only">Nächstes Bild</span>
                  </button>
                </>
              )}
              {/*
                autofocus ist hier Absicht: Ein Popover setzt den Fokus beim Öffnen auf dieses
                Element, sonst bliebe er hinter der Lightbox auf dem Vorschaubild stehen.
              */}
              {/* eslint-disable astro/jsx-a11y/no-autofocus */}
              <button
                type="button"
                class:list={[kopfKnopf, 'px-3']}
                popovertarget={id(shot)}
                popovertargetaction="hide"
                autofocus
              >
                Schließen
                <svg
                  aria-hidden="true"
                  class="size-3.5"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="M4 4l8 8M12 4l-8 8" />
                </svg>
              </button>
              {/* eslint-enable astro/jsx-a11y/no-autofocus */}
            </div>
          </div>
          {/* Die Bildunterschrift beschreibt das Bild; ein gleichlautendes alt würde doppelt gelesen. */}
          <figure class="m-0 mt-4">
            <Image
              class="block h-auto max-h-[calc(100dvh-10rem)] w-auto max-w-full rounded-sm border border-border"
              src={shot.image}
              alt=""
              widths={hochformat(shot) ? [480, 780] : [960, 1600]}
              sizes={
                hochformat(shot)
                  ? '(min-width: 640px) 26rem, 80vw'
                  : '(min-width: 1640px) 1600px, 96vw'
              }
            />
            <figcaption class="mt-3 max-w-[65ch] text-sm text-fg-muted">{shot.caption}</figcaption>
          </figure>
        </div>
      ))}
    </div>
  )
}

<style>
  /* Anfangszustand nur mit Skript und erlaubter Bewegung, nie im Ausdruck. */
  @media screen {
    :global(html[data-bewegung]) [data-bewegt='galerie'] {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<style is:global>
  /* Hinter der offenen Lightbox scrollt die Seite nicht mit. */
  html:has(.lightbox:popover-open) {
    overflow: hidden;
  }

  /*
   * Öffnen: Deckkraft und Bild kommen in 200 ms. Der Übergang hängt nur am
   * offenen Zustand, deshalb schließt die Lightbox ohne Nachlauf, sofort.
   */
  @media (prefers-reduced-motion: no-preference) {
    .lightbox:popover-open {
      transition: opacity var(--duration-base) var(--ease-quiet);
    }
    .lightbox:popover-open figure img {
      transition: transform var(--duration-base) var(--ease-quiet);
    }
    @starting-style {
      .lightbox:popover-open {
        opacity: 0;
      }
      .lightbox:popover-open figure img {
        transform: scale(0.98);
      }
    }
  }
</style>

<script>
  import { DAUER, KURVE, STAFFEL, alle, animate, inView, stagger, wennBewegt } from '@/lib/motion'

  /*
   * Blättern in der Lightbox: Die Knöpfe tun ihre Arbeit ohne Script. Hier
   * kommt dazu, was HTML nicht kann. Pfeiltasten und Wischen drücken den
   * passenden Knopf; nach jedem Blättern wandert der Fokus auf denselben Knopf
   * der neuen Lightbox, sonst stünde er nach `autofocus` auf "Schließen", und
   * wer mit Enter weiterblättert, schlösse beim zweiten Druck.
   */
  const offene = () => document.querySelector<HTMLElement>('.lightbox:popover-open')
  const blaettere = (richtung: '-1' | '1') => {
    const knopf = offene()?.querySelector<HTMLButtonElement>(`[data-blaettern="${richtung}"]`)
    knopf?.click()
  }
  document.addEventListener('click', (event) => {
    const knopf = (event.target as Element).closest<HTMLElement>('[data-blaettern]')
    if (!knopf) return
    const richtung = knopf.dataset.blaettern
    // Erst die offene Lightbox schließen, dann öffnet `popovertarget` die
    // nächste. Bliebe die offene stehen, läge die nächste als Kind darüber:
    // Esc schlösse dann nur die oberste, und bei jedem Blättern käme eine
    // Schicht dazu. Ohne Script passiert genau das; es bleibt bedienbar, nur
    // Esc braucht dann einen Druck je geblättertem Bild.
    knopf.closest<HTMLElement>('.lightbox')?.hidePopover()
    // Das neue Popover setzt beim Öffnen seinen `autofocus`; erst danach den
    // Fokus auf den Blätterknopf.
    requestAnimationFrame(() => {
      offene()?.querySelector<HTMLElement>(`[data-blaettern="${richtung}"]`)?.focus()
    })
  })
  document.addEventListener('keydown', (event) => {
    if (!offene()) return
    if (event.key === 'ArrowLeft') blaettere('-1')
    if (event.key === 'ArrowRight') blaettere('1')
  })
  let wischStart: number | undefined
  document.addEventListener(
    'touchstart',
    (event) => {
      wischStart = offene() ? event.changedTouches[0]?.clientX : undefined
    },
    { passive: true },
  )
  document.addEventListener(
    'touchend',
    (event) => {
      if (wischStart === undefined) return
      const weg = (event.changedTouches[0]?.clientX ?? wischStart) - wischStart
      wischStart = undefined
      if (Math.abs(weg) < 48) return
      blaettere(weg < 0 ? '1' : '-1')
    },
    { passive: true },
  )

  // Wie in ProjectPage: Nach 2 s hat das Netz in global.css womöglich schon aufgedeckt.
  const ZU_SPAET = 1800

  /**
   * Nach dem Einzug bleibt nichts zurück: kein Anfangszustand, kein
   * Inline-Stil, kein Transform (Motion hinterließe `translateY(0px)`). Erst
   * im nächsten Bild, denn Motion schreibt seinen Endwert selbst noch einmal
   * im nächsten Bild.
   */
  const aufraeumen = (teile: HTMLElement[]) =>
    requestAnimationFrame(() => {
      for (const teil of teile) {
        teil.removeAttribute('data-bewegt')
        teil.style.removeProperty('opacity')
        teil.style.removeProperty('transform')
        teil.style.removeProperty('animation')
      }
    })

  wennBewegt(() => {
    if (performance.now() > ZU_SPAET) return
    for (const abzug of alle('[data-kontaktabzug]')) {
      const bilder = alle('[data-bewegt="galerie"]', abzug)
      // Das Modul läuft, das Netz wird nicht gebraucht: Es deckte sonst nach
      // 2 s auf, und beim Hereinscrollen zögen die Bilder ein zweites Mal ein.
      for (const bild of bilder) bild.style.animation = 'none'
      inView(
        abzug,
        () => {
          animate(
            bilder,
            { opacity: [0, 1], transform: ['translateY(16px)', 'none'] },
            { duration: DAUER.langsam, ease: KURVE, delay: stagger(STAFFEL) },
          ).then(() => aufraeumen(bilder))
        },
        { amount: 0.3 },
      )
    }
  })
</script>
