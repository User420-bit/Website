---
import Button from '@/components/Button.astro'
import NavHighlight from '@/components/NavHighlight.astro'
import { href, NAV_ITEMS } from '@/lib/site'

interface Props {
  /** Auf der Startseite markiert ein IntersectionObserver den aktiven Anker. */
  isHome?: boolean
  name: string
}

const { isHome = false, name } = Astro.props
---

<header class="site-header sticky top-0 z-50 bg-bg">
  <a
    href="#inhalt"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
  >
    Zum Inhalt springen
  </a>
  <div
    class="mx-auto grid max-w-5xl grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 px-4 py-3 sm:grid-cols-[auto_1fr_auto] sm:py-4"
  >
    <a
      href={href('/')}
      class="text-lg font-semibold tracking-tight text-fg no-underline"
      aria-label={`${name} – Startseite`}
    >
      {name}
    </a>
    <nav
      aria-label="Hauptnavigation"
      class="col-span-2 row-start-2 sm:col-span-1 sm:row-start-auto"
    >
      <ul
        class="-mx-1 flex list-none flex-wrap gap-x-2 gap-y-1 p-0 text-sm sm:justify-end sm:gap-x-3"
      >
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                class="nav-link relative inline-block px-1 py-1 text-fg-muted no-underline transition-colors hover:text-fg after:absolute after:inset-x-1 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform hover:after:scale-x-100 motion-reduce:after:transition-none"
                href={href(`/#${item.id}`)}
                data-nav-target={item.id}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="col-start-2 row-start-1 sm:col-start-3">
      <Button href={href('/#kontakt')} size="sm">Anfrage</Button>
    </div>
  </div>
</header>

{isHome && <NavHighlight />}
