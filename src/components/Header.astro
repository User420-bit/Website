---
/**
 * Kopf jeder Seite. Breit steht alles in einer Zeile und klebt oben. Auf dem
 * Handy klebt nur die Zeile mit Name und Anfrage; die Navigation steht darunter
 * außerhalb des `<header>` und scrollt mit der Seite weg, damit der klebende
 * Kopf beim Lesen 58 statt 90 bis 121 px des Bildschirms belegt. Beide
 * Navigationen kommen aus derselben Liste, sichtbar ist immer nur eine.
 *
 * Auf der Startseite trägt jede Navigation einen eigenen orangen Strich, der
 * mit Bewegung vom alten zum neuen aktiven Anker gleitet (`NavHighlight`,
 * docs/BEWEGUNG_PLAN.md, A). Er liegt absolut in der Navigation und rührt
 * nicht an ihrer Höhe. Hover zieht weiter am einzelnen Link von links auf.
 */
import Button from '@/components/Button.astro'
import NavHighlight from '@/components/NavHighlight.astro'
import { href, NAV_ITEMS } from '@/lib/site'

interface Props {
  /** Auf der Startseite markiert ein IntersectionObserver den aktiven Anker. */
  isHome?: boolean
  name: string
}

const { isHome = false, name } = Astro.props

/*
 * Die Anker stehen in Tinte und Gewicht 500, nicht mehr in Bleistiftgrau
 * (seit 2026-10-08): Sie sind der Weg durch die Seite und sahen aus wie der
 * Fuß. Hover legt verdünntes Orange hinter den Link, der aktive Anker steht
 * in Orange mit Strich darunter.
 */
const linkClass =
  'nav-link relative inline-block rounded-md px-1 py-1.5 text-sm font-medium text-fg no-underline transition-colors hover:bg-accent-soft hover:text-accent after:absolute after:inset-x-1 after:bottom-0 after:h-0.5 sm:px-2.5 sm:text-[0.9375rem] sm:after:inset-x-2.5 after:origin-right after:scale-x-0 after:bg-accent after:transition-transform hover:after:origin-left hover:after:scale-x-100 focus-visible:after:origin-left focus-visible:after:scale-x-100 motion-reduce:after:transition-none'
---

<header class="site-header sticky top-0 z-50 bg-bg">
  <a
    href="#inhalt"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-fg"
  >
    Zum Inhalt springen
  </a>
  <div
    class="mx-auto grid max-w-5xl grid-cols-[1fr_auto] items-center gap-x-6 px-4 py-2.5 sm:grid-cols-[auto_1fr_auto] sm:py-4"
  >
    <a
      href={href('/')}
      class="text-lg font-semibold tracking-tight text-fg no-underline"
      aria-label={`${name} – Startseite`}
    >
      {name}
    </a>
    <nav aria-label="Hauptnavigation" class="relative hidden sm:block">
      <ul class="-mx-2.5 flex list-none flex-wrap justify-end gap-x-1 gap-y-1 p-0">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a class={linkClass} href={href(`/#${item.id}`)} data-nav-target={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      {isHome && <span aria-hidden="true" class="nav-strich" data-nav-strich />}
    </nav>
    <div>
      <Button href={href('/#kontakt')} size="sm">Anfrage</Button>
    </div>
  </div>
</header>

{
  /* Handy: dieselben Anker unter dem Kopf, nicht klebend. Verteilt statt mit festem Abstand, damit sie ab 360 px in eine Zeile passen. */
}
<nav aria-label="Hauptnavigation" class="relative mx-auto w-full max-w-5xl px-4 pb-2 sm:hidden">
  <ul class="-mx-1 flex list-none flex-wrap justify-between gap-y-1 p-0">
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a class={linkClass} href={href(`/#${item.id}`)} data-nav-target={item.id}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  {isHome && <span aria-hidden="true" class="nav-strich" data-nav-strich />}
</nav>

{isHome && <NavHighlight />}

<style>
  /*
   * Aktiver Anker ohne gleitenden Strich (kein Skript für Bewegung, reduzierte
   * Bewegung): der eigene Unterstrich steht. Tailwind 4 skaliert über `scale`,
   * nicht über `transform`, und `text-fg-muted` liegt in einer späteren Ebene
   * als die Regel in global.css; deshalb beides hier, ungeschichtet.
   */
  .nav-link[aria-current='true'] {
    color: var(--color-accent);
  }
  .nav-link[aria-current='true']::after {
    scale: 1;
  }

  /* Gleitet der Strich, übernimmt er; der eigene Unterstrich bleibt Hover. */
  nav[data-gleitet] .nav-link[aria-current='true']::after {
    scale: 0 1;
  }

  /*
   * 1 px breit an den Nullpunkt der Navigation gelegt; `NavHighlight` setzt
   * Lage und Breite als `translate() scaleX()`. Ohne Skript bleibt er
   * unsichtbar.
   */
  .nav-strich {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 2px;
    background-color: var(--color-accent);
    transform-origin: 0 0;
    opacity: 0;
    pointer-events: none;
  }
</style>
