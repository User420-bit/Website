---
/**
 * Übergang Bühne ↔ Projektseite (DESIGN.md, Bewegung): Den Namen bekommt nur
 * ein sichtbares `data-uebergang`-Element, das im Fenster steht. Sonst flöge
 * das Bild nach dem Lesen einer Projektseite von weit oben in die Bühne, oder
 * von außerhalb des Fensters auf die Projektseite; so blenden beide nur über.
 *
 * `is:inline` im `<head>`, weil `pagereveal` vor dem ersten Bild der neuen
 * Seite feuert und ein Modul-Skript dann noch nicht liefe. Ohne Skript morpht
 * jedes Paar, auch von außerhalb des Fensters.
 */
---

<script is:inline>
  ;(() => {
    const pruefe = (event) => {
      if (!event.viewTransition) return
      for (const el of document.querySelectorAll('[data-uebergang]')) {
        const rahmen = el.getBoundingClientRect()
        // Unsichtbar heißt auch: Platz halten ohne gesehen zu werden, wie die
        // Bühnen der Arbeiten, die gerade nicht dran sind.
        const sichtbar = el.checkVisibility?.({ visibilityProperty: true }) ?? true
        const imFenster =
          sichtbar && rahmen.width > 0 && rahmen.bottom > 0 && rahmen.top < innerHeight
        el.style.viewTransitionName = imFenster ? '' : 'none'
      }
    }
    addEventListener('pageswap', pruefe)
    addEventListener('pagereveal', pruefe)
  })()
</script>
