---
/**
 * Die Seite von Kleinkram: der gemeinsame Körper (ProjectPage) mit der Bühne
 * des Projekts. Hier gehört alles hin, was nur diese Seite besonders macht;
 * Slots und `hide` sind in ProjectPage.astro beschrieben.
 */
import type { Props } from '@/components/ProjectPage.astro'
import ProjectPage from '@/components/ProjectPage.astro'
import KleinkramScene from '@/components/scenes/KleinkramScene.astro'

const { projekt, prev, next } = Astro.props as Props
---

<ProjectPage projekt={projekt} prev={prev} next={next}>
  <KleinkramScene slot="stage" />
</ProjectPage>
