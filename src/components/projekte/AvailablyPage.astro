---
/**
 * Die Seite von Availably: der gemeinsame Körper (ProjectPage) mit eigenem
 * Kopf und einer Bühne mit zwei iPhones, auf denen echte Aufnahmen der App
 * laufen. Der Kopf ist der Standardkopf mit einem Unterschied: Die H1 endet
 * mit einem Schlusspunkt in der Farbe des Status, den der Partner in der
 * Aufnahme gerade sieht. Er wechselt im selben Moment wie der Bildschirm.
 * Farben und `--av-jetzt` setzt AvailablyScene auf `.av-seite`.
 *
 * Die Galerie zeigt nur die Hochformate. Das Querformat in der Projektdatei
 * ist das Kachelbild für Startseite und `/projekte/` (beide iPhones auf
 * Weiß); hier stünde es direkt unter der Bühne, die dasselbe bewegt zeigt.
 *
 * Alles andere bleibt beim Körper: Meta-Liste, Text, Funktionen, Technische
 * Entscheidungen, Erkenntnisse, Vor/Zurück und Anfrage.
 */
import ProjectNav from '@/components/ProjectNav.astro'
import type { Props } from '@/components/ProjectPage.astro'
import ProjectPage from '@/components/ProjectPage.astro'
import ScreenshotGallery from '@/components/ScreenshotGallery.astro'
import AvailablyScene from '@/components/scenes/AvailablyScene.astro'

const { projekt, prev, next } = Astro.props as Props
const data = projekt.data
const hochformate = data.screenshots.filter((shot) => shot.image.height > shot.image.width)
---

<ProjectPage projekt={projekt} prev={prev} next={next} hide={['gallery']} articleClass="av-seite">
  <Fragment slot="hero">
    <ProjectNav prev={prev} next={next} />

    <h1 class="display mt-4 mb-0 text-4xl font-semibold text-balance sm:mt-6 sm:text-5xl">
      {data.title}<span class="schlusspunkt" aria-hidden="true"></span>
    </h1>
    <p
      class="prose-flow mt-3 max-w-[65ch] text-base leading-relaxed text-fg-muted sm:mt-5 sm:text-lg"
    >
      {data.summary}
    </p>
  </Fragment>

  <AvailablyScene slot="stage" />

  <ScreenshotGallery slot="after-meta" shots={hochformate} title={data.title} />
</ProjectPage>

<style>
  /*
   * Ein Punkt statt eines Punkts: so groß wie ein Satzzeichen der H1, in der
   * Farbe des Status. Den Zeitpunkt gibt die Aufnahme vor, nicht der Punkt.
   */
  .schlusspunkt {
    display: inline-block;
    width: 0.19em;
    height: 0.19em;
    margin-left: 0.06em;
    border-radius: 50%;
    background-color: var(--av-jetzt, currentColor);
    transition: background-color var(--duration-slow) var(--ease-quiet);
  }
  @media (prefers-reduced-motion: reduce) {
    .schlusspunkt {
      transition-duration: 0s;
    }
  }
</style>
