---
interface Props {
  title: string
  description: string
  /** Seiten, die nicht in den Index sollen (404, unvollstaendiger Rechtstext). */
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
// Mit abschliessendem Slash, damit Canonical und `sitemap-0.xml` dieselbe URL nennen.
const canonical = new URL(Astro.url.pathname.replace(/\/*$/, '/'), Astro.site)
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content="Pharrel Sandjo Djomou" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{
  /*
  Kein `og:image`: Es existiert noch kein Bild. Ein Tag, der auf eine tote URL
  zeigt, ist schlechter als kein Tag. Siehe README, offene Punkte.
*/
}
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbfd" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#16181f" />
