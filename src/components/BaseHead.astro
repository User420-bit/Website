---
import { Font } from 'astro:assets'
import { getEntry } from 'astro:content'
import { VORSCHAUBILD } from '@/lib/site'

interface Props {
  title: string
  description: string
  /** Seiten, die nicht in den Index sollen (404, unvollstaendiger Rechtstext). */
  noindex?: boolean
}

const { title, description, noindex = false } = Astro.props
// Mit abschliessendem Slash, damit Canonical und `sitemap-0.xml` dieselbe URL nennen.
const canonical = new URL(Astro.url.pathname.replace(/\/*$/, '/'), Astro.site)
const company = (await getEntry('company', 'main'))!.data
const vorschaubild = new URL(VORSCHAUBILD.pfad, Astro.site)
const vorschaubildAlt = `${company.name}: ${company.claim} ${company.location.split(',')[0]}, ${company.areaServed}.`
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<Font cssVariable="--font-klartext" preload />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content="Klartext" />
{
  /*
  Ein Vorschaubild für alle Seiten, typografisch aus Name, Claim und Ort
  (`npm run vorschaubild`). `npm run test:build` prüft, dass die Datei existiert
  und zum Text passt: Ein Tag, der auf eine tote URL zeigt, ist schlechter als kein Tag.
*/
}
<meta property="og:image" content={vorschaubild} />
<meta property="og:image:width" content={String(VORSCHAUBILD.breite)} />
<meta property="og:image:height" content={String(VORSCHAUBILD.hoehe)} />
<meta property="og:image:alt" content={vorschaubildAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={vorschaubild} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfb" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#161615" />
