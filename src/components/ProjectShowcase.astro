---
/**
 * Die Arbeiten der Startseite als Galerie, die eine Arbeit zeigt (entschieden
 * am 2026-10-08, docs/ARBEITEN_PLAN.md; vorher Bühne und darunter dieselben
 * Arbeiten noch einmal als Raster). Ein Umschalter "Kunden" / "Eigene
 * Projekte" wie seit dem 2026-09-23. Je Auswahl oben die Bühne mit einer
 * Arbeit, darunter alle Arbeiten der Auswahl als Kontaktabzug, das gewählte
 * Feld markiert, wie auf den Projektseiten. Darunter der Weg zu allen
 * Arbeiten auf einer Seite (`/projekte/`). Beim Öffnen steht die erste Arbeit
 * nach `order`; geblättert wird nur von Hand, kein Timer.
 *
 * Unveröffentlichte Arbeiten (`published: false`) fehlen hier ganz. Bleibt
 * einer Auswahl keine, steht nur ihr Reiter da, ausgegraut, mit "folgt" statt
 * der Anzahl und nicht wählbar; beim Öffnen steht dann die nächste Auswahl.
 * So ist es seit dem 2026-09-24 mit "Kunden".
 *
 * Ohne JavaScript bleibt alles bedienbar: Der Umschalter sind Radio-Buttons,
 * die Auswahl blendet CSS über `:has()` um. Die Bühne zeigt die erste Arbeit,
 * die Felder des Kontaktabzugs sind Links auf die Projektseiten. Kann ein
 * Browser kein `:has()`, stehen beide Auswahlen untereinander.
 *
 * Mit Skript holt ein Feld seine Arbeit auf die Bühne, dazu Blättern-Knöpfe,
 * Pfeiltasten und Wischen. Kommt der Besucher von einer Projektseite zurück,
 * steht deren Arbeit auf der Bühne, damit ihr Bild zurückwachsen kann.
 *
 * Bewegung (docs/ARBEITEN_PLAN.md, 2.4), nur mit Skript und erlaubter
 * Bewegung: Beim Hereinscrollen zieht sich das Bild der Bühne von links auf,
 * Titel und Text ziehen ein, die Felder des Kontaktabzugs kommen gestaffelt.
 * Beim Blättern schiebt die Bühne in Blätterrichtung und der Strich wandert
 * zum neuen Feld, beim Umschalten blendet die Auswahl über, das Bild der
 * Bühne wandert beim Scrollen im Rahmen. Ohne das alles bleibt es beim harten
 * Wechsel.
 */
import type { CollectionEntry } from 'astro:content'
import Arrow from '@/components/Arrow.astro'
import Button from '@/components/Button.astro'
import ProjectSpotlight from '@/components/ProjectSpotlight.astro'
import ProjectThumb from '@/components/ProjectThumb.astro'
import { href } from '@/lib/site'

interface Props {
  /** Alle Arbeiten, schon nach `order` sortiert, auch die unveröffentlichten. */
  projekte: CollectionEntry<'projekte'>[]
}

const { projekte } = Astro.props

/** Die ids `kunden` und `eigene` stehen auch im CSS unten. */
const gruppen = [
  {
    id: 'kunden',
    label: 'Kunden',
    alle: projekte.filter((p) => p.data.kind === 'kundenprojekt'),
  },
  {
    id: 'eigene',
    label: 'Eigene Projekte',
    alle: projekte.filter((p) => p.data.kind !== 'kundenprojekt'),
  },
]
  .filter((gruppe) => gruppe.alle.length > 0)
  .map(({ alle, ...gruppe }) => ({ ...gruppe, projekte: alle.filter((p) => p.data.published) }))
const sichtbar = gruppen.filter((gruppe) => gruppe.projekte.length > 0)

const reiter = 'relative inline-flex items-baseline gap-2 rounded-sm py-3 text-sm font-medium'
const reiterWaehlbar =
  'cursor-pointer text-fg-muted transition-colors after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform hover:text-fg has-checked:text-fg has-checked:after:scale-x-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent motion-reduce:transition-none motion-reduce:after:transition-none'
const reiterAusgegraut = 'cursor-not-allowed text-fg-muted/60'

const blaetternKnopf =
  'inline-flex size-11 cursor-pointer items-center justify-center rounded-sm border border-fg/25 text-fg transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none'
---

<div class="showcase" data-showcase>
  {
    /*
     * Kommt der Besucher mit dem Übergang zurück (Projektseite → Startseite),
     * ist die Bühne das Ziel, in das das Bild zurückwächst. Sie muss dann
     * schon stehen; versteckt oder beschnitten wäre sie ein Loch. `pagereveal`
     * feuert vor dem ersten Bild der Seite, also vor dem gebündelten Skript,
     * darum inline und hier, wo `.showcase` schon steht. `data-ruhig` hebt die
     * Anfangszustände der Bewegung auf.
     */
  }
  <script is:inline>
    ;(() => {
      const showcase = document.currentScript.parentElement
      addEventListener(
        'pagereveal',
        (event) => {
          if (event.viewTransition) showcase.dataset.ruhig = ''
        },
        { once: true },
      )
    })()
  </script>
  {
    gruppen.length > 1 && (
      <fieldset class="m-0 min-w-0 border-0 p-0">
        <legend class="sr-only">Welche Arbeiten zeigen</legend>
        <div class="flex flex-wrap gap-x-6 border-b border-border">
          {gruppen.map((gruppe) => {
            const waehlbar = gruppe.projekte.length > 0
            return (
              <label class:list={[reiter, waehlbar ? reiterWaehlbar : reiterAusgegraut]}>
                <input
                  class="sr-only"
                  type="radio"
                  name="arbeiten-auswahl"
                  value={gruppe.id}
                  checked={gruppe === sichtbar[0]}
                  disabled={!waehlbar}
                />
                {gruppe.label}
                <span class:list={['font-normal tabular-nums', waehlbar && 'text-fg-muted']}>
                  {waehlbar ? gruppe.projekte.length : 'folgt'}
                </span>
              </label>
            )
          })}
        </div>
      </fieldset>
    )
  }

  {
    sichtbar.map((gruppe) => {
      const blaettern = gruppe.projekte.length > 1
      return (
        <div class="mt-8" data-gruppe={gruppe.id}>
          <div class="buehnenfeld relative" data-buehnenfeld>
            {gruppe.projekte.map((projekt, i) => (
              <ProjectSpotlight projekt={projekt} blaettern={blaettern} hidden={i > 0} />
            ))}
            {/* Oben rechts neben dem Titel, damit die Knöpfe beim Blättern nicht wandern. */}
            {blaettern && (
              <div
                class="absolute top-0 right-0 z-10 flex items-center gap-2"
                data-pager
                data-bewegt="text"
                hidden
              >
                <button type="button" class={blaetternKnopf} data-richtung="-1">
                  <Arrow direction="left" />
                  <span class="sr-only">Vorherige Arbeit</span>
                </button>
                <span class="min-w-16 text-center text-sm text-fg-muted tabular-nums" data-zaehler>
                  1 von {gruppe.projekte.length}
                </span>
                <button type="button" class={blaetternKnopf} data-richtung="1">
                  <Arrow />
                  <span class="sr-only">Nächste Arbeit</span>
                </button>
              </div>
            )}
          </div>
          <p class="sr-only" aria-live="polite" data-ansage />

          {blaettern && (
            <ul
              class="kontaktabzug mt-8 list-none"
              aria-label={`${gruppe.label}: Arbeit wählen`}
              data-abzug
            >
              {gruppe.projekte.map((projekt, i) => (
                <ProjectThumb projekt={projekt} index={i} aktiv={i === 0} />
              ))}
            </ul>
          )}
        </div>
      )
    })
  }

  {
    /*
     * Kommt der Besucher von einer Projektseite zurück, holt dieses Skript
     * deren Arbeit auf die Bühne, bevor das erste Bild gemalt wird: Nur eine
     * sichtbare Bühne kann Ziel des Übergangs sein (ProjectTransition prüft
     * das bei `pagereveal`). Es läuft beim Lesen der Seite, gleich nach den
     * Bühnen; `navigation.activation` nennt die Seite, von der er kommt.
     * Browser ohne Navigation API zeigen die erste Arbeit, wie ohne Skript.
     */
  }
  <script is:inline>
    ;(() => {
      const von = window.navigation?.activation?.from?.url
      const slug = von && new URL(von).pathname.match(/\/projekte\/([^/]+)\/?$/)?.[1]
      if (!slug) return
      const showcase = document.currentScript.parentElement
      const ziel = showcase.querySelector(`[data-buehne][data-slug="${CSS.escape(slug)}"]`)
      const gruppe = ziel?.closest('[data-gruppe]')
      if (!ziel || !gruppe) return
      const buehnen = [...gruppe.querySelectorAll('[data-buehne]')]
      const index = buehnen.indexOf(ziel)
      buehnen.forEach((buehne, i) => (buehne.hidden = i !== index))
      gruppe.querySelectorAll('[data-ziel]').forEach((feld, i) => {
        if (i === index) feld.setAttribute('aria-current', 'true')
        else feld.removeAttribute('aria-current')
      })
      const zaehler = gruppe.querySelector('[data-zaehler]')
      if (zaehler) zaehler.textContent = `${index + 1} von ${buehnen.length}`
      const knopf = showcase.querySelector(
        `input[name="arbeiten-auswahl"][value="${gruppe.dataset.gruppe}"]`,
      )
      if (knopf) knopf.checked = true
    })()
  </script>

  <div class="mt-6" data-bewegt="text" data-alle>
    <Button href={href('/projekte/')} variant="text">Alle Arbeiten ansehen</Button>
  </div>
</div>

<style>
  /* Nur die gewählte Auswahl steht da. Ohne `:has()` greift das nicht, dann stehen beide. */
  .showcase:has(input[value='kunden']:checked) [data-gruppe='eigene'],
  .showcase:has(input[value='eigene']:checked) [data-gruppe='kunden'] {
    display: none;
  }

  /*
   * Alle Bühnen einer Auswahl liegen in derselben Zelle übereinander. Die
   * nicht gewählten sind unsichtbar, halten aber ihren Platz: Das Feld steht
   * so hoch wie die höchste Bühne, und beim Blättern rutscht nichts darunter.
   * `visibility` nimmt sie zugleich aus Tab-Reihenfolge, Suche und
   * Vorleseansicht.
   */
  .buehnenfeld {
    display: grid;
  }
  .buehnenfeld > :global([data-buehne]) {
    grid-area: 1 / 1;
  }
  .buehnenfeld > :global([data-buehne][hidden]) {
    display: block;
    visibility: hidden;
  }

  /*
   * Kontaktabzug: eine Reihe, die nicht umbricht. Die Felder teilen sich die
   * Breite, jedes zwischen 6 und 8 rem; passt die Reihe nicht (am Handy ab
   * vier Arbeiten), scrollt sie waagerecht, und das letzte Feld steht
   * angeschnitten am Rand: der Hinweis, dass es weitergeht. Der Innenabstand
   * hält Platz für den Fokusring, der negative Rand gleicht ihn aus.
   */
  .kontaktabzug {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(6rem, 8rem);
    justify-content: start;
    gap: 0.75rem;
    margin-inline: -0.25rem;
    margin-bottom: -0.25rem;
    padding: 0.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 0.25rem;
    scrollbar-width: none;
  }
  .kontaktabzug::-webkit-scrollbar {
    display: none;
  }
  .kontaktabzug > :global(li) {
    scroll-snap-align: start;
  }

  /*
   * Anfangszustände, bis das Skript sie einziehen lässt. Nur mit Skript und
   * erlaubter Bewegung (`data-bewegung`), nicht nach einem Übergang
   * (`data-ruhig`, siehe oben) und nie im Ausdruck. Das Bild zieht sich innen
   * auf; das Bildfeld darum ist Ziel des Übergangs und bleibt unberührt.
   */
  @media screen {
    :global(html[data-bewegung]) [data-showcase]:not([data-ruhig]) :global([data-bewegt='text']) {
      opacity: 0;
      transform: translateY(8px);
    }
    :global(html[data-bewegung]) [data-showcase]:not([data-ruhig]) :global([data-bewegt='bild']) {
      clip-path: inset(0 100% 0 0);
    }
    :global(html[data-bewegung]) [data-showcase]:not([data-ruhig]) :global([data-bewegt='feld']) {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<script>
  import {
    alle,
    animate,
    bewegt,
    DAUER,
    inView,
    KURVE,
    scroll,
    stagger,
    STAFFEL,
    WEG_TEXT,
  } from '@/lib/motion'

  /** Wie weit die Bühne beim Blättern schiebt; sie ist ein Beleg, kein Text. */
  const WEG_BUEHNE = 24
  /** Wie weit ein Feld des Kontaktabzugs einzieht. */
  const WEG_FELD = 16
  /** Wie weit das Bild im Rahmen wandert, in Prozent, je Richtung. */
  const WEG_BILD = 2.5
  /** So groß steht das Bild im Rahmen, damit beim Wandern kein Rand entsteht. */
  const BILD_GROESSE = 1.06
  /** Ab so vielen Pixeln waagerecht gilt eine Berührung als Wischen, wie in der Lightbox. */
  const WISCHEN = 48

  type Lauf = { stop: () => void; complete: () => void; finished: Promise<unknown> }

  /**
   * Motion schreibt die Endwerte im nächsten Bild noch einmal; wer danach
   * seine Inline-Stile wegräumt, wartet darum zwei Bilder.
   */
  const danach = (aufraeumen: () => void) =>
    requestAnimationFrame(() => requestAnimationFrame(aufraeumen))

  /** Endzustand: Anfangszustand abnehmen, eigene Inline-Stile räumen. */
  const inRuhe = (teile: HTMLElement[]) => {
    for (const teil of teile) {
      teil.removeAttribute('data-bewegt')
      for (const p of ['animation', 'clip-path', 'opacity', 'transform']) {
        teil.style.removeProperty(p)
      }
    }
  }

  const showcase = document.querySelector<HTMLElement>('[data-showcase]')
  if (showcase) richteEin(showcase)

  function richteEin(showcase: HTMLElement) {
    // Lief der Übergang schon, bevor das Inline-Skript oben `pagereveal` sah
    // (langsame Verbindung), steht alles sofort. Ältere Browser kennen den
    // Selektor nicht und werfen.
    try {
      if (document.documentElement.matches(':active-view-transition')) showcase.dataset.ruhig = ''
    } catch {
      // Kein Übergang möglich, also auch keiner aktiv.
    }
    const mitEinzug =
      document.documentElement.hasAttribute('data-bewegung') && !('ruhig' in showcase.dataset)

    for (const gruppe of alle('[data-gruppe]', showcase)) richteGruppeEin(gruppe, mitEinzug)
    richteUmschalterEin(showcase)

    const alleArbeiten = showcase.querySelector<HTMLElement>('[data-alle]')
    if (alleArbeiten && mitEinzug) {
      alleArbeiten.style.animation = 'none'
      const halt = inView(
        alleArbeiten,
        () => {
          halt()
          animate(
            alleArbeiten,
            { opacity: [0, 1], transform: [`translateY(${WEG_TEXT}px)`, 'none'] },
            { duration: DAUER.langsam, ease: KURVE },
          ).then(() => danach(() => inRuhe([alleArbeiten])))
        },
        { amount: 0.5 },
      )
    }
  }

  function richteGruppeEin(gruppe: HTMLElement, mitEinzug: boolean) {
    const buehnen = alle('[data-buehne]', gruppe)
    const feld = gruppe.querySelector<HTMLElement>('[data-buehnenfeld]')
    const abzug = gruppe.querySelector<HTMLElement>('[data-abzug]')
    const pager = gruppe.querySelector<HTMLElement>('[data-pager]')
    const zaehler = gruppe.querySelector<HTMLElement>('[data-zaehler]')
    const ansage = gruppe.querySelector<HTMLElement>('[data-ansage]')
    if (!feld) return

    // Die Felder werden Knöpfe: Mit Skript holen sie ihre Arbeit auf die
    // Bühne, statt wegzunavigieren. Alle Attribute ziehen mit um, auch das des
    // gekapselten Stils, nur `href` nicht.
    const felder = alle<HTMLAnchorElement>('a[data-ziel]', gruppe).map((link) => {
      const knopf = document.createElement('button')
      knopf.type = 'button'
      for (const { name, value } of link.attributes) {
        if (name !== 'href') knopf.setAttribute(name, value)
      }
      knopf.append(...link.childNodes)
      link.replaceWith(knopf)
      return knopf
    })

    // Welche Arbeit steht? Meist die erste; nach dem Zurückkommen von einer
    // Projektseite die, die das Inline-Skript gesetzt hat.
    let aktuell = Math.max(
      buehnen.findIndex((b) => !b.hidden),
      0,
    )

    if (mitEinzug) richteEinzugEin(gruppe, feld, abzug, () => buehnen[aktuell]!)

    // Bild der Bühne: wandert beim Scrollen leicht im Rahmen. Gemessen wird das
    // Bühnenfeld, nicht das Bild: Es steht immer da, auch wenn geblättert wird.
    const rahmen = alle('[data-parallaxe]', gruppe)
    if (rahmen.length > 0 && bewegt()) {
      scroll(() => {
        const ort = feld.getBoundingClientRect()
        if (ort.height === 0) return // Die Auswahl ist gerade nicht gewählt.
        const weg = (innerHeight - ort.top) / (innerHeight + ort.height)
        const y = (Math.min(Math.max(weg, 0), 1) - 0.5) * 2 * WEG_BILD
        for (const bild of rahmen) {
          bild.style.transform = `translateY(${y.toFixed(2)}%) scale(${BILD_GROESSE})`
        }
      })
    }

    if (buehnen.length < 2 || !pager) return

    /** Beendet einen laufenden Wechsel sofort im Endzustand. */
    let beende: (() => void) | undefined

    /**
     * Die Bilder der Bühnen, die nicht dran sind, lädt der Browser erst, wenn
     * sie sichtbar werden; das Bildfeld stünde beim Blättern kurz leer. Darum
     * laden die Nachbarn vor, sobald die Galerie im Fenster steht, und die
     * Arbeit eines Felds, sobald der Zeiger oder der Fokus darauf kommt.
     */
    const ladeVor = (...stellen: number[]) => {
      for (const i of stellen) {
        const bild = buehnen[(i + buehnen.length) % buehnen.length]?.querySelector('img')
        if (bild?.loading === 'lazy') bild.loading = 'eager'
      }
    }
    const haltVorladen = inView(feld, () => {
      haltVorladen()
      ladeVor(aktuell - 1, aktuell + 1)
    })

    /** Holt das Feld `i` in der Reihe ins Bild, ohne die Seite zu scrollen. */
    const holeFeld = (i: number) => {
      const knopf = felder[i]
      if (!abzug || !knopf) return
      const sicht = abzug.scrollLeft
      const links = knopf.getBoundingClientRect().left - abzug.getBoundingClientRect().left + sicht
      const rechts = links + knopf.offsetWidth
      const ziel =
        links < sicht
          ? links - 4
          : rechts > sicht + abzug.clientWidth
            ? rechts - abzug.clientWidth + 4
            : sicht
      if (ziel !== sicht) {
        abzug.scrollTo({ left: ziel, behavior: bewegt() ? 'smooth' : 'auto' })
      }
    }

    const zeige = (index: number, richtung = 0) => {
      beende?.()
      const vorher = aktuell
      aktuell = (index + buehnen.length) % buehnen.length
      if (aktuell === vorher) return
      // Wer blättert, bevor die Bühne eingezogen ist, sieht sie im Endzustand.
      inRuhe(alle('[data-bewegt]', feld))
      buehnen[vorher]!.hidden = true
      buehnen[aktuell]!.hidden = false
      felder.forEach((knopf, i) => {
        if (i === aktuell) knopf.setAttribute('aria-current', 'true')
        else knopf.removeAttribute('aria-current')
      })
      holeFeld(aktuell)
      ladeVor(aktuell - 1, aktuell + 1)
      if (zaehler) zaehler.textContent = `${aktuell + 1} von ${buehnen.length}`
      if (ansage) {
        ansage.textContent = `${buehnen[aktuell]!.dataset.titel}, ${aktuell + 1} von ${buehnen.length}`
      }
      if (richtung !== 0 && bewegt()) beende = blaettere(vorher, aktuell, richtung, feld)
    }

    /**
     * Die Bühne schiebt in Blätterrichtung: Die alte geht 24 px gegen die
     * Richtung und blendet aus, die neue kommt aus der Richtung. Beide liegen
     * in derselben Zelle, das Feld behält seine Höhe. Zusammen 320 ms.
     */
    const blaettere = (vorher: number, jetzt: number, richtung: number, feld: HTMLElement) => {
      const alt = buehnen[vorher]!
      const neu = buehnen[jetzt]!

      alt.style.visibility = 'visible'
      alt.inert = true
      neu.style.opacity = '0'
      Object.assign(feld.style, { overflow: 'clip', overflowClipMargin: '0.5rem' })

      const laeufe: Lauf[] = [
        animate(
          alt,
          { opacity: 0, x: -WEG_BUEHNE * richtung },
          { duration: DAUER.schnell, ease: KURVE },
        ),
        animate(
          neu,
          { opacity: [0, 1], x: [WEG_BUEHNE * richtung, 0] },
          { duration: DAUER.basis, delay: DAUER.schnell, ease: KURVE },
        ),
      ]
      if (zaehler) {
        laeufe.push(
          animate(
            zaehler,
            { opacity: [0, 1], x: [WEG_TEXT * richtung, 0] },
            { duration: DAUER.basis, delay: DAUER.schnell, ease: KURVE },
          ),
        )
      }

      let fertig = false
      const raeumeAuf = () => {
        if (fertig) return
        fertig = true
        alt.inert = false
        for (const buehne of buehnen) buehne.removeAttribute('style')
        zaehler?.removeAttribute('style')
        feld.removeAttribute('style')
      }
      void Promise.all(laeufe.map((lauf) => lauf.finished)).then(() => danach(raeumeAuf))
      return () => {
        for (const lauf of laeufe) lauf.complete()
        raeumeAuf()
      }
    }

    pager.hidden = false

    for (const knopf of pager.querySelectorAll<HTMLButtonElement>('[data-richtung]')) {
      knopf.addEventListener('click', () => {
        const richtung = Number(knopf.dataset.richtung)
        zeige(aktuell + richtung, richtung)
      })
    }

    felder.forEach((knopf, i) => {
      knopf.addEventListener('click', () => zeige(i, Math.sign(i - aktuell)))
      knopf.addEventListener('pointerenter', () => ladeVor(i), { once: true })
      knopf.addEventListener('focus', () => ladeVor(i), { once: true })
    })

    // Pfeiltasten, solange der Fokus in der Galerie steht. Stand er auf der
    // alten Bühne, wandert er auf die neue, sonst fiele er ins Leere.
    gruppe.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
      event.preventDefault()
      const richtung = event.key === 'ArrowLeft' ? -1 : 1
      const vorher = aktuell
      const fokus = document.activeElement
      zeige(aktuell + richtung, richtung)
      if (buehnen[vorher]!.contains(fokus)) {
        buehnen[aktuell]!.querySelector<HTMLElement>('[data-buehne-link]')?.focus()
      } else if (felder.includes(fokus as HTMLButtonElement)) {
        felder[aktuell]?.focus({ preventScroll: true })
      }
    })

    // Wischen am Handy, auf der Bühne. Senkrechtes Scrollen bleibt, wie es ist.
    let start: { x: number; y: number } | undefined
    feld.addEventListener(
      'touchstart',
      (event) => {
        const punkt = event.changedTouches[0]
        start = punkt && { x: punkt.clientX, y: punkt.clientY }
      },
      { passive: true },
    )
    feld.addEventListener(
      'touchend',
      (event) => {
        const punkt = event.changedTouches[0]
        if (!start || !punkt) return
        const dx = punkt.clientX - start.x
        const dy = punkt.clientY - start.y
        start = undefined
        if (Math.abs(dx) < WISCHEN || Math.abs(dx) < Math.abs(dy)) return
        const richtung = dx < 0 ? 1 : -1
        zeige(aktuell + richtung, richtung)
      },
      { passive: true },
    )
  }

  /**
   * Einzug beim Hereinscrollen, einmal. Die Bühne: Bild zieht sich von links
   * auf (600 ms), Titel und Text ziehen 8 px ein, gestaffelt. Der
   * Kontaktabzug: Feld um Feld, 16 px von unten, sobald er selbst im Fenster
   * steht. Die Bühnen, die gerade nicht dran sind, nehmen danach still den
   * Endzustand an. Das Sicherheitsnetz in global.css würde sonst nach 2 s
   * aufdecken, und beim Hereinscrollen zöge alles ein zweites Mal ein; darum
   * übernimmt das Skript hier.
   */
  function richteEinzugEin(
    gruppe: HTMLElement,
    feld: HTMLElement,
    abzug: HTMLElement | null,
    aktiveBuehne: () => HTMLElement,
  ) {
    const buehnenTeile = alle('[data-buehnenfeld] [data-bewegt]', gruppe)
    const felder = abzug ? alle('[data-bewegt]', abzug) : []
    for (const teil of [...buehnenTeile, ...felder]) teil.style.animation = 'none'

    /*
     * Beobachtet wird das Feld, nicht das Bild: Chromium rechnet den
     * `clip-path` des Ziels in die Sichtbarkeit ein, ein ganz zugezogenes
     * Bild käme also nie ins Fenster.
     */
    const haltBuehne = inView(
      feld,
      () => {
        haltBuehne()
        const buehne = aktiveBuehne()
        const pager = gruppe.querySelector<HTMLElement>('[data-pager]')
        const texte = [
          ...alle('[data-bewegt="text"]', buehne),
          ...(pager && !pager.hidden ? [pager] : []),
        ]
        const bilder = alle('[data-bewegt="bild"]', buehne)
        const laeufe = [
          animate(
            texte,
            { opacity: [0, 1], transform: [`translateY(${WEG_TEXT}px)`, 'none'] },
            { duration: DAUER.langsam, ease: KURVE, delay: stagger(STAFFEL) },
          ),
          ...bilder.map((bild) =>
            animate(
              bild,
              { clipPath: ['inset(0 100% 0 0)', 'inset(0 0% 0 0)'] },
              { duration: DAUER.szene, ease: KURVE },
            ),
          ),
        ]
        void Promise.all(laeufe.map((lauf) => lauf.finished)).then(() =>
          danach(() => inRuhe(buehnenTeile)),
        )
        // Wer blättert, bevor der Einzug fertig ist, sieht die nächste Bühne
        // sofort im Endzustand.
        for (const buehne of alle('[data-buehne]', gruppe)) {
          if (buehne.hidden) inRuhe(alle('[data-bewegt]', buehne))
        }
      },
      { amount: 0.3 },
    )

    if (abzug) {
      const haltAbzug = inView(
        abzug,
        () => {
          haltAbzug()
          animate(
            felder,
            { opacity: [0, 1], transform: [`translateY(${WEG_FELD}px)`, 'none'] },
            { duration: DAUER.langsam, ease: KURVE, delay: stagger(STAFFEL) },
          ).then(() => danach(() => inRuhe(felder)))
        },
        { amount: 0.5 },
      )
    }
  }

  /**
   * Kunden ↔ Eigene Projekte: Ohne Skript schaltet CSS über `:has()` hart um.
   * Mit Bewegung hält das Skript die alte Auswahl kurz fest, blendet sie in
   * 120 ms aus und lässt die neue in 200 ms 8 px einziehen. Die Radio-Buttons
   * und ihr Zustand bleiben, wie sie sind; das Skript ändert nur, was man sieht.
   */
  function richteUmschalterEin(showcase: HTMLElement) {
    const knoepfe = alle<HTMLInputElement>('input[name="arbeiten-auswahl"]', showcase)
    const gruppen = alle('[data-gruppe]', showcase)
    let gewaehlt = knoepfe.find((knopf) => knopf.checked)?.value
    let zug = 0
    let laeufe: Lauf[] = []

    for (const knopf of knoepfe) {
      knopf.addEventListener('change', async () => {
        const vorher = gewaehlt
        gewaehlt = knopf.value
        const meiner = ++zug
        // Ein laufender Wechsel weicht sofort, dann gilt wieder allein das CSS.
        for (const lauf of laeufe) lauf.stop()
        laeufe = []
        for (const gruppe of gruppen) gruppe.removeAttribute('style')

        const alt = gruppen.find((g) => g.dataset.gruppe === vorher)
        const neu = gruppen.find((g) => g.dataset.gruppe === knopf.value)
        if (!alt || !neu || alt === neu || !bewegt()) return

        alt.style.display = 'block'
        neu.style.display = 'none'
        const aus = animate(alt, { opacity: [1, 0] }, { duration: DAUER.schnell, ease: KURVE })
        laeufe = [aus]
        await aus.finished
        if (meiner !== zug) return

        alt.style.display = ''
        neu.style.display = ''
        const ein = animate(
          neu,
          { opacity: [0, 1], y: [WEG_TEXT, 0] },
          { duration: DAUER.basis, ease: KURVE },
        )
        laeufe = [ein]
        await ein.finished
        danach(() => {
          if (meiner !== zug) return
          alt.removeAttribute('style')
          neu.removeAttribute('style')
        })
      })
    }
  }
</script>
