---
import Badge from '@/components/Badge.astro'
import { CATEGORY_LABELS, href } from '@/lib/site'

interface Props {
  slug: string
  title: string
  summary: string
  techStack: string[]
  category: string
}

const { slug, title, summary, techStack, category } = Astro.props
const url = href(`/projekte/${slug}`)
---

<article
  class="group relative flex h-full flex-col rounded-lg border border-border bg-bg-elevated p-5 transition-colors hover:border-accent/50 motion-reduce:transition-none"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="m-0 text-lg font-semibold tracking-tight">
      {/* Stretched Link: die ganze Karte ist klickbar, der Fokus bleibt am Text. */}
      <a class="text-fg no-underline after:absolute after:inset-0 after:content-['']" href={url}>
        {title}
      </a>
    </h3>
    <Badge tone={category === 'eigenstaendig' ? 'accent' : 'muted'}>
      {CATEGORY_LABELS[category] ?? category}
    </Badge>
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-fg-muted">{summary}</p>

  <ul class="mt-4 flex list-none flex-wrap gap-1.5 p-0">
    {
      techStack.map((tech) => (
        <li class="rounded-sm border border-border px-1.5 py-0.5 font-mono text-xs text-fg-muted">
          {tech}
        </li>
      ))
    }
  </ul>

  <p class="mt-4 mb-0 text-sm font-medium text-accent">
    Details <span
      aria-hidden="true"
      class="inline-block transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none"
      >&rarr;</span
    >
  </p>
</article>
