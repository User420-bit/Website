---
/**
 * Pfeil als SVG statt als Schriftzeichen: Die Hausschrift ist auf Latin
 * beschnitten und enthaelt keine Pfeile. Rein dekorativ, der Linktext traegt
 * die Bedeutung.
 */
interface Props {
  direction?: 'right' | 'left'
  class?: string
}

const { direction = 'right', class: className = '' } = Astro.props
---

<svg
  aria-hidden="true"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  class:list={[
    'inline-block h-[0.85em] w-[0.85em]',
    direction === 'left' && 'rotate-180',
    className,
  ]}
>
  <path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path>
</svg>
