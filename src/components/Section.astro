---
/**
 * Abschnitt der Startseite. Eine Haarlinie oben, darunter der Kopf: ab `lg`
 * links Nummer und Ueberschrift, rechts der einleitende Satz. Der Inhalt steht
 * unter diesem Kopf ueber die volle Spaltenbreite — so bleibt die Randspalte
 * die Marke des Abschnitts, ohne neben langen Inhalten als leere Flaeche
 * stehenzubleiben. Die Nummer ist Ordnung fuers Auge, keine Information —
 * deshalb `aria-hidden`.
 */
interface Props {
  id: string
  title: string
  index?: string
  intro?: string
  class?: string
}

const { id, title, index, intro, class: className = '' } = Astro.props
---

<section id={id} class:list={['border-t border-border py-12 sm:py-16', className]}>
  <div class="lg:grid lg:grid-cols-[11rem_minmax(0,1fr)] lg:gap-x-12">
    <div>
      {
        index && (
          <span aria-hidden="true" class="block text-sm text-fg-muted tabular-nums">
            {index}
          </span>
        )
      }
      <h2 class="mt-1 text-xl font-semibold tracking-tight text-balance">{title}</h2>
    </div>
    {intro && <p class="prose-flow mt-4 mb-0 max-w-[65ch] text-fg-muted lg:mt-0">{intro}</p>}
  </div>
  <div class="mt-8 sm:mt-10">
    <slot />
  </div>
</section>
