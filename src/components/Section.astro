---
/**
 * Abschnitt der Startseite, gebaut als Kapitelöffnung: eine Tintenlinie oben
 * (die einzige auf der Seite, alles Innere bleibt Haarlinie), viel Luft,
 * dann der Kopf. Der Kopf steht in einer Spalte: zuerst die Nummer, darunter
 * die H2 in Headline-Größe, darunter der einleitende Satz. Der Inhalt folgt
 * unter dem Kopf über die volle Spaltenbreite, alles an derselben linken
 * Kante. Die Nummer ist Ordnung fürs Auge, keine Information — deshalb
 * `aria-hidden`.
 */
interface Props {
  id: string
  title: string
  index?: string
  intro?: string
  class?: string
}

const { id, title, index, intro, class: className = '' } = Astro.props
---

<section id={id} class:list={['border-t border-fg py-16 sm:py-24', className]}>
  <div>
    {
      index && (
        <span aria-hidden="true" class="block text-sm text-fg-muted tabular-nums">
          {index}
        </span>
      )
    }
    <h2
      class:list={[
        'm-0 text-3xl font-semibold tracking-tight text-balance sm:text-4xl',
        index && 'mt-1',
      ]}
    >
      {title}
    </h2>
    {intro && <p class="prose-flow mt-4 mb-0 max-w-[65ch] text-fg-muted">{intro}</p>}
  </div>
  <div class="mt-10 sm:mt-12">
    <slot />
  </div>
</section>
