---
import { getEntry } from 'astro:content'
import { emailAddresses, href, mailto } from '@/lib/site'

/**
 * Ruhige Anfrage-Zeile: nach "Arbeiten" auf der Startseite und am Ende jeder
 * Projektseite. Wer gerade einen Beleg gelesen hat, soll nicht erst bis zum
 * Kontakt scrollen müssen. Der zweite Link führt zu Ablauf und Adresse, falls
 * sich kein Mailprogramm öffnet.
 */
interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
const company = (await getEntry('company', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
---

<div
  class:list={[
    'flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8',
    className,
  ]}
>
  <p class="m-0 max-w-[65ch] text-fg-muted">
    <span class="font-medium text-fg">{contact.prompt.title}</span>{' '}
    {contact.prompt.text}
  </p>
  <div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-2">
    <a
      class="inline-flex items-center rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg no-underline transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none"
      href={mailto(emailAddresses(company.email, company.fallbackEmail), contact.subject)}
    >
      E-Mail schreiben
    </a>
    <a
      class="py-2.5 text-sm text-fg-muted underline underline-offset-4 hover:text-fg"
      href={href('/#kontakt')}
    >
      So läuft eine Anfrage ab
    </a>
  </div>
</div>
