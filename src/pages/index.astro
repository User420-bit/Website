---
import { getCollection, getEntry, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import CopyEmail from '@/components/CopyEmail.astro'
import Disclosure from '@/components/Disclosure.astro'
import ProjectFeature from '@/components/ProjectFeature.astro'
import ProjectRow from '@/components/ProjectRow.astro'
import Section from '@/components/Section.astro'
import { href } from '@/lib/site'
import { Image } from 'astro:assets'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const aboutEntry = (await getEntry('about', 'about'))!
const { Content: AboutBody } = await render(aboutEntry)

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
const projektTitel = new Map(projekte.map((p) => [p.id, p.data.title]))
// Kundenprojekte stehen gross oben, alles andere im Index darunter.
const referenzen = projekte.filter((p) => p.data.kind === 'kundenprojekt')
const weitere = projekte.filter((p) => p.data.kind !== 'kundenprojekt')
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order)

const description = `${company.name} – Insellösungen, Websites und Web-Apps aus ${company.location.split(',')[0]}.`
const mailto = `mailto:${company.email}?subject=${encodeURIComponent('Anfrage über web-klartext.de')}`
const punkte = (n: number) => (n === 1 ? '1 Punkt' : `${n} Punkte`)
---

<BaseLayout title={`${company.name} – ${company.claim}`} description={description} isHome>
  {
    /*
    Hero — das Unternehmen, nicht die Person. So hoch wie sein Inhalt, ohne
    Einblenden: Die H1 ist das Erste, was gemalt wird, und soll sofort stehen.
  */
  }
  <section class="pt-16 pb-14 sm:pt-24 sm:pb-20">
    <h1
      class="display m-0 max-w-[20ch] text-[clamp(2.5rem,1.6rem+4.5vw,4.5rem)] font-semibold text-balance"
    >
      {company.claim}
    </h1>
    <p class="prose-flow mt-6 max-w-[60ch] text-lg leading-relaxed text-fg-muted">
      {company.intro}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
      <Button href={mailto}>Anfrage schreiben</Button>
      <Button href={href('/#arbeiten')} variant="text">Arbeiten ansehen</Button>
    </div>

    <p class="mt-10 mb-0 text-sm text-fg-muted">
      {company.location} · {contact.responseNote}
    </p>
  </section>

  {/* 01 Arbeiten — der Beweis zuerst: Kundenprojekte gross, der Rest als Index. */}
  <Section
    id="arbeiten"
    index="01"
    title="Arbeiten"
    intro="Kundenprojekte zuerst, darunter eigene Produkte, Prototypen und Studienarbeiten. Bei jedem Eintrag steht, was er ist — nichts liegt hinter einem Tab."
  >
    <div class="border-t border-border">
      {
        referenzen.map((projekt) => (
          <ProjectFeature
            slug={projekt.id}
            title={projekt.data.title}
            summary={projekt.data.summary}
            kind={projekt.data.kind}
            period={projekt.data.period}
            status={projekt.data.status}
            cover={projekt.data.cover}
          />
        ))
      }
    </div>

    <h3 class="mt-12 mb-0 text-sm font-medium text-fg-muted">Weitere Arbeiten</h3>
    <ul class="mt-3 list-none border-t border-border p-0">
      {
        weitere.map((projekt) => (
          <ProjectRow
            slug={projekt.id}
            title={projekt.data.title}
            kind={projekt.data.kind}
            period={projekt.data.period}
          />
        ))
      }
    </ul>
  </Section>

  {
    /*
    02 Leistungen — erst die drei Arten Software, dann die Einzelpunkte zum
    Aufklappen. Jeder Einzelpunkt nennt das Projekt, das ihn belegt: ohne Beleg
    kein Eintrag, sonst waere es eine Wunschliste.
  */
  }
  <Section
    id="leistungen"
    index="02"
    title="Leistungen"
    intro="Drei Arten von Software, ein Anspruch: klein genug, um verstanden zu werden, und solide genug, um zu bleiben."
  >
    <dl class="m-0 grid grid-cols-1 gap-x-8 sm:grid-cols-3">
      {
        company.services.map((service) => (
          <div class="border-t border-fg pt-4 pb-8">
            <dt class="text-lg font-semibold tracking-tight">{service.title}</dt>
            <dd class="prose-flow mt-2 ml-0 text-sm leading-relaxed text-fg-muted">
              {service.description}
            </dd>
          </div>
        ))
      }
    </dl>

    <h3 class="mt-6 mb-0 text-sm font-medium text-fg-muted">Im Einzelnen</h3>
    <p class="mt-1 max-w-[65ch] text-sm text-fg-muted">
      Abgeleitet aus dem, was tatsächlich gebaut wurde. Hinter jedem Punkt steht das Projekt, das
      ihn belegt.
    </p>
    <div class="mt-4 border-t border-border">
      {
        leistungen.map((group) => (
          <Disclosure title={group.data.title} meta={punkte(group.data.items.length)}>
            <p class="prose-flow mt-0 max-w-[65ch] text-sm text-fg-muted">
              {group.data.description}
            </p>
            <ul class="mt-5 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
              {group.data.items.map((item) => (
                <li>
                  <span class="block text-sm font-medium">{item.title}</span>
                  <span class="prose-flow block text-sm text-fg-muted">{item.description}</span>
                  {item.evidence.length > 0 && (
                    <span class="mt-1 block text-xs text-fg-muted">
                      Beleg:{' '}
                      {item.evidence.map((slug, i) => (
                        <>
                          {i > 0 && ', '}
                          <a
                            class="text-accent underline-offset-4"
                            href={href(`/projekte/${slug}`)}
                          >
                            {projektTitel.get(slug) ?? slug}
                          </a>
                        </>
                      ))}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </Disclosure>
        ))
      }
    </div>
  </Section>

  {
    /*
    03 Arbeitsweise — die vier Werte aus about.md, dahinter das, was in den
    Commit-Historien nachlesbar ist.
  */
  }
  <Section id="arbeitsweise" index="03" title="Arbeitsweise">
    <ol class="m-0 list-none border-t border-border p-0">
      {
        aboutEntry.data.values.map((value, i) => (
          <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4 border-b border-border py-4 sm:grid-cols-[2rem_10rem_minmax(0,1fr)]">
            <span aria-hidden="true" class="text-sm text-fg-muted tabular-nums">
              {i + 1}
            </span>
            <span class="font-medium">{value.title}</span>
            <span class="prose-flow col-start-2 mt-1 max-w-[55ch] text-sm text-fg-muted sm:col-start-3 sm:mt-0">
              {value.description}
            </span>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 border-t border-border">
      <Disclosure title="Wie gearbeitet wird" meta={punkte(aboutEntry.data.workflow.length)}>
        <p class="mt-0 max-w-[65ch] text-sm text-fg-muted">
          Aus den Commit-Historien ablesbar, nicht aus einem Leitbild.
        </p>
        <ul class="mt-5 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
          {
            aboutEntry.data.workflow.map((item) => (
              <li>
                <span class="block text-sm font-medium">{item.title}</span>
                <span class="prose-flow mt-1 block text-sm text-fg-muted">{item.description}</span>
              </li>
            ))
          }
        </ul>
      </Disclosure>
    </div>
  </Section>

  {
    /*
    04 Über Klartext — die einzige Stelle auf der Startseite, an der die Person
    genannt wird. Zweispaltig erst, wenn ein Portrait hinterlegt ist.
  */
  }
  <Section id="ueber" index="04" title="Über Klartext">
    <div
      class:list={[profile.portrait && 'lg:grid lg:grid-cols-[1fr_auto] lg:items-start lg:gap-12']}
    >
      <div>
        <div class="prose-flow max-w-[65ch] space-y-4 leading-relaxed text-fg-muted">
          <AboutBody />
        </div>

        <p class="mt-6 max-w-[65ch] text-sm text-fg-muted">
          {profile.openTo && <span>{profile.openTo} </span>}
          {
            profile.social.linkedin && (
              <a
                class="text-accent underline underline-offset-4"
                href={profile.social.linkedin}
                rel="me noopener noreferrer"
                target="_blank"
              >
                Profil auf LinkedIn
              </a>
            )
          }
        </p>

        <p class="mt-6 mb-0">
          <Button href={href('/werkzeuge')} variant="text">Womit gearbeitet wird</Button>
        </p>
      </div>

      {
        profile.portrait && (
          <Image
            class="mt-8 w-40 rounded-sm border border-border object-cover lg:mt-0 lg:w-56"
            src={profile.portrait}
            alt={profile.portraitAlt ?? profile.name}
            widths={[160, 224, 448]}
            sizes="(min-width: 1024px) 14rem, 10rem"
            loading="lazy"
          />
        )
      }
    </div>
  </Section>

  {/* 05 Kontakt — Adresse zum Mitnehmen, nicht nur ein mailto:-Knopf. */}
  <Section id="kontakt" index="05" title={contact.heading} intro={contact.description}>
    <CopyEmail email={company.email} />
    <p class="mt-5 mb-0 text-sm text-fg-muted">
      {contact.responseNote}. {company.location}
    </p>
    <ul class="mt-8 flex list-none flex-wrap gap-3 p-0">
      <li>
        <Button href={mailto}>Anfrage schreiben</Button>
      </li>
      {
        profile.social.github && (
          <li>
            <Button href={profile.social.github} variant="secondary" external>
              GitHub
            </Button>
          </li>
        )
      }
    </ul>
  </Section>
</BaseLayout>
