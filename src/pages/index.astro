---
import { getCollection, getEntry, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import CopyEmail from '@/components/CopyEmail.astro'
import Disclosure from '@/components/Disclosure.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import MetaList from '@/components/MetaList.astro'
import NumberedRows from '@/components/NumberedRows.astro'
import ProjectShowcase from '@/components/ProjectShowcase.astro'
import Section from '@/components/Section.astro'
import { href, mailto, zahlwort } from '@/lib/site'
import { Image } from 'astro:assets'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const aboutEntry = (await getEntry('about', 'about'))!
const { Content: AboutBody } = await render(aboutEntry)

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
const projektTitel = new Map(projekte.map((p) => [p.id, p.data.title]))
const kundenprojekte = projekte.filter((p) => p.data.kind === 'kundenprojekt').length
/** H2 als Aussage mit echten Zahlen, gezählt aus src/content/projekte/. */
const arbeitenTitel = [
  `${zahlwort(projekte.length)} Arbeiten`,
  kundenprojekte > 0 && `${zahlwort(kundenprojekte)} davon für Kunden`,
]
  .filter(Boolean)
  .join(', ')
  .replace(/^./, (c) => c.toUpperCase())
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order)

const description = `${company.name} – kleine Programme, Websites und Web-Apps aus ${company.location.split(',')[0]}.`
const anfrage = mailto(company.email, contact.subject)
/** Erreichbarkeit im Kontakt: der Ort, dann die Profile, die in profile.json gesetzt sind. */
const erreichbarkeit: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: 'Ort', value: company.location },
]
if (profile.social.linkedin) {
  erreichbarkeit.push({
    label: 'Profil',
    value: 'LinkedIn',
    href: profile.social.linkedin,
    external: true,
  })
}
if (profile.social.github) {
  erreichbarkeit.push({
    label: 'Code',
    value: 'GitHub',
    href: profile.social.github,
    external: true,
  })
}
const punkte = (n: number) => (n === 1 ? '1 Punkt' : `${n} Punkte`)
// Der erste Schritt ist die E-Mail; sein Zeitrahmen ist die Antwortzeit, die nur in
// `responseTime` steht.
const schritte = contact.steps.map((step, i) =>
  i === 0 && !step.timeframe ? { ...step, timeframe: contact.responseTime } : step,
)
---

<BaseLayout title={`${company.name} – ${company.claim}`} description={description} isHome>
  {
    /*
    Hero — das Unternehmen, nicht die Person. So hoch wie sein Inhalt, ohne
    Einblenden: Die H1 ist das Erste, was gemalt wird, und soll sofort stehen.
  */
  }
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-24">
    <h1
      class="display m-0 max-w-[20ch] text-[clamp(2.5rem,1.6rem+4.5vw,4.5rem)] font-semibold text-balance"
    >
      {company.claim}
    </h1>
    {
      /*
      Für wen, direkt unter dem Claim: Der Claim bleibt Marke, die Unterzeile sagt,
      wer gemeint ist. Darunter statt darüber, damit die H1 das Erste bleibt, was man liest.
    */
    }
    <p
      class="mt-5 mb-0 max-w-[60ch] text-xl leading-snug font-medium tracking-tight text-balance text-fg-muted sm:text-2xl"
    >
      {company.audience}
    </p>
    <p class="prose-flow mt-6 max-w-[60ch] text-lg leading-relaxed text-fg-muted">
      {company.intro}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
      <Button href={anfrage}>E-Mail schreiben</Button>
      <Button href={href('/#arbeiten')} variant="text">Arbeiten ansehen</Button>
    </div>

    {/* Sichtbare Adresse: Ausweg, wenn der Klick kein Mailprogramm öffnet (Webmail). */}
    <p class="mt-10 mb-0 flex flex-wrap gap-x-2 gap-y-1 text-sm text-fg-muted">
      <span>{company.location}</span>
      <span aria-hidden="true">·</span>
      <span class="font-medium wrap-anywhere text-fg select-all">{company.email}</span>
      <span aria-hidden="true">·</span>
      <span>{contact.responseTime}</span>
    </p>
  </section>

  {
    /*
    01 Arbeiten — der Beweis zuerst: Umschalter Kunden / Eigene Projekte, oben
    ein Projekt gross, darunter alle als Raster (siehe ProjectShowcase). Die
    H2-Titel sind Aussagen, nicht Etiketten: Wer nur die Überschriften liest,
    soll trotzdem etwas erfahren. Die Navigation behält die kurzen Namen.
  */
  }
  <Section
    id="arbeiten"
    index="01"
    title={arbeitenTitel}
    intro="Kundenprojekte, eigene Produkte und Prototypen. Bei jedem Eintrag steht, was davon es ist."
  >
    <ProjectShowcase projekte={projekte} />

    {/* Anfrage-Zeile direkt unter den Belegen. */}
    <InquiryPrompt class="mt-10 border-t border-border pt-6" />
  </Section>

  {
    /*
    02 Leistungen — erst die drei Arten Software, dann die Einzelpunkte zum
    Aufklappen. Jeder Einzelpunkt nennt das Projekt, das ihn belegt: ohne Beleg
    kein Eintrag, sonst waere es eine Wunschliste.
  */
  }
  <Section
    id="leistungen"
    index="02"
    title="Angeboten wird nur, was schon gebaut wurde"
    intro="Ob Programm, Website oder Web-App: klein genug, um verstanden zu werden, und solide genug, um zu bleiben."
  >
    <dl class="m-0 grid grid-cols-1 gap-x-8 sm:grid-cols-3">
      {
        company.services.map((service) => (
          <div class="border-t border-border pt-4 pb-8">
            <dt class="text-lg font-semibold tracking-tight">{service.title}</dt>
            <dd class="prose-flow mt-2 ml-0 text-sm leading-relaxed text-fg-muted">
              {service.description}
            </dd>
          </div>
        ))
      }
    </dl>

    <h3 class="mt-12 mb-0 text-sm font-medium text-fg-muted">Im Einzelnen</h3>
    <p class="mt-1 max-w-[65ch] text-sm text-fg-muted">
      Hinter jedem Punkt steht das Projekt, das ihn belegt.
    </p>
    <div class="mt-3 border-t border-border">
      {
        leistungen.map((group) => (
          <Disclosure title={group.data.title} meta={punkte(group.data.items.length)}>
            <p class="prose-flow mt-0 max-w-[65ch] text-sm text-fg-muted">
              {group.data.description}
            </p>
            <ul class="mt-5 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
              {group.data.items.map((item) => (
                <li>
                  <span class="block text-sm font-medium">{item.title}</span>
                  <span class="prose-flow block text-sm text-fg-muted">{item.description}</span>
                  {item.evidence.length > 0 && (
                    <span class="mt-1 block text-xs text-fg-muted">
                      Beleg:{' '}
                      {item.evidence.map((slug, i) => (
                        <>
                          {i > 0 && ', '}
                          <a
                            class="text-accent underline-offset-4"
                            href={href(`/projekte/${slug}`)}
                          >
                            {projektTitel.get(slug) ?? slug}
                          </a>
                        </>
                      ))}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </Disclosure>
        ))
      }
    </div>
  </Section>

  {
    /*
    03 Arbeitsweise — die vier Werte aus about.md, dahinter das, was in den
    Commit-Historien nachlesbar ist.
  */
  }
  <Section id="arbeitsweise" index="03" title="Erst klären, was geht, dann bauen">
    <NumberedRows items={aboutEntry.data.values} titleColumn />

    <div class="mt-8 border-t border-border">
      <Disclosure title="Wie gearbeitet wird" meta={punkte(aboutEntry.data.workflow.length)}>
        <p class="mt-0 max-w-[65ch] text-sm text-fg-muted">
          Nachlesbar in der Änderungsgeschichte jedes Projekts, nicht in einem Leitbild.
        </p>
        <ul class="mt-5 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
          {
            aboutEntry.data.workflow.map((item) => (
              <li>
                <span class="block text-sm font-medium">{item.title}</span>
                <span class="prose-flow mt-1 block text-sm text-fg-muted">{item.description}</span>
              </li>
            ))
          }
        </ul>
      </Disclosure>
    </div>
  </Section>

  {
    /*
    04 Über Klartext — die einzige Stelle auf der Startseite, an der die Person
    genannt wird. Zweispaltig erst, wenn ein Portrait hinterlegt ist.
  */
  }
  <Section id="ueber" index="04" title="Eine Person, direkt ansprechbar">
    <div
      class:list={[profile.portrait && 'lg:grid lg:grid-cols-[1fr_auto] lg:items-start lg:gap-12']}
    >
      <div>
        <div class="prose-flow max-w-[65ch] space-y-4 leading-relaxed text-fg-muted">
          <AboutBody />
        </div>

        <p class="mt-6 max-w-[65ch] text-sm text-fg-muted">
          {profile.openTo && <span>{profile.openTo} </span>}
          {
            profile.social.linkedin && (
              <a
                class="text-accent underline underline-offset-4"
                href={profile.social.linkedin}
                rel="me noopener noreferrer"
                target="_blank"
              >
                Profil auf LinkedIn
              </a>
            )
          }
        </p>

        <p class="mt-6 mb-0">
          <Button href={href('/werkzeuge')} variant="text">Womit gearbeitet wird</Button>
        </p>
      </div>

      {
        profile.portrait && (
          <Image
            class="mt-8 w-40 rounded-sm border border-border object-cover lg:mt-0 lg:w-56"
            src={profile.portrait}
            alt={profile.portraitAlt ?? profile.name}
            widths={[160, 224, 448]}
            sizes="(min-width: 1024px) 14rem, 10rem"
            loading="lazy"
          />
        )
      }
    </div>
  </Section>

  {
    /*
    05 Kontakt — ein Raster, keine Freischweber. Links die Handlung: die
    Adresse gross und markierbar (wer am PC nur Webmail nutzt, klickt mit einem
    mailto:-Knopf allein ins Leere), darunter Knopf und Erreichbarkeit. Rechts
    der Ablauf. Beide Spalten oeffnen mit derselben Haarlinie und beginnen so
    auf einer Hoehe.
  */
  }
  <Section id="kontakt" index="05" title={contact.heading} intro={contact.description}>
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] sm:gap-12">
      <div class="border-t border-border pt-6">
        <CopyEmail email={company.email} />
        <p class="mt-3 mb-0 max-w-[65ch] text-xs text-fg-muted">
          Öffnet sich kein Mailprogramm? Dann die Adresse markieren und kopieren.
        </p>
        <p class="mt-8 mb-0">
          <Button href={anfrage}>E-Mail schreiben</Button>
        </p>
        <MetaList rows={erreichbarkeit} class="mt-10" />
      </div>

      <div class="border-t border-border pt-6">
        <h3 class="m-0 text-sm font-medium text-fg-muted">So läuft eine Anfrage ab</h3>
        <NumberedRows items={schritte} class="mt-3" />
      </div>
    </div>
  </Section>
</BaseLayout>
