---
import { getCollection, getEntry, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Section from '@/components/Section.astro'
import { href } from '@/lib/site'
import { Image } from 'astro:assets'

const company = (await getEntry('company', 'main'))!.data
const profile = (await getEntry('profile', 'main'))!.data
const contact = (await getEntry('contact', 'main'))!.data
const aboutEntry = (await getEntry('about', 'about'))!
const { Content: AboutBody } = await render(aboutEntry)

const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
const projektTitel = new Map(projekte.map((p) => [p.id, p.data.title]))
/** Die Startseite zeigt die ersten Karten nach `order`, alle stehen unter /projekte/. */
const STARTSEITE_PROJEKTE = 6
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order)
const leistungspunkte = leistungen.reduce((sum, group) => sum + group.data.items.length, 0)
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order)

const description = `${company.name} – kleine Programme, Websites und Web-Apps aus ${company.location.split(',')[0]}.`

const primaryButton =
  'inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-fg no-underline transition-opacity hover:opacity-90 motion-reduce:transition-none'
const secondaryButton =
  'inline-flex items-center rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg no-underline transition-colors hover:border-accent hover:text-accent motion-reduce:transition-none'
---

<BaseLayout title={`${company.name} – ${company.claim}`} description={description} isHome>
  {
    /*
    1. Hero — das Unternehmen, nicht die Person. So hoch wie sein Inhalt,
    kein erzwungenes Full-Height.
  */
  }
  <section class="py-14 sm:py-20">
    <p class="text-sm font-medium tracking-wide text-accent uppercase">
      {company.name} · {company.location}
    </p>
    <h1 class="mt-3 max-w-[20ch] text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      {company.claim}
    </h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-fg-muted">{company.intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a class={primaryButton} href={`mailto:${company.email}`}>Anfrage schreiben</a>
      <a class={secondaryButton} href={href('/#arbeiten')}>Arbeiten ansehen</a>
    </div>
  </section>

  {
    /*
    2. Leistungen — erst die drei Arten Software, die Klartext baut, dann die
    Einzelpunkte. Jeder Einzelpunkt nennt das Projekt, das ihn belegt: ohne
    Beleg kein Eintrag, sonst wäre es eine Wunschliste.
  */
  }
  <Section
    id="leistungen"
    title="Leistungen"
    intro="Ob Programm, Website oder Web-App: klein genug, um verstanden zu werden, und solide genug, um zu bleiben."
    class="reveal"
  >
    <ul class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-3">
      {
        company.services.map((service) => (
          <li class="rounded-lg border border-border bg-bg-elevated p-5">
            <h3 class="m-0 text-lg font-semibold tracking-tight">{service.title}</h3>
            <p class="mt-3 mb-0 text-sm leading-relaxed text-fg-muted">{service.description}</p>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-12 text-base font-semibold tracking-tight">Im Einzelnen</h3>
    <p class="mt-1 max-w-[65ch] text-sm text-fg-muted">
      Abgeleitet aus dem, was tatsächlich gebaut wurde. Hinter jedem Punkt steht das Projekt, das
      ihn belegt.
    </p>
    {/* Eingeklappt: Die Einzelpunkte samt Beleg-Links sind Nachschlagestoff, kein Lesepfad. */}
    <details class="group/einzeln mt-4">
      <summary
        class="inline-flex cursor-pointer list-none items-center gap-2 rounded-md border border-border px-4 py-2.5 text-sm font-medium text-fg transition-colors select-none hover:border-accent hover:text-accent motion-reduce:transition-none [&::-webkit-details-marker]:hidden"
      >
        <span class="group-open/einzeln:hidden">Alle {leistungspunkte} Punkte zeigen</span>
        <span class="hidden group-open/einzeln:inline">Punkte ausblenden</span>
        <svg
          aria-hidden="true"
          class="size-4 transition-transform group-open/einzeln:rotate-180 motion-reduce:transition-none"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 6l4 4 4-4"></path>
        </svg>
      </summary>
      <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2">
        {
          leistungen.map((group) => (
            <div class="rounded-lg border border-border bg-bg-elevated p-5">
              <h4 class="text-base font-semibold tracking-tight">{group.data.title}</h4>
              <p class="mt-1 text-sm text-fg-muted">{group.data.description}</p>
              <ul class="mt-4 list-none space-y-4 p-0">
                {group.data.items.map((item) => (
                  <li>
                    <span class="block text-sm font-medium">{item.title}</span>
                    <span class="block text-sm text-fg-muted">{item.description}</span>
                    {item.evidence.length > 0 && (
                      <span class="mt-1 block text-xs text-fg-muted">
                        Beleg:{' '}
                        {item.evidence.map((slug, i) => (
                          <>
                            {i > 0 && ', '}
                            <a
                              class="text-accent underline-offset-4"
                              href={href(`/projekte/${slug}`)}
                            >
                              {projektTitel.get(slug) ?? slug}
                            </a>
                          </>
                        ))}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </Section>

  {/* 3. Arbeiten — der Beweis. Das Badge sagt, um welche Art Projekt es geht. */}
  <Section
    id="arbeiten"
    title="Arbeiten"
    intro="Kundenprojekte, eigene Produkte, Prototypen und Studienprojekte. Jede Karte sagt, um welche Art Projekt es sich handelt."
    class="reveal"
  >
    <ul class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        projekte.slice(0, STARTSEITE_PROJEKTE).map((projekt) => (
          <li class="flex">
            <ProjectCard projekt={projekt} />
          </li>
        ))
      }
    </ul>
    {
      projekte.length > STARTSEITE_PROJEKTE && (
        <p class="mt-8 mb-0">
          <a class={secondaryButton} href={href('/projekte/')}>
            Alle {projekte.length} Arbeiten&nbsp;<span aria-hidden="true">&rarr;</span>
          </a>
        </p>
      )
    }
  </Section>

  {
    /*
    4. Arbeitsweise — die vier Werte aus about.md, dahinter das, was in den
    Commit-Historien nachlesbar ist. Ersetzt das frühere Badge pro Projekt.
  */
  }
  <Section id="arbeitsweise" title="Arbeitsweise" class="reveal">
    <ul class="grid list-none grid-cols-1 gap-x-8 gap-y-6 p-0 sm:grid-cols-2">
      {
        aboutEntry.data.values.map((value) => (
          <li class="border-l-2 border-accent/40 pl-4">
            <span class="block font-medium">{value.title}</span>
            <span class="mt-1 block text-sm text-fg-muted">{value.description}</span>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-12 text-base font-semibold tracking-tight">Wie gearbeitet wird</h3>
    <p class="mt-1 max-w-[65ch] text-sm text-fg-muted">
      Aus den Commit-Historien ablesbar, nicht aus einem Leitbild.
    </p>
    <ul class="mt-4 grid list-none grid-cols-1 gap-x-8 gap-y-5 p-0 sm:grid-cols-2">
      {
        aboutEntry.data.workflow.map((item) => (
          <li>
            <span class="block text-sm font-medium">{item.title}</span>
            <span class="mt-1 block text-sm text-fg-muted">{item.description}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 5. Werkzeuge — ohne Prozentbalken, mit Einordnung pro Eintrag. */}
  <Section
    id="werkzeuge"
    title="Werkzeuge"
    intro="Was in den letzten sechs Monaten tatsächlich im Einsatz war. Ohne Prozentbalken und Sterne, stattdessen eine kurze Einordnung pro Eintrag."
    class="reveal"
  >
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <div>
            <h3 class="text-base font-semibold tracking-tight">{group.data.title}</h3>
            <p class="mt-1 text-sm text-fg-muted">{group.data.description}</p>
            <ul class="mt-4 list-none space-y-3 p-0">
              {group.data.items.map((item) => (
                <li>
                  <span class="block text-sm font-medium">{item.name}</span>
                  <span class="block text-sm text-fg-muted">{item.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  {
    /*
    6. Über Klartext — die einzige Stelle auf der Startseite, an der die Person
    genannt wird. Zweispaltig erst, wenn ein Portrait hinterlegt ist.
  */
  }
  <Section id="ueber" title="Über Klartext" class="reveal">
    <div
      class:list={[profile.portrait && 'lg:grid lg:grid-cols-[1fr_auto] lg:items-start lg:gap-12']}
    >
      <div>
        <div class="max-w-[65ch] space-y-4 leading-relaxed text-fg-muted">
          <AboutBody />
        </div>

        <p class="mt-6 max-w-[65ch] text-sm text-fg-muted">
          {profile.openTo && <span>{profile.openTo} </span>}
          {
            profile.social.linkedin && (
              <a
                class="text-accent underline underline-offset-4"
                href={profile.social.linkedin}
                rel="me noopener noreferrer"
                target="_blank"
              >
                Profil auf LinkedIn
              </a>
            )
          }
        </p>
      </div>

      {
        profile.portrait && (
          <Image
            class="mt-8 w-40 rounded-lg border border-border object-cover lg:mt-0 lg:w-56"
            src={profile.portrait}
            alt={profile.portraitAlt ?? profile.name}
            widths={[160, 224, 448]}
            sizes="(min-width: 1024px) 14rem, 10rem"
            loading="lazy"
          />
        )
      }
    </div>
  </Section>

  {/* 7. Kontakt. */}
  <Section id="kontakt" title={contact.heading} intro={contact.description} class="reveal">
    <ul class="flex list-none flex-wrap gap-3 p-0">
      <li>
        <a class={primaryButton} href={`mailto:${company.email}`}>{company.email}</a>
      </li>
      {
        profile.social.github && (
          <li>
            <a
              class={secondaryButton}
              href={profile.social.github}
              rel="me noopener noreferrer"
              target="_blank"
            >
              GitHub
            </a>
          </li>
        )
      }
    </ul>
    <p class="mt-4 text-sm text-fg-muted">{company.location}</p>
  </Section>
</BaseLayout>
