---
/**
 * Startseite: Hero, dann fünf Kapitel. Jede Sektion liegt in einer eigenen
 * Datei unter `src/components/home/`, damit sie unabhängig gepflegt und
 * bewegt werden kann (docs/MOTION_PLAN.md). Die Reihenfolge ist Absicht:
 * erst der Beweis (Arbeiten), dann das Angebot, dann die Person, dann der Weg
 * zu ihr.
 */
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import ProjectShowcase from '@/components/ProjectShowcase.astro'
import Section from '@/components/Section.astro'
import Hero from '@/components/home/Hero.astro'
import Leistungen from '@/components/home/Leistungen.astro'
import Arbeitsweise from '@/components/home/Arbeitsweise.astro'
import Ueber from '@/components/home/Ueber.astro'
import Kontakt from '@/components/home/Kontakt.astro'

const company = (await getEntry('company', 'main'))!.data
const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
const description = `${company.name} – kleine Programme, Websites und Web-Apps aus ${company.location.split(',')[0]}.`
---

<BaseLayout title={`${company.name} – ${company.claim}`} description={description} isHome>
  <Hero />

  {
    /*
    01 Arbeiten — der Beweis zuerst: Umschalter Kunden / Eigene Projekte, oben
    ein Projekt groß, darunter alle als Raster (siehe ProjectShowcase). Die
    H2-Titel sind Aussagen, nicht Etiketten: Wer nur die Überschriften liest,
    soll trotzdem etwas erfahren. Die Navigation behält die kurzen Namen.
    Keine Anzahl der Arbeiten in der H2 (entschieden am 2026-09-24).
  */
  }
  <Section
    id="arbeiten"
    index="01"
    title="Jedes Projekt sagt, wie weit es ist"
    intro="Kundenprojekte, eigene Produkte und Prototypen. Bei jedem Eintrag steht, was davon es ist."
  >
    <ProjectShowcase projekte={projekte} />

    {/* Anfrage-Zeile direkt unter den Belegen. */}
    <InquiryPrompt class="mt-10 border-t border-border pt-6" />
  </Section>

  <Leistungen />
  <Arbeitsweise />
  <Ueber />
  <Kontakt />
</BaseLayout>
