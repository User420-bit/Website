---
import Button from '@/components/Button.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { href } from '@/lib/site'
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die aufgerufene Seite existiert nicht."
  noindex
>
  <section class="py-20 sm:py-28">
    <p class="m-0 text-sm text-fg-muted tabular-nums">404</p>
    <h1 class="display mt-2 mb-0 text-4xl font-semibold text-balance sm:text-5xl">
      Seite nicht gefunden
    </h1>
    <p class="mt-5 max-w-[50ch] text-lg text-fg-muted">
      Diese Adresse führt ins Leere. Möglicherweise ist der Link veraltet.
    </p>
    <p class="mt-8 mb-0">
      <Button href={href('/')}>Zur Startseite</Button>
    </p>
  </section>
</BaseLayout>
