---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { href } from '@/lib/site'
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die aufgerufene Seite existiert nicht."
  noindex
>
  <section class="py-24 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Seite nicht gefunden</h1>
    <p class="mx-auto mt-4 max-w-[50ch] text-fg-muted">
      Diese Adresse führt ins Leere. Möglicherweise ist der Link veraltet.
    </p>
    <p class="mt-8">
      <a
        class="inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-accent-fg no-underline transition-opacity hover:opacity-90 motion-reduce:transition-none"
        href={href('/')}
      >
        Zur Startseite
      </a>
    </p>
  </section>
</BaseLayout>
