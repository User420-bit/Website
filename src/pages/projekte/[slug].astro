---
/**
 * Eine Seite je Referenz. Der gemeinsame Körper steht in `ProjectPage.astro`;
 * hat ein Projekt eine eigene Seitenkomponente unter `src/components/projekte/`,
 * rendert die den Körper und gestaltet ihn (docs/PROJEKTSZENEN_PLAN.md).
 */
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import ProjectPage from '@/components/ProjectPage.astro'
import { pageFor } from '@/components/projekte'

export const getStaticPaths = (async () => {
  const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
  return projekte.map((projekt, i) => ({
    params: { slug: projekt.id },
    // Nachbarn in Startseiten-Reihenfolge, an den Enden ohne Umlauf.
    props: { projekt, prev: projekte[i - 1] ?? null, next: projekte[i + 1] ?? null },
  }))
}) satisfies GetStaticPaths

const { projekt, prev, next } = Astro.props
const Page = pageFor(projekt.id) ?? ProjectPage
---

<Page projekt={projekt} prev={prev} next={next} />
