---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Arrow from '@/components/Arrow.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import ProjectFeature from '@/components/ProjectFeature.astro'
import { href } from '@/lib/site'

// Alle veröffentlichten Referenzen als Liste; die Startseite zeigt dieselben als Raster.
const projekte = (await getCollection('projekte', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<BaseLayout
  title="Alle Arbeiten – Klartext"
  description="Alle Referenzen von Klartext, jede mit Art, Zeitraum und Stand."
>
  <section class="py-12 sm:py-16">
    <a
      class="inline-flex items-center gap-2 text-sm text-fg-muted no-underline hover:text-accent"
      href={href('/#arbeiten')}
    >
      <Arrow direction="left" /> Startseite
    </a>

    <h1 class="display mt-6 mb-0 text-4xl font-semibold text-balance sm:text-5xl">Alle Arbeiten</h1>
    <p class="prose-flow mt-5 max-w-[65ch] text-lg leading-relaxed text-fg-muted">
      Bei jeder Referenz steht, um welche Art Projekt es geht und wie weit es ist.
    </p>

    <div class="mt-10 border-t border-border">
      {projekte.map((projekt) => <ProjectFeature projekt={projekt} />)}
    </div>

    <InquiryPrompt class="mt-10" />
  </section>
</BaseLayout>
