---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Arrow from '@/components/Arrow.astro'
import InquiryPrompt from '@/components/InquiryPrompt.astro'
import ProjectFeature from '@/components/ProjectFeature.astro'
import { href } from '@/lib/site'

// Alle veröffentlichten Referenzen als Liste; die Startseite zeigt dieselben als Raster.
const projekte = (await getCollection('projekte', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<BaseLayout
  title="Alle Arbeiten – Klartext"
  description="Alle Referenzen von Klartext, jede mit Art, Zeitraum und Stand."
>
  <section class="py-12 sm:py-16">
    <a
      class="inline-flex items-center gap-2 text-sm text-fg-muted no-underline hover:text-accent"
      href={href('/#arbeiten')}
    >
      <Arrow direction="left" /> Startseite
    </a>

    <h1 class="display mt-6 mb-0 text-4xl font-semibold text-balance sm:text-5xl">Alle Arbeiten</h1>
    <p class="prose-flow mt-5 max-w-[65ch] text-lg leading-relaxed text-fg-muted">
      Bei jeder Referenz steht, um welche Art Projekt es geht und wie weit es ist.
    </p>

    <div class="mt-10 border-t border-border" data-arbeiten-liste>
      {projekte.map((projekt) => <ProjectFeature projekt={projekt} />)}
    </div>

    <InquiryPrompt class="mt-10" />
  </section>
</BaseLayout>

<style is:global>
  /*
   * Fokus in der Liste (Hover und Tastaturfokus gleich): Zeigt man auf eine
   * Zeile, treten die übrigen zurück. Ihr Titel wechselt auf Bleistiftgrau,
   * ihr Screenshot auf 60 % Deckkraft. Text wird nie über Deckkraft gedimmt,
   * damit jeder Kontrast über 4,5 : 1 bleibt. Hover nur bei echten Zeigern,
   * sonst bliebe nach einem Tipp auf dem Handy die Liste gedimmt.
   * Global, weil Astro `:global()` innerhalb von `:has()` nicht auflöst; das
   * Attribut `data-arbeiten-liste` gibt es nur auf dieser Seite.
   */
  [data-arbeiten-liste] [data-arbeit] .row-title,
  [data-arbeiten-liste] [data-arbeit] [data-uebergang] {
    transition:
      color var(--duration-base) var(--ease-quiet),
      opacity var(--duration-base) var(--ease-quiet),
      background-size var(--duration-base) var(--ease-quiet);
  }
  [data-arbeiten-liste]:has([data-arbeit]:focus-within)
    [data-arbeit]:not(:focus-within)
    .row-title {
    color: var(--color-fg-muted);
  }
  [data-arbeiten-liste]:has([data-arbeit]:focus-within)
    [data-arbeit]:not(:focus-within)
    [data-uebergang] {
    opacity: 0.6;
  }
  @media (hover: hover) {
    [data-arbeiten-liste]:has([data-arbeit]:hover) [data-arbeit]:not(:hover) .row-title {
      color: var(--color-fg-muted);
    }
    [data-arbeiten-liste]:has([data-arbeit]:hover) [data-arbeit]:not(:hover) [data-uebergang] {
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-arbeiten-liste] [data-arbeit] .row-title,
    [data-arbeiten-liste] [data-arbeit] [data-uebergang] {
      transition: none;
    }
  }
</style>
