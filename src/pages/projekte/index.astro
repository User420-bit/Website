---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { href } from '@/lib/site'

// Alle Referenzen; die Startseite zeigt nur die ersten nach `order`.
const projekte = (await getCollection('projekte')).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout
  title="Alle Arbeiten – Klartext"
  description="Alle Referenzen von Klartext: Kundenprojekte, eigene Produkte, Prototypen und Studienprojekte."
>
  <section class="py-12 sm:py-16">
    <a class="text-sm text-fg-muted no-underline hover:text-accent" href={href('/#arbeiten')}>
      &larr; Startseite
    </a>

    <h1 class="mt-6 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Alle Arbeiten
    </h1>
    <p class="mt-4 max-w-[65ch] text-fg-muted">
      {projekte.length} Referenzen, Kundenprojekte zuerst. Das Badge sagt, um welche Art Projekt es geht:
      Kundenprojekt, eigenes Produkt, Prototyp oder Studienprojekt.
    </p>

    <ul class="mt-8 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        projekte.map((projekt) => (
          <li class="flex">
            <ProjectCard projekt={projekt} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
