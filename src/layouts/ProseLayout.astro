---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  subtitle?: string
  noindex?: boolean
}

const { title, description, subtitle, noindex = false } = Astro.props

/*
 * Bewegung (docs/BEWEGUNG_PLAN.md, H): Rechtstexte bewegen sich so wenig wie
 * möglich. H1 und Untertitel stehen sofort, der Text zieht beim Laden einmal
 * 8 px ein, und das war es. Ohne Skript, mit reduzierter Bewegung und im
 * Ausdruck steht er ohnehin.
 */
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="mx-auto max-w-[68ch] py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
    {subtitle && <p class="mt-2 text-sm text-fg-muted">{subtitle}</p>}
    <div
      data-bewegt="prosa"
      class="mt-10 space-y-8 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_li]:my-1 [&_p]:leading-relaxed [&_p]:text-fg-muted [&_ul]:my-2 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_ul]:text-fg-muted"
    >
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  @media screen {
    :global(html[data-bewegung]) [data-bewegt='prosa'] {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  import { DAUER, KURVE, WEG_TEXT, alle, animate, wennBewegt } from '@/lib/motion'

  // Nach 2 s hat das Netz in global.css womöglich schon aufgedeckt; dann nicht noch einmal verstecken.
  const ZU_SPAET = 1800

  /**
   * Nach dem Einzug bleibt nichts zurück: kein Anfangszustand, kein
   * Inline-Stil, kein Transform (Motion hinterließe `translateY(0px)`). Erst
   * im nächsten Bild, denn Motion schreibt seinen Endwert selbst noch einmal
   * im nächsten Bild.
   */
  const aufraeumen = (teile: HTMLElement[]) =>
    requestAnimationFrame(() => {
      for (const teil of teile) {
        teil.removeAttribute('data-bewegt')
        teil.style.removeProperty('opacity')
        teil.style.removeProperty('transform')
        teil.style.removeProperty('animation')
      }
    })

  wennBewegt(() => {
    if (performance.now() > ZU_SPAET) return
    // Der Text steht immer im ersten Bildschirm: Er zieht sofort ein, nicht erst beim Scrollen.
    const text = alle('[data-bewegt="prosa"]')
    animate(
      text,
      { opacity: [0, 1], transform: [`translateY(${WEG_TEXT}px)`, 'none'] },
      { duration: DAUER.langsam, ease: KURVE },
    ).then(() => aufraeumen(text))
  })
</script>
