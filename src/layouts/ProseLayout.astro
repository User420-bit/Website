---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  subtitle?: string
  noindex?: boolean
}

const { title, description, subtitle, noindex = false } = Astro.props
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <article class="mx-auto max-w-[68ch] py-12 sm:py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h1>
    {subtitle && <p class="mt-2 text-sm text-fg-muted">{subtitle}</p>}
    <div
      class="mt-10 space-y-8 [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_li]:my-1 [&_p]:leading-relaxed [&_p]:text-fg-muted [&_ul]:my-2 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-6 [&_ul]:text-fg-muted"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
