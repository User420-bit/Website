---
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import ProjectTransition from '@/components/ProjectTransition.astro'
import { getEntry } from 'astro:content'
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  isHome?: boolean
  noindex?: boolean
}

const { title, description, isHome = false, noindex = false } = Astro.props
const company = await getEntry('company', 'main')
if (!company) throw new Error('src/content/company.json: Eintrag "main" fehlt.')
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    <ProjectTransition />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header isHome={isHome} name={company.data.name} />
    <main id="inhalt" class="mx-auto w-full max-w-5xl flex-1 px-4">
      <slot />
    </main>
    <Footer name={company.data.name} />
  </body>
</html>
